  create or replace view `web_tracking_marts`.`mart_web_visitors` 
  
    
  
  
    
    
  as (
    with sess_rollup as (
    select
        visitor_id,
        website_id,
        count(*) as session_count,
        sum(page_view_count) as lifetime_pageviews,
        sum(total_revenue) as lifetime_revenue,
        sum(conversion_count) as lifetime_conversions,
        min(started_at) as first_session_at,
        max(started_at) as last_session_at
    from `web_tracking_marts`.`mart_web_sessions`
    group by visitor_id, website_id
)

select
    v.visitor_id,
    v.website_id,
    v.organization_id,
    v.user_id,
    v.anonymous_id,
    coalesce(s.session_count, v.total_sessions, 1) as lifetime_sessions,
    coalesce(s.lifetime_pageviews, v.total_pageviews, 1) as lifetime_pageviews,
    if(coalesce(s.session_count, v.total_sessions, 1) > 1, 1, 0) as is_returning_visitor,
    coalesce(s.lifetime_conversions, 0) as lifetime_conversions,
    coalesce(s.lifetime_revenue, 0.0) as lifetime_revenue,
    v.country,
    v.is_identified_flag,
    coalesce(s.first_session_at, v.first_seen_at) as first_seen_at,
    coalesce(s.last_session_at, v.last_seen_at) as last_seen_at,
    v.created_at
from `web_tracking_staging`.`stg_web_visitors` v
left join sess_rollup s on v.visitor_id = s.visitor_id and v.website_id = s.website_id
    
  )
      
      
