  create or replace view `web_tracking_marts`.`mart_web_sessions` 
  
    
  
  
    
    
  as (
    with pv_agg as (
    select
        session_id,
        count(*) as page_view_count,
        max(max_scroll_depth) as max_session_scroll_depth,
        min(created_at) as first_pv_at,
        max(created_at) as last_pv_at
    from `web_tracking_staging`.`stg_page_views`
    group by session_id
),

int_agg as (
    select
        session_id,
        countIf(event_type = 'click') as total_clicks,
        countIf(event_type = 'rage_click') as rage_click_count,
        countIf(event_type = 'dead_click') as dead_click_count,
        min(created_at) as first_int_at,
        max(created_at) as last_int_at
    from `web_tracking_staging`.`stg_interaction_events`
    group by session_id
),

conv_agg as (
    select
        session_id,
        count(*) as conversion_count,
        sum(value) as total_revenue,
        countIf(conversion_type = 'purchase') as purchase_count,
        countIf(conversion_type = 'signup') as signup_count,
        countIf(conversion_type = 'begin_checkout') as checkout_start_count,
        countIf(conversion_type = 'add_to_cart') as cart_add_count
    from `web_tracking_staging`.`stg_conversion_events`
    group by session_id
),

form_agg as (
    select
        session_id,
        countIf(event_type = 'form_view') as form_view_count,
        countIf(event_type = 'form_start') as form_start_count,
        countIf(event_type = 'form_submit') as form_submit_count,
        countIf(event_type = 'form_success') as form_success_count
    from `web_tracking_staging`.`stg_form_events`
    group by session_id
),

custom_agg as (
    select
        session_id,
        countIf(event_name = 'site_search') as search_count
    from `web_tracking_staging`.`stg_custom_events`
    group by session_id
),

err_agg as (
    select
        session_id,
        count(*) as error_count
    from `web_tracking_staging`.`stg_error_events`
    group by session_id
),

prod_agg as (
    select
        session_id,
        count(*) as product_interaction_count
    from `web_tracking_staging`.`stg_product_interactions`
    group by session_id
),

session_order as (
    -- Ranks each visitor's sessions chronologically so we can flag the
    -- true first-ever session. This is what drives time-window-correct
    -- new vs. returning visitor reporting (a visitor's "new" session is
    -- always the one where this flag = 1, regardless of what date range
    -- a report is later filtered to).
    select
        session_id,
        row_number() over (partition by visitor_id order by started_at asc, session_id asc) as visitor_session_rank
    from `web_tracking_staging`.`stg_web_sessions`
)

select
    s.session_id as session_id,
    s.visitor_id,
    s.website_id,
    s.organization_id,
    s.user_id,
    s.started_at,
    s.ended_at,
    -- Accurate duration from session timestamps
    coalesce(s.duration_seconds, dateDiff('second', s.started_at, s.ended_at)) as duration_seconds,
    coalesce(p.page_view_count, s.pageview_count, 1) as page_view_count,
    -- GA4-style engaged session: lasted 10s+, OR had 2+ pageviews, OR had a conversion.
    -- Bounce = the inverse of engaged (this replaces the old UA-style
    -- "1 pageview only" definition per your confirmation).
    if(
        coalesce(s.duration_seconds, dateDiff('second', s.started_at, s.ended_at)) >= 10
        or coalesce(p.page_view_count, s.pageview_count, 1) >= 2
        or coalesce(c.conversion_count, 0) > 0,
        1, 0
    ) as is_engaged_flag,
    if(
        coalesce(s.duration_seconds, dateDiff('second', s.started_at, s.ended_at)) >= 10
        or coalesce(p.page_view_count, s.pageview_count, 1) >= 2
        or coalesce(c.conversion_count, 0) > 0,
        0, 1
    ) as is_bounce_flag,
    -- Time-window-safe new-visitor basis: 1 only on a visitor's first-ever session.
    if(so.visitor_session_rank = 1, 1, 0) as is_first_session_flag,
    coalesce(i.total_clicks, 0) as total_clicks,
    coalesce(i.rage_click_count, 0) as rage_click_count,
    if(coalesce(i.rage_click_count, 0) > 0, 1, 0) as has_rage_clicks,
    coalesce(i.dead_click_count, 0) as dead_click_count,
    if(coalesce(i.dead_click_count, 0) > 0, 1, 0) as has_dead_clicks,
    coalesce(p.max_session_scroll_depth, 0.0) as max_session_scroll_depth,
    if(coalesce(p.max_session_scroll_depth, 0.0) >= 50.0, 1, 0) as has_deep_scroll,
    coalesce(c.conversion_count, 0) as conversion_count,
    if(coalesce(c.conversion_count, 0) > 0, 1, 0) as has_conversion,
    coalesce(c.total_revenue, 0.0) as total_revenue,
    coalesce(c.purchase_count, 0) as purchase_count,
    if(coalesce(c.purchase_count, 0) > 0, 1, 0) as has_purchase,
    coalesce(c.signup_count, 0) as signup_count,
    if(coalesce(c.signup_count, 0) > 0, 1, 0) as has_signup,
    coalesce(c.checkout_start_count, 0) as checkout_start_count,
    if(coalesce(c.checkout_start_count, 0) > 0, 1, 0) as has_checkout_start,
    coalesce(c.cart_add_count, 0) as cart_add_count,
    if(coalesce(c.cart_add_count, 0) > 0, 1, 0) as has_cart_add,
    coalesce(pr.product_interaction_count, 0) as product_interaction_count,
    if(coalesce(pr.product_interaction_count, 0) > 0, 1, 0) as has_product_view,
    coalesce(f.form_view_count, 0) as form_view_count,
    coalesce(f.form_start_count, 0) as form_start_count,
    if(coalesce(f.form_start_count, 0) > 0, 1, 0) as has_form_start,
    coalesce(f.form_submit_count, 0) as form_submit_count,
    if(coalesce(f.form_submit_count, 0) > 0, 1, 0) as has_form_submit,
    coalesce(f.form_success_count, 0) as form_success_count,
    if(coalesce(f.form_success_count, 0) > 0, 1, 0) as has_form_success,
    coalesce(cu.search_count, 0) as search_count,
    if(coalesce(cu.search_count, 0) > 0, 1, 0) as has_search,
    coalesce(e.error_count, 0) as error_count,
    if(coalesce(e.error_count, 0) > 0, 1, 0) as has_error,
    s.entry_page,
    s.exit_page,
    s.referrer,
    s.referrer_domain,
    s.utm_source,
    s.utm_medium,
    s.utm_campaign,
    s.utm_term,
    s.utm_content,
    s.wt_organization_id,
    s.wt_campaign_id,
    s.wt_contact_id,
    s.device,
    s.browser,
    s.browser_version,
    s.platform,
    s.country,
    s.city,
    s.region,
    s.latitude,
    s.longitude,
    s.is_campaign_attributed,
    s.is_identified,
    s.created_at
from `web_tracking_staging`.`stg_web_sessions` s
left join pv_agg p on s.session_id = p.session_id
left join int_agg i on s.session_id = i.session_id
left join conv_agg c on s.session_id = c.session_id
left join form_agg f on s.session_id = f.session_id
left join custom_agg cu on s.session_id = cu.session_id
left join err_agg e on s.session_id = e.session_id
left join prod_agg pr on s.session_id = pr.session_id
left join session_order so on s.session_id = so.session_id
    
  )
      
      
                    -- end_of_sql
                    
                    ...
