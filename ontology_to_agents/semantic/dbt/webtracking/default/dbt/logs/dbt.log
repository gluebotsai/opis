        utm_term,
        extractURLParameter(entry_page, 'utm_term')
    ) as utm_term,
    if(
        utm_content != '',
        utm_content,
        extractURLParameter(entry_page, 'utm_content')
    ) as utm_content,
    wt_organization_id,
    wt_campaign_id,
    wt_contact_id,
    device,
    browser,
    browser_version,
    platform,
    country,
    city,
    region,
    latitude,
    longitude,
    ip_hash,
    user_agent,
