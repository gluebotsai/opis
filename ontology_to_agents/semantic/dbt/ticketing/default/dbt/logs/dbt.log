-- Order By [] Limit 50
-- Write to DataTable
SELECT
  resolution_hours_total / resolved_for_avg AS average_resolution_time_hours
FROM (
  -- Constrain Output with WHERE
  -- Select: ['__resolution_hours_total', '__resolved_for_avg']
  -- Aggregate Inputs for Simple Metrics
  -- Compute Metrics via Expressions
  SELECT
    SUM(resolution_hours_total) AS resolution_hours_total
    , SUM(resolved_for_avg) AS resolved_for_avg
  FROM (
    -- Read Elements From Semantic Model 'ticket'
    -- Metric Time Dimension 'created_at'
    -- Select: ['__resolution_hours_total', '__resolved_for_avg', 'ticket__organization_id', 'ticket__assignee']
    SELECT
      assignee_id AS ticket__assignee
      , organization_id AS ticket__organization_id
      , resolution_hours AS resolution_hours_total
      , CASE WHEN case when is_resolved then ticket_id end IS NOT NULL THEN 1 ELSE 0 END AS resolved_for_avg
    FROM "worktual_bigint"."ticketing_marts"."mart_tickets" ticket_src_10000
  ) subq_2
  WHERE ticket__organization_id = '1000' AND ticket__assignee IN ('1001')
) subq_6
LIMIT 50
