\n               cmp='=',\n               prefix='',\n               suffix='',\n               then_value=1,\n               else_value=0,\n               quote_identifiers=True,\n               distinct=False) %}\n  {% for value in values %}\n    {{ agg }}(\n      {% if distinct %} distinct {% endif %}\n      case\n      when {{ column }} {{ cmp }} '{{ dbt.escape_single_quotes(value) }}'\n        then {{ then_value }}\n      else {{ else_value }}\n      end\n    )\n    {% if alias %}\n      {% if quote_identifiers %}\n            as {{ adapter.quote(prefix ~ value ~ suffix) }}\n      {% else %}\n        as {{ dbt_utils.slugify(prefix ~ value ~ suffix) }}\n      {% endif %}\n    {% endif %}\n    {% if not loop.last %},{% endif %}\n  {% endfor %}\n{% endmacro %}", 'depends_on': {'macros': ['macro.dbt.escape_single_quotes', 'macro.dbt_utils.slugify']}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [{'name': 'column', 'type': None, 'description': ''}, {'name': 'values', 'type': None, 'description': ''}, {'name': 'alias', 'type': None, 'description': ''}, {'name': 'agg', 'type': None, 'description': ''}, {'name': 'cmp', 'type': None, 'description': ''}, {'name': 'prefix', 'type': None, 'description': ''}, {'name': 'suffix', 'type': None, 'description': ''}, {'name': 'then_value', 'type': None, 'description': ''}, {'name': 'else_value', 'type': None, 'description': ''}, {'name': 'quote_identifiers', 'type': None, 'description': ''}, {'name': 'distinct', 'type': None, 'description': ''}], 'created_at': 1789572544.2784033, 'supported_languages': None}, 'macro.dbt_utils.unpivot': {'name': 'unpivot', 'resource_type': 'macro', 'package_name': 'dbt_utils', 'path': 'macros/sql/unpivot.sql', 'original_file_path': 'macros/sql/unpivot.sql', 'unique_id': 'macro.dbt_utils.unpivot', 'macro_sql': "{% macro unpivot(relation=none, cast_to='varchar', exclude=