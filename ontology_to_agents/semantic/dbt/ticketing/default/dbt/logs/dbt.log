-- Select: ['__open_tickets_metric', 'ticket__priority']
-- Aggregate Inputs for Simple Metrics
-- Compute Metrics via Expressions
-- Order By [] Limit 1
-- Write to DataTable
SELECT
  ticket__priority
  , SUM(open_tickets_metric) AS open_tickets_metric
FROM (
  -- Read Elements From Semantic Model 'ticket'
  -- Metric Time Dimension 'created_at'
  -- Select: ['__open_tickets_metric', 'ticket__priority', 'ticket__organization_id']
  SELECT
    organization_id AS ticket__organization_id
    , priority AS ticket__priority
    , CASE WHEN case when is_open then ticket_id end IS NOT NULL THEN 1 ELSE 0 END AS open_tickets_metric
  FROM "worktual_bigint"."ticketing_marts"."mart_tickets" ticket_src_10000
) subq_2
WHERE ticket__organization_id = '1000'
GROUP BY
  ticket__priority
LIMIT 1
