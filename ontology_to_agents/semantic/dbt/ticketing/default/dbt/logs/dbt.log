FROM (
  -- Constrain Output with WHERE
  -- Select: ['__resolution_hours_total', '__resolved_for_avg']
  -- Aggregate Inputs for Simple Metrics
  -- Compute Metrics via Expressions
  SELECT
    SUM(resolution_hours_total) AS resolution_hours_total
    , SUM(resolved_for_avg) AS resolved_for_avg
  FROM (
    -- Read Elements From Semantic Model 'ticket'
    -- Metric Time Dimension 'created_at'
    -- Select: ['__resolution_hours_total', '__resolved_for_avg', 'ticket__organization_id', 'ticket__assignee']
