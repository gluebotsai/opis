         {% set unique_key_match = get_merge_unique_key_match(source_unique_key, target_unique_key) %}\n            {% do predicates.append(unique_key_match) %}\n        {% endif %}\n    {% else %}\n        {% do predicates.append(\'FALSE\') %}\n    {% endif %}\n\n    {{ sql_header if sql_header is not none }}\n\n    merge into {{ target }} as DBT_INTERNAL_DEST\n        using {{ source }} as DBT_INTERNAL_SOURCE\n        on {{"(" ~ predicates | join(") and (") ~ ")"}}\n\n    {% if unique_key %}\n    when matched then update set\n        {% for column_name in update_columns -%}\n            {{ column_name }} = DBT_INTERNAL_SOURCE.{{ column_name }}\n            {%- if not loop.last %}, {%- endif %}\n        {%- endfor %}\n    {% endif %}\n\n    when not matched then insert\n        ({{ dest_cols_csv }})\n    values\n        ({{ dest_cols_csv }})\n\n{% endmacro %}', 'depends_on': {'macros': ['macro.dbt.get_quoted_csv', 'macro.dbt.get_merge_update_columns', 'macro.dbt.get_merge_unique_key_match']}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [{'name': 'target', 'type': None, 'description': ''}, {'name': 'source', 'type': None, 'description': ''}, {'name': 'unique_key', 'type': None, 'description': ''}, {'name': 'dest_columns', 'type': None, 'description': ''}, {'name': 'incremental_predicates', 'type': None, 'description': ''}], 'created_at': 1789572544.056249, 'supported_languages': None}, 'macro.dbt.get_delete_insert_merge_sql': {'name': 'get_delete_insert_merge_sql', 'resource_type': 'macro', 'package_name': 'dbt', 'path': 'macros/materializations/models/incremental/merge.sql', 'original_file_path': 'macros/materializations/models/incremental/merge.sql', 'unique_id': 'macro.dbt.get_delete_insert_merge_sql', 'macro_sql': "{% macro get_delete_insert_merge_sql(target, source, unique_key, dest_columns, incremental_predicates) -%}\n  {{ adapte