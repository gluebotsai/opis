  -- Select: [
  --   '__breached_tickets_metric',
  --   '__tickets_with_resolution_sla_target_metric',
  --   'ticket__organization_id',
  --   'ticket__assignee',
  -- ]
  SELECT
    assignee_id AS ticket__assignee
    , organization_id AS ticket__organization_id
    , CASE WHEN case when is_breached_proxy then ticket_id end IS NOT NULL THEN 1 ELSE 0 END AS breached_tickets_metric
    , CASE WHEN case when has_resolution_sla_target then ticket_id end IS NOT NULL THEN 1 ELSE 0 END AS tickets_with_resolution_sla_target_metric
  FROM "worktual_bigint"."ticketing_marts"."mart_tickets" ticket_src_10000
) subq_2
WHERE ticket__organization_id = '1000' AND ticket__assignee IN ('1001')
LIMIT 50
