  create view "worktual_bigint"."crm_marts"."mart_order_line_daily_summary__dbt_tmp"
    
    
  as (
    

-- One row per organization_id x day. Pre-aggregates units, revenue, and
-- distinct product counts for `agg: average` measures.

select
    organization_id,
    business_type,
    date_trunc('day', created_at)          as day,
    sum(quantity)                            as units_sold_sum,
    sum(line_amount)                         as order_line_revenue_sum,
    count(distinct product_id)               as distinct_products_sold
from "worktual_bigint"."crm_marts"."mart_order_lines"
group by 1, 2, 3
  );
[0m11:55:20.084213 [debug] [Thread-4 (]: On model.postgres_warehouse_dbt.mart_proposal_daily_summary: /* {"app": "dbt", "dbt_version": "1.12.4", "profile_name": "postgres_warehouse_dbt", "target_name": "dev", "node_id": "model.postgres_warehouse_dbt.mart_proposal_daily_summary"} */

  create view "worktual_bigint"."crm_marts"."mart_proposal_daily_summary__dbt_tmp"
    
    
  as (
    

-- One row per organization_id x day. Pre-aggregates proposal counts and
-- the daily acceptance rate for `agg: average` measures.

select
    organization_id,
    business_type,
    date_trunc('day', created_at)                            as day,
    count(case when is_sent then proposal_id end)               as proposal_sent_count,
    count(case when is_accepted then proposal_id end)           as proposal_accepted_count,
    case when count(case when is_sent then proposal_id end) > 0
         then count(case when is_accepted then proposal_id end)::decimal
              / nullif(count(case when is_sent then proposal_id end), 0)
    end                                                          as daily_proposal_acceptance_rate
from "worktual_bigint"."crm_marts"."mart_proposals"
group by 1, 2, 3
  );
