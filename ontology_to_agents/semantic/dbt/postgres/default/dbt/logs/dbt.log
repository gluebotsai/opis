e', 'macro_sql': '\n{%- macro databricks__deduplicate(relation, partition_by, order_by) -%}\n\n    select *\n    from {{ relation }}\n    qualify\n        row_number() over (\n            partition by {{ partition_by }}\n            order by {{ order_by }}\n        ) = 1\n\n{%- endmacro -%}\n\n', 'depends_on': {'macros': []}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [{'name': 'relation', 'type': None, 'description': ''}, {'name': 'partition_by', 'type': None, 'description': ''}, {'name': 'order_by', 'type': None, 'description': ''}], 'created_at': 1789572502.9159184, 'supported_languages': None}, 'macro.dbt_utils.bigquery__deduplicate': {'name': 'bigquery__deduplicate', 'resource_type': 'macro', 'package_name': 'dbt_utils', 'path': 'macros/sql/deduplicate.sql', 'original_file_path': 'macros/sql/deduplicate.sql', 'unique_id': 'macro.dbt_utils.bigquery__deduplicate', 'macro_sql': '\n{%- macro bigquery__deduplicate(relation, partition_by, order_by) -%}\n\n    select unique.*\n    from (\n        select\n            array_agg (\n                original\n                order by {{ order_by }}\n                limit 1\n            )[offset(0)] unique\n        from {{ relation }} original\n        group by {{ partition_by }}\n    )\n\n{%- endmacro -%}', 'depends_on': {'macros': []}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [{'name': 'relation', 'type': None, 'description': ''}, {'name': 'partition_by', 'type': None, 'description': ''}, {'name': 'order_by', 'type': None, 'description': ''}], 'created_at': 1789572502.9166768, 'supported_languages': None}, 'macro.dbt_utils.get_table_types_sql': {'name': 'get_table_types_sql', 'resource_type': 'macro', 'package_name': 'dbt_utils', 'path': 'macros/sql/get_table