  create view "worktual_bigint"."ticketing_marts"."mart_ticket_notes__dbt_tmp"
    
    
  as (
    
-- Ticket notes/replies denormalized with parent ticket's priority, status,
-- queue, and assignee, so reply-volume / agent-activity metrics can be
-- grouped or filtered by ticket context without a query-time join.
select
    n.ticket_note_id,
    n.organization_id,
    n.ticket_id,
    t.ticket_number,
    t.priority              as ticket_priority,
    t.status                as ticket_status,
    t.queue_id,
    t.queue_name,
    t.assignee_id,
    t.assignee_name,
    n.author_id,
    n.author_name,
    n.visibility,
    n.is_internal_note,
    n.created_at
from "worktual_bigint"."ticketing_staging"."stg_ticket_notes" n
left join "worktual_bigint"."ticketing_staging"."stg_tickets" t
    on n.ticket_id = t.ticket_id
    and n.organization_id = t.organization_id
  );
[0m22:30:48.001531 [debug] [Thread-3 (]: On model.postgres_warehouse_dbt.mart_agent_queue_members: /* {"app": "dbt", "dbt_version": "1.12.4", "profile_name": "postgres_warehouse_dbt", "target_name": "dev", "node_id": "model.postgres_warehouse_dbt.mart_agent_queue_members"} */

  create view "worktual_bigint"."ticketing_marts"."mart_agent_queue_members__dbt_tmp"
    
    
  as (
    
-- Agent-to-queue membership denormalized with queue name/type, agent
-- name/role, and the queue's MyAccount team product coverage, for queue
-- coverage / staffing metrics — distinct from mart_tickets.queue_id,
-- which only reflects the queue on one ticket.
select
    m.queue_membership_id,
    m.organization_id,
    m.queue_id,
    q.queue_name,
    q.queue_type,
    q.sla_status,
    'Support Team'            as myaccount_team_name,
    true                      as team_supports_ticketing,
    m.user_id,
    u.user_name,
    u.role                    as user_role,
    m.created_at
from "worktual_bigint"."ticketing_staging"."stg_agent_queue_members" m
left join "worktual_bigint"."ticketing_staging"."stg_agent_queues" q
    on m.queue_id = q.queue_id
    and m.organization_id = q.organization_id
left join "worktual_bigint"."ticketing_staging"."stg_users" u
    on m.user_id = u.user_id
    and m.organization_id = u.organization_id
  );
