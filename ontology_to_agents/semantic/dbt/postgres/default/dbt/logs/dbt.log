  create view "worktual_bigint"."ccass_staging_aiccaas"."stg_copilot_skill_executions__dbt_tmp"
    
    
  as (
    -- Tool execution proxy. Confirm actual `status` distinct values in prod
-- (expected: started / succeeded / failed / cancelled) before trusting tool_success_rate.
select
    e.id as execution_id,
    e.organization_id,
    e.session_id,
    e.turn_id,
    t.conversation_id,
    e.skill_key,
    e.tool_key,
    e.status as execution_status,
    e.latency_ms,
    e.error_message,
    e.created_at

from "worktual_bigint"."ccass"."copilot_skill_executions" e
left join "worktual_bigint"."ccass"."copilot_turns" t on e.turn_id = t.id
  );
[0m22:30:09.264338 [debug] [Thread-2 (]: On model.postgres_warehouse_dbt.stg_copilot_turns: /* {"app": "dbt", "dbt_version": "1.12.4", "profile_name": "postgres_warehouse_dbt", "target_name": "dev", "node_id": "model.postgres_warehouse_dbt.stg_copilot_turns"} */

  create view "worktual_bigint"."ccass_staging_aiccaas"."stg_copilot_turns__dbt_tmp"
    
    
  as (
    -- Agent-assist suggestion proxy. Real schema only has a boolean `accepted`,
-- not a full accepted/modified/rejected enum, so we infer:
--   accepted = true  and final_text = suggestion_text  -> 'accepted'
--   accepted = true  and final_text != suggestion_text -> 'modified'
--   accepted = false                                    -> 'rejected'
--   accepted is null                                    -> 'pending'
select
    id as suggestion_id,
    organization_id,
    session_id,
    conversation_id,
    skill_key,
    accepted,
    suggestion_text,
    final_text,
    status,
    created_at,

    case
        when accepted is true and final_text is not distinct from suggestion_text then 'accepted'
        when accepted is true and final_text is distinct from suggestion_text then 'modified'
        when accepted is false then 'rejected'
        else 'pending'
    end as suggestion_disposition

from "worktual_bigint"."ccass"."copilot_turns"
  );
