get columns not in source: {{ target_not_in_source }}\n        New column types: {{ new_target_types }}\n  {% endset %}\n\n  {% do log(msg) %}\n\n  {{ return(changes_dict) }}\n\n{% endmacro %}", 'depends_on': {'macros': ['macro.dbt.diff_columns', 'macro.dbt.diff_column_data_types']}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [{'name': 'source_relation', 'type': None, 'description': ''}, {'name': 'target_relation', 'type': None, 'description': ''}], 'created_at': 1789572502.6078317, 'supported_languages': None}, 'macro.dbt.sync_column_schemas': {'name': 'sync_column_schemas', 'resource_type': 'macro', 'package_name': 'dbt', 'path': 'macros/materializations/models/incremental/on_schema_change.sql', 'original_file_path': 'macros/materializations/models/incremental/on_schema_change.sql', 'unique_id': 'macro.dbt.sync_column_schemas', 'macro_sql': "{% macro sync_column_schemas(on_schema_change, target_relation, schema_changes_dict) %}\n  {{ return(adapter.dispatch('sync_column_schemas', 'dbt')(on_schema_change, target_relation, schema_changes_dict)) }}\n{% endmacro %}", 'depends_on': {'macros': ['macro.dbt.default__sync_column_schemas']}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [{'name': 'on_schema_change', 'type': None, 'description': ''}, {'name': 'target_relation', 'type': None, 'description': ''}, {'name': 'schema_changes_dict', 'type': None, 'description': ''}], 'created_at': 1789572502.608638, 'supported_languages': None}, 'macro.dbt.default__sync_column_schemas': {'name': 'default__sync_column_schemas', 'resource_type': 'macro', 'package_name': 'dbt', 'path': 'macros/materializations/models/incremental/on_schema_change.sql', 'original_file_path': 'macros/materializations/models/incremental/on_schema_