  create view "worktual_bigint"."campaign_staging"."stg_campaign_send_batches__dbt_tmp"
    
    
  as (
    -- One row per send batch (campaign x channel x seq). Grain: batch_id.
select
    id              as batch_id,
    campaign_id,
