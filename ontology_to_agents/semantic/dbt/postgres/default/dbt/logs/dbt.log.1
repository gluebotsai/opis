  create view "worktual_bigint"."crm_marts"."mart_companies__dbt_tmp"
    
    
  as (
    

select
    c.company_id,
    c.organization_id,
    org.business_type,
    c.company_name,
    c.company_industry,
    c.employee_count,
    c.domain,
