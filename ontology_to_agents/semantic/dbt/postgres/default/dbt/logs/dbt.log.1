    e.session_id,
    e.turn_id,
    t.conversation_id,
    e.skill_key,
    e.tool_key,
    e.status as execution_status,
    e.latency_ms,
    e.error_message,
    e.created_at

from "worktual_bigint"."ccass"."copilot_skill_executions" e
left join "worktual_bigint"."ccass"."copilot_turns" t on e.turn_id = t.id
  );
