  as (
    

select
    ca.contact_activity_id,
    ca.contact_id,
    ca.organization_id,
    org.business_type,
    ca.activity_type,
    ca.subject,
    ca.due_at,
    ca.completed_at,
    ca.folder,
    ca.task_status,
    ca.is_completed,
    ca.is_task,
    ca.created_by_user_id,
    u.full_name          as created_by_name,
    c.lifecycle_stage     as contact_lifecycle_stage,
    c.company_id,
    c.owner_user_id        as contact_owner_user_id,
    ca.created_at,
    ca.updated_at
