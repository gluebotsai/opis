\nwith meet_condition as(\n  select *\n  from {{ model }}\n),\n\nvalidation_errors as (\n  select *\n  from meet_condition\n  where\n    -- never true, defaults to an empty result set. Exists to ensure any combo of the `or` clauses below succeeds\n    1 = 2\n\n  {%- if min_value is not none %}\n    -- records with a value >= min_value are permitted. The `not` flips this to find records that don\'t meet the rule.\n    or not {{ column_name }} > {{- "=" if inclusive }} {{ min_value }}\n  {%- endif %}\n\n  {%- if max_value is not none %}\n    -- records with a value <= max_value are permitted. The `not` flips this to find records that don\'t meet the rule.\n    or not {{ column_name }} < {{- "=" if inclusive }} {{ max_value }}\n  {%- endif %}\n)\n\nselect *\nfrom validation_errors\n\n{% endmacro %}', 'depends_on': {'macros': []}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [{'name': 'model', 'type': None, 'description': ''}, {'name': 'column_name', 'type': None, 'description': ''}, {'name': 'min_value', 'type': None, 'description': ''}, {'name': 'max_value', 'type': None, 'description': ''}, {'name': 'inclusive', 'type': None, 'description': ''}], 'created_at': 1789472253.366158, 'supported_languages': None}, 'macro.dbt_utils.get_url_parameter': {'name': 'get_url_parameter', 'resource_type': 'macro', 'package_name': 'dbt_utils', 'path': 'macros/web/get_url_parameter.sql', 'original_file_path': 'macros/web/get_url_parameter.sql', 'unique_id': 'macro.dbt_utils.get_url_parameter', 'macro_sql': "{% macro get_url_parameter(field, url_parameter) -%}\n    {{ return(adapter.dispatch('get_url_parameter', 'dbt_utils')(field, url_parameter)) }}\n{% endmacro %}", 'depends_on': {'macros': ['macro.dbt_utils.default__get_url_parameter']}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': Tr