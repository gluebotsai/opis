  create  table "worktual_bigint"."campaign_marts"."mart_campaign_batch_health__dbt_tmp"
  
  
    as
  
  (
    -- Grain: campaign_id + channel_name. Batch-level send health — different from
-- per-recipient performance: measures how sending infrastructure/batches behaved,
-- not individual recipient outcomes.
with batches as (
    select * from "worktual_bigint"."campaign_staging"."stg_campaign_send_batches"
),

campaigns as (
    select campaign_id, organization_id
    from "worktual_bigint"."campaign_staging"."stg_campaigns"
)

select
    b.campaign_id,
    c.organization_id,
    b.channel_name,
    min(b.created_at)                              as first_batch_created_at,
    count(*)                                     as batch_count,
    count(*) filter (where b.batch_status = 'failed')   as failed_batch_count,
    count(*) filter (where b.batch_status = 'done')      as completed_batch_count,
    sum(b.expected_recipient_count)                as total_expected_recipients,
    avg(b.batch_processing_seconds)                as avg_batch_processing_seconds,
    count(*) filter (where b.batch_status = 'failed')::numeric
        / nullif(count(*), 0)                    as batch_failure_rate
from batches b
left join campaigns c on c.campaign_id = b.campaign_id
group by 1, 2, 3
  );
  
[0m21:17:36.106846 [debug] [Thread-3 (]: On model.postgres_warehouse_dbt.mart_campaign_overview: /* {"app": "dbt", "dbt_version": "1.12.4", "profile_name": "postgres_warehouse_dbt", "target_name": "dev", "node_id": "model.postgres_warehouse_dbt.mart_campaign_overview"} */

  
    

  create  table "worktual_bigint"."campaign_marts"."mart_campaign_overview__dbt_tmp"
  
  
    as
  
  (
    -- Grain: campaign_id. Supports: campaign_count, campaign_volume,
-- live_campaign_count, scheduled_campaign_count, audience_reached.
with campaigns as (
    select * from "worktual_bigint"."campaign_staging"."stg_campaigns"
),

audience as (
    select
        campaign_id,
        count(distinct contact_id) as audience_reached
    from "worktual_bigint"."campaign_staging"."stg_campaign_audience"
    group by 1
)

select
    c.campaign_id,
    c.organization_id,
    c.branch_id,
    c.campaign_name,
    c.campaign_status,
    c.source_channel,
    c.is_live_flag,
    c.is_scheduled_flag,
    c.is_completed_flag,
    c.audience_count as snapshot_audience_count,   -- denormalized at save time
    coalesce(a.audience_reached, 0) as audience_reached,  -- recomputed from campaign_audience
    c.planned_duration_seconds,
    c.starts_at,
    c.ends_at,
    c.created_at
from campaigns c
left join audience a using (campaign_id)
  );
  
