    select
        company_id,
        organization_id,
        count(*) as location_count
    from "worktual_bigint"."crm_staging"."stg_company_locations"
    group by 1, 2
) loc
    on c.company_id = loc.company_id
    and c.organization_id = loc.organization_id
  );
