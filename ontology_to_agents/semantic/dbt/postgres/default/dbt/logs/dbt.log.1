SQL, SQLite, Redshift, Teradata, Materialize, Databricks\n    -- Apache Spark, SingleStore, Vertica\n    -- Those that do not appear to support natural joins include:\n    -- SQLServer, Trino, Presto, Rockset, Athena\n    #}\n    natural join row_numbered\n    where row_numbered.rn = 1\n\n{%- endmacro -%}\n\n', 'depends_on': {'macros': []}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [{'name': 'relation', 'type': None, 'description': ''}, {'name': 'partition_by', 'type': None, 'description': ''}, {'name': 'order_by', 'type': None, 'description': ''}], 'created_at': 1789204769.040051, 'supported_languages': None}, 'macro.dbt_utils.redshift__deduplicate': {'name': 'redshift__deduplicate', 'resource_type': 'macro', 'package_name': 'dbt_utils', 'path': 'macros/sql/deduplicate.sql', 'original_file_path': 'macros/sql/deduplicate.sql', 'unique_id': 'macro.dbt_utils.redshift__deduplicate', 'macro_sql': '{% macro redshift__deduplicate(relation, partition_by, order_by) -%}\n\n    select *\n    from {{ relation }} as tt\n    qualify\n        row_number() over (\n            partition by {{ partition_by }}\n            order by {{ order_by }}\n        ) = 1\n\n{% endmacro %}', 'depends_on': {'macros': []}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [{'name': 'relation', 'type': None, 'description': ''}, {'name': 'partition_by', 'type': None, 'description': ''}, {'name': 'order_by', 'type': None, 'description': ''}], 'created_at': 1789204769.040462, 'supported_languages': None}, 'macro.dbt_utils.postgres__deduplicate': {'name': 'postgres__deduplicate', 'resource_type': 'macro', 'package_name': 'dbt_utils', 'path': 'macros/sql/deduplicate.sql', 'original_file_path': 'macros/sql/deduplicate.sql', 'unique_id': 'macro.dbt_