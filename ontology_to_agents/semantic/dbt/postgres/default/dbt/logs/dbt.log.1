  create  table "worktual_bigint"."campaign_marts"."mart_template_approval__dbt_tmp"
  
  
    as
  
  (
    -- Grain: organization_id + channel_name. Supports template_count, template_approval_rate.
-- Only covers regulated_channel_templates (sms/whatsapp). Non-regulated channel templates
-- (campaign_channel_templates, used pre-save in agent sessions) have no approval concept
-- and are excluded here.
with templates as (
    select * from "worktual_bigint"."campaign_staging"."stg_regulated_channel_templates"
)

select
    organization_id,
    channel_name,
    min(submitted_at)                          as first_submitted_at,
    max(last_status_checked_at)                as last_checked_at,
    count(*)                                   as template_count,
    count(*) filter (where is_approved_flag)    as approved_template_count,
    count(*) filter (where is_rejected_flag)    as rejected_template_count,
    count(*) filter (where is_approved_flag)::numeric
        / nullif(count(*), 0)                  as template_approval_rate
from templates
group by 1, 2
  );
  
[0m17:12:14.597808 [debug] [Thread-3 (]: On model.postgres_warehouse_dbt.mart_template_rejection_reasons: /* {"app": "dbt", "dbt_version": "1.12.4", "profile_name": "postgres_warehouse_dbt", "target_name": "dev", "node_id": "model.postgres_warehouse_dbt.mart_template_rejection_reasons"} */

  
    

  create  table "worktual_bigint"."campaign_marts"."mart_template_rejection_reasons__dbt_tmp"
  
  
    as
  
  (
    -- Grain: organization_id + channel_name + rejected_reason. Only rejected templates.
-- Kept separate from mart_template_approval (which is org+channel grain) because
-- rejected_reason is a free-form field — pivoting it into columns isn't safe, and
-- mixing grains in one mart breaks measure additivity in the semantic layer.
select
    organization_id,
    channel_name,
    coalesce(rejected_reason, 'unspecified') as rejected_reason,
    min(submitted_at) as first_rejected_template_submitted_at,
    count(*) as rejected_template_count
from "worktual_bigint"."campaign_staging"."stg_regulated_channel_templates"
where is_rejected_flag
group by 1, 2, 3
  );
  
