        "type": "object",
        "properties": { "email": { "type": "string" } },
        "required": ["email"]
      }
    },
    {
      "name": "import_customers",
      "description": "Import customers from CSV text. Do not invent rows.",
      "auth": "actor_or_api_key",
      "express": { "method": "POST", "path": "/api/customers/import" },
      "input_schema": {
        "type": "object",
        "properties": { "csv_text": { "type": "string" } },
        "required": ["csv_text"]
      }
    },
    {
      "name": "create_customer",
      "description": "Create a customer in the directory (admin). Same body as Customers form.",
      "auth": "actor_or_api_key",
      "express": { "method": "POST", "path": "/api/customers" },
      "input_schema": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "email": { "type": "string" },
          "phone": { "type": "string" },
          "accountName": { "type": "string" }
        },
        "required": ["name"]
      }
    },
    {
      "name": "list_macros",
      "description": "List macros. Optional q searches title/body in SQL.",
      "auth": "actor_or_api_key",
