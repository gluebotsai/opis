{
  "schema_version": "1.0",
  "namespace": "ticketing.v1",
  "tools": [
    {
      "name": "get_ticket",
      "description": "Get one ticket by ticket_number (e.g. 12345 or #12345).",
      "auth": "actor_or_api_key",
      "express": { "method": "GET", "path": "/api/tickets/{ticket_number}" },
      "input_schema": {
        "type": "object",
        "properties": {
          "ticket_number": { "type": "string" }
        },
        "required": ["ticket_number"]
      }
    },
    {
      "name": "list_tickets",
      "description": "List or search tickets using structured, actor-scoped filters.",
      "auth": "actor_or_api_key",
      "express": { "method": "GET", "path": "/api/tickets" },
      "input_schema": {
        "type": "object",
        "properties": {
          "scope": { "type": "string", "enum": ["default", "assignee", "team", "org", "search", "created", "unassigned"] },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
          "created_by": { "type": "string", "enum": ["SELF"] },
          "assigned_to": { "type": "string" },
          "status": { "type": "string" },
          "priority": { "type": "string" },
          "channel": { "type": "string" },
          "query": { "type": "string", "maxLength": 200 },
          "queue": { "type": "string" },
          "customer": { "type": "string" },
          "due": { "type": "string", "enum": ["today", "overdue"] },
          "created_range": { "type": "string" },
          "updated_range": { "type": "string" },
          "sort": { "type": "string", "enum": ["latest", "oldest", "priority", "due"] }
        }
      }
    },
    {
      "name": "get_ticket_progress",
      "description": "Get ticket progress stepper and status history.",
      "auth": "actor_or_api_key",
      "express": { "method": "GET", "path": "/api/tickets/{ticket_number}/progress" },
      "input_schema": {
        "type": "object",
        "properties": {
          "ticket_number": { "type": "string" }
        },
        "required": ["ticket_number"]
      }
    },
    {
      "name": "list_ticket_notes",
      "description": "List recent notes for one ticket.",
      "auth": "actor_or_api_key",
      "express": { "method": "GET", "path": "/api/tickets/{ticket_number}/notes" },
      "input_schema": {
        "type": "object",
        "properties": { "ticket_number": { "type": "string" } },
        "required": ["ticket_number"]
      }
    },
    {
      "name": "get_triage_stats",
      "description": "Agent/admin triage cards: created by me, reassigned out, open on my teams.",
      "auth": "actor_or_api_key",
      "express": { "method": "GET", "path": "/api/agent/triage-stats" },
      "input_schema": { "type": "object", "properties": {} }
    },
    {
      "name": "get_dashboard_chart",
      "description": "Dashboard workload chart series for a time range.",
      "auth": "actor_or_api_key",
      "express": { "method": "GET", "path": "/api/dashboard/chart" },
      "input_schema": {
        "type": "object",
        "properties": {
          "chart_range": { "type": "string", "enum": ["24hours", "7days", "30days"] }
        }
      }
    },
    {
      "name": "list_activities",
      "description": "Recent Home dashboard activity rows.",
      "auth": "actor_or_api_key",
      "express": { "method": "GET", "path": "/api/activities" },
      "input_schema": { "type": "object", "properties": {} }
    },
    {
      "name": "create_ticket",
      "description": "Create a ticket (customerName and/or subject required).",
      "auth": "actor_or_api_key",
      "express": { "method": "POST", "path": "/api/tickets" },
      "input_schema": {
        "type": "object",
        "properties": {
          "customerName": { "type": "string" },
          "customerId": { "type": "string" },
          "customerEmail": { "type": "string" },
          "customerPhone": { "type": "string" },
          "subject": { "type": "string" },
          "description": { "type": "string" },
          "channel": { "type": "string" },
          "priority": { "type": "string" },
          "status": { "type": "string" },
          "queue": { "type": "string" },
          "category": { "type": "string" },
          "skill": { "type": "string" },
          "assigneeId": { "type": "string" },
          "resolverId": { "type": "string" },
          "queueId": { "type": "string" }
        }
      }
    },
    {
      "name": "enrich_ticket",
      "description": "Preview authoritative ticket triage and assignment before confirmation.",
      "auth": "actor_or_api_key",
      "express": { "method": "POST", "path": "/api/tickets/enrich" },
      "input_schema": {
        "type": "object",
        "properties": {
          "customerName": { "type": "string" },
          "customerEmail": { "type": "string" },
          "customerPhone": { "type": "string" },
          "issue": { "type": "string" }
        },
        "required": ["customerName", "issue"]
      }
    },
    {
      "name": "verify_ticket_customer",
      "description": "Check CDP/directory for email or phone during create-ticket before collecting the issue.",
      "auth": "actor_or_api_key",
      "input_schema": {
        "type": "object",
        "properties": {
          "customerName": { "type": "string" },
          "customerEmail": { "type": "string" },
          "customerPhone": { "type": "string" },
          "contact": { "type": "string" }
        }
      }
    },
    {
      "name": "update_ticket",
      "description": "Update ticket fields (status, priority, assignee, subject, …).",
      "auth": "actor_or_api_key",
      "express": { "method": "PUT", "path": "/api/tickets/{ticket_number}" },
      "input_schema": {
        "type": "object",
        "properties": {
          "ticket_number": { "type": "string" },
          "status": { "type": "string" },
          "priority": { "type": "string" },
          "assignee": { "type": "string" },
          "resolver": { "type": "string" },
          "subject": { "type": "string" },
          "description": { "type": "string" },
          "queue": { "type": "string" },
          "category": { "type": "string" },
          "ai_summary": { "type": "string" }
        },
        "required": ["ticket_number"]
      }
    },
    {
      "name": "escalate_ticket",
      "description": "Escalate a ticket; optional assignee/agent/rationale.",
      "auth": "actor_or_api_key",
      "express": { "method": "POST", "path": "/api/tickets/{ticket_number}/escalate" },
      "input_schema": {
        "type": "object",
        "properties": {
          "ticket_number": { "type": "string" },
          "assignee": { "type": "string" },
          "assignee_id": { "type": "string" },
          "agent": { "type": "string" },
          "agent_id": { "type": "string" },
          "rationale": { "type": "string" }
        },
        "required": ["ticket_number"]
      }
    },
    {
      "name": "auto_assign_ticket",
      "description": "Auto-assign a ticket via backend routing. Never invent the assignee.",
      "auth": "actor_or_api_key",
      "express": { "method": "POST", "path": "/api/tickets/{ticket_number}/auto-assign" },
      "input_schema": {
        "type": "object",
        "properties": {
          "ticket_number": { "type": "string" }
        },
        "required": ["ticket_number"]
      }
    },
    {
      "name": "add_ticket_note",
      "description": "Add a note to a ticket by ticket_number.",
      "auth": "actor_or_api_key",
      "express": { "method": "POST", "path": "/api/tickets/{ticket_number}/notes" },
      "input_schema": {
        "type": "object",
        "properties": {
          "ticket_number": { "type": "string" },
          "text": { "type": "string" },
          "visibility": { "type": "string", "enum": ["internal", "public"] }
        },
        "required": ["ticket_number", "text"]
      }
    },
    {
      "name": "list_queues",
      "description": "List teams/queues for the org.",
      "auth": "actor_or_api_key",
      "express": { "method": "GET", "path": "/api/queues" },
      "input_schema": {
        "type": "object",
        "properties": { "query": { "type": "string" } }
      }
    },
    {
      "name": "create_queue",
      "description": "Create a queue/team by name.",
      "auth": "actor_or_api_key",
      "express": { "method": "POST", "path": "/api/queues" },
      "input_schema": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "members": { "type": "array", "items": { "type": "string" } },
          "member_ids": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["name"]
      }
    },
    {
      "name": "update_queue",
      "description": "Update a queue/team (name, description, members). For adding people to an existing team, pass only the new staff in members/member_ids and set add_members=true so existing members are kept. Without add_members, members/member_ids replace the full roster.",
      "auth": "actor_or_api_key",
      "express": { "method": "PATCH", "path": "/api/queues/{queue_id}" },
      "input_schema": {
        "type": "object",
        "properties": {
          "queue_id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "members": { "type": "array", "items": { "type": "string" } },
          "member_ids": { "type": "array", "items": { "type": "string" } },
          "add_members": {
            "type": "boolean",
            "description": "When true, merge members/member_ids into the existing team roster instead of replacing it."
          }
        },
        "required": ["queue_id"]
      }
    },
    {
      "name": "delete_queue",
      "description": "Delete a queue/team by id.",
      "auth": "actor_or_api_key",
      "express": { "method": "DELETE", "path": "/api/queues/{queue_id}" },
      "input_schema": {
        "type": "object",
        "properties": { "queue_id": { "type": "string" } },
        "required": ["queue_id"]
      }
    },
    {
      "name": "resolve_ticket_person",
      "description": "List and rank live staff for ticket reassignment or escalation.",
      "auth": "actor_or_api_key",
      "express": { "method": "GET", "path": "/api/agents" },
      "input_schema": {
        "type": "object",
        "properties": {
          "response": { "type": "string" },
          "ticket_number": { "type": "string" },
          "target_role": { "type": "string", "enum": ["agent", "resolver", "admin"] },
          "user_query": { "type": "string" },
          "proceed": { "type": "integer", "minimum": 0, "maximum": 1 }
        }
      }
    },
    {
      "name": "list_kb",
      "description": "List knowledge base articles.",
      "auth": "actor_or_api_key",
      "express": { "method": "GET", "path": "/api/kb" },
      "input_schema": {
        "type": "object",
        "properties": {
          "query": { "type": "string" },
          "category": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    },
    {
      "name": "list_kb_categories",
      "description": "List category labels derived from live knowledge articles.",
      "auth": "actor_or_api_key",
      "express": { "method": "GET", "path": "/api/kb" },
      "input_schema": { "type": "object", "properties": {} }
    },
    {
      "name": "manage_kb_category",
      "description": "Validate and stage a knowledge category label, or list categories.",
      "auth": "actor_or_api_key",
      "input_schema": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "maxLength": 64 },
          "mode": { "type": "string", "enum": ["add", "list"] }
