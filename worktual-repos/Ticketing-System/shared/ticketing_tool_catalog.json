    {
      "name": "delete_macro",
      "description": "Delete a macro by id.",
      "auth": "actor_or_api_key",
      "express": { "method": "DELETE", "path": "/api/macros/{macro_id}" },
      "input_schema": {
        "type": "object",
        "properties": { "macro_id": { "type": "string" } },
        "required": ["macro_id"]
      }
    },
    {
      "name": "list_agents",
      "description": "List assignable staff for the org.",
      "auth": "actor_or_api_key",
      "express": { "method": "GET", "path": "/api/agents" },
      "input_schema": { "type": "object", "properties": {} }
    },
    {
      "name": "list_priorities",
      "description": "List priority catalog entries.",
      "auth": "actor_or_api_key",
      "express": { "method": "GET", "path": "/api/priorities" },
      "input_schema": {
        "type": "object",
        "properties": { "include_inactive": { "type": "boolean" } }
      }
    },
    {
      "name": "create_priority",
