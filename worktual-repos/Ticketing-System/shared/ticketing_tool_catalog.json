      "name": "get_metrics",
      "description": "Structured Home dashboard snapshot only (scope=org|self). NOT for natural-language 'how many open tickets' questions — those MUST use ask_semantic_layer.",
      "auth": "actor_or_api_key",
      "express": { "method": "GET", "path": "/api/metrics" },
      "input_schema": { "type": "object", "properties": {} }
    },
    {
      "name": "list_ticket_recommendations",
