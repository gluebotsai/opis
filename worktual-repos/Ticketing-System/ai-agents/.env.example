# OpenAI-compatible LLM
MODEL_NAME=worktual-gemma
MODEL_URL=https://YOUR_LLM_HOST/v1
API_KEY=empty
MODEL_TEMPERATURE=0.2

# Postgres (same DB as the ticketing app) — set DATABASE_URL (repo-root .env is also loaded)
# DATABASE_URL=postgresql://USER:PASS@HOST:5432/DATABASE_NAME

# Shared with Express (X-Coworker-Tasks-Key + MCP execution JWT). Prefer setting this
# ONLY in the repo-root .env so Express and agents always match. If you set it here,
# it must be identical to ui-backend / root .env — a mismatch causes confirm/writes to
# fail with TOOL_NOT_ALLOWED "Invalid MCP token signature".
# COWORKER_TASKS_SECRET=change-me-tasks-secret

# Domain tools: express (default) or mcp
# TOOLS_TRANSPORT=express
# MCP_SERVER_URL=http://127.0.0.1:8020
# EXPRESS_BASE_URL=http://127.0.0.1:3001
# CONVERSATION_CONTEXT_VIA_API=1
# AGENT_DATA_VIA_API=1
# PROACTIVE_VIA_API=1

# Optional CORS (comma-separated). Defaults to SPA origin :5173.
# CORS_ORIGINS=https://rebuild-ticketing.worktual.com,http://127.0.0.1:5173

# Semantic metrics gateway (NL metrics for chat + TIAA/RCAA).
# Passes organization_id from the logged-in company per request (not a static env id).
# Use for metric *values* (counts, CSAT, SLA %). Not for narrative “why”.
# SEMANTIC_LAYER_URL=http://82.113.92.44:8800
# SEMANTIC_LAYER_PRODUCT=ticketing
# SEMANTIC_LAYER_TIMEOUT=30

# Ontology knowledge-graph SSE chat (narrative why / drivers). Not for exact KPI numbers.
# Passes organization_id from the logged-in company per request (not a static env id).
# ONTOLOGY_CHAT_URL=http://82.113.92.44:8000
# ONTOLOGY_CHAT_TIMEOUT=90

# Hub A2A remainder (prefer root .env). Ticketing → Hub leftovers only.
# HUB_A2A_URL=http://192.168.13.112:8030
# HUB_A2A_CLIENT_ID=worktual-ticketing-hub
# HUB_A2A_CLIENT_SECRET=change-me-hub-a2a-client-secret
# HUB_A2A_SERVER_NAME=worktual-hub
# HUB_A2A_SPOKE_LABEL=Ticketing System
# HUB_A2A_TIMEOUT=120

# Inbound A2A spoke (Hub → Ticketing). uvicorn app.a2a_main:app --port 8021
# Seed DB row: python scripts/seed_a2a_spoke_client.py
# A2A_PUBLIC_URL=http://192.168.13.42:8021
# A2A_SERVER_NAME=worktual-ticketing
# A2A_SPOKE_CLIENT_ID=worktual-hub-ticketing
# A2A_SPOKE_CLIENT_SECRET=change-me-ticketing-a2a-spoke-secret
# A2A_HUB_JWT_SECRET=change-me-ticketing-a2a-jwt-secret
# A2A_HUB_JWT_AUDIENCE=worktual-ticketing-a2a
# A2A_ACCESS_TOKEN_ISSUER=worktual-ticketing-a2a-access
# A2A_ACCESS_TOKEN_TTL_SECONDS=21600
# A2A_REFRESH_TOKEN_TTL_SECONDS=5184000
