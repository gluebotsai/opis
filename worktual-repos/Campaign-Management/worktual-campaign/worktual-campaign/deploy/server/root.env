# Docker Compose — copy to project root: cp deploy/server/root.env .env
# Public server: 82.113.92.49 (legacy note: 82.113.92.205 was an older host)

PUBLIC_APP_URL=https://rebuild-campaign.worktual.com

CRM_EMBED_ORIGINS=http://82.113.92.49:8080,http://82.113.92.205:8080,https://rebuild-campaign.worktual.com,https://rebuild-crm.worktual.com,http://192.168.13.159:5173,http://192.168.13.126:5173,http://192.168.13.126,http://localhost:5173,http://127.0.0.1:5173,https://cavalry-attention-unsecured.ngrok-free.dev

CRM_FRAME_ANCESTORS=http://82.113.92.49:8080 http://82.113.92.205:8080 https://rebuild-campaign.worktual.com https://rebuild-crm.worktual.com http://192.168.13.159:5173 http://192.168.13.126:5173 http://192.168.13.126 http://localhost:5173 http://127.0.0.1:5173 https://cavalry-attention-unsecured.ngrok-free.dev

NGINX_SERVER_NAME=_

# Set 1 on first deploy, then 0
RUN_DB_MIGRATE=1

# Host ports (DevOps / edge nginx)
WEB_PORT=8080
API_PORT=3001
SOCKET_PORT=3002
AGENTS_PORT=8005
# Publish agents on all interfaces so SFT can reach http://82.113.92.49:8005
# (catalog APIs). Prefer firewall allowlist; auth = INTERNAL_SERVICE_KEY.
AGENTS_HOST_BIND=0.0.0.0
