MAS_ENABLED_DOMAINS=all

INTERNAL_SERVICE_KEY=change-me-campaign-sft-internal-key

# --- Hub A2A (docker service `a2a`, nginx /a2a/ on :8080) ---
# Hub platform registers by IP (must match agent card url/tokenUrl after recreate a2a)
A2A_PUBLIC_URL=http://82.113.92.49:8080/a2a
A2A_HOST=0.0.0.0
A2A_PORT=8040
A2A_SERVER_NAME=worktual-campaign
A2A_SPOKE_CLIENT_ID=worktual-hub-campaign
# openssl rand -base64 32 — share with Hub; same value in accounts.a2a_spoke_clients
A2A_SPOKE_CLIENT_SECRET=change-me-on-server
# openssl rand -base64 48 — Campaign only
A2A_HUB_JWT_SECRET=change-me-campaign-a2a-jwt-secret-min-32-chars
A2A_HUB_JWT_AUDIENCE=worktual-campaign-a2a
A2A_ACCESS_TOKEN_ISSUER=worktual-campaign-a2a-access
# Same as backend/.env ACCOUNT_DATABASE_URL (required for token_store: db)
ACCOUNT_DATABASE_URL="postgresql://nlp:nLpTeam%40561@10.180.0.126:5432/worktual_bigint"
A2A_CAMPAIGN_API_TOKEN=
# Campaign → Hub escalate (Hub A2A on this host :8030)
HUB_A2A_URL=http://82.113.92.49:8030
HUB_A2A_TOKEN_URL=http://82.113.92.49:8030/token
HUB_A2A_SERVER_NAME=worktual-hub
HUB_A2A_CLIENT_ID=
HUB_A2A_CLIENT_SECRET=
