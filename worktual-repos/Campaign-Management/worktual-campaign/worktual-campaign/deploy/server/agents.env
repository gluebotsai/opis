# Template → agents/.env on server. See deploy/server/README.md (not a secret vault).
# Docker production host: 82.113.92.49 (Hub inbound IP; outbound NAT often 82.113.64.2)

AGENTS_HOST=0.0.0.0
AGENTS_PORT=8005

CORS_ORIGIN=http://82.113.92.49:8080,http://82.113.92.205:8080,https://rebuild-campaign.worktual.com,http://rebuild-campaign.worktual.com,http://localhost:5173,http://127.0.0.1:5173,http://192.168.11.31:5173,http://192.168.13.126:5173,http://192.168.13.126,https://cavalry-attention-unsecured.ngrok-free.dev

# MUST match backend/.env JWT_SECRET after install-env (do not leave change-me in production)
JWT_SECRET=change-me-in-production-campaign

CRM_JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
CRM_JWT_ISSUER=worktual-crm
CRM_JWT_USER_ID_CLAIM=sub
CRM_JWT_ALGORITHM=HS256

# Docker service name — not 127.0.0.1
CAMPAIGN_API_BASE=http://backend:3001/api

# Browser-reachable API host for gallery/upload media URLs in DB + email
CAMPAIGN_API_PUBLIC_BASE=https://rebuild-campaign-api.worktual.com
# Must match backend INTERNAL_SERVICE_KEY if CAMPAIGN_MEDIA_UPLOAD_ALLOW_INTERNAL=true
# INTERNAL_SERVICE_KEY is set below for SFT — reuse the same value on backend when enabling internal media fallback.

LLM_API_KEY=dummy
LLM_MODEL=worktual-qwen-27B
LLM_BASE_URL=http://81.17.61.149:8066/v1

KB_ENABLED=true
KB_RETRIEVE_URL=http://173.234.75.165:8080/retrieve
KB_SALES_DOMAIN_ID=worktual_sales_may11
KB_SERVICE_DOMAIN_ID=worktual_service_kb

DATA_DIR=/data

SEMANTIC_LAYER_GATEWAY_URL=http://82.113.92.44:8800
SEMANTIC_LAYER_PRODUCT=campaign
SEMANTIC_LAYER_TIMEOUT_S=30

ONTOLOGY_CHAT_STREAM_URL=http://82.113.92.44:8000/chat/stream
