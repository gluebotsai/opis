# REQUIRED — campaign email send (chat launch, on-demand, Personalised CRM, worker).
# Copy values from your My Accounts / local backend/.env after install-env.sh.
# SMTP-only mailboxes still need MS_TOKEN_ENCRYPTION_KEY to decrypt credentials.
MS_TOKEN_ENCRYPTION_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Microsoft OAuth mailboxes only:
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=

PERSONALIZATION_ADAPTER=fixture

# Optional: set 1 in root .env RUN_DB_MIGRATE instead; entrypoint reads this too
RUN_DB_MIGRATE=0
