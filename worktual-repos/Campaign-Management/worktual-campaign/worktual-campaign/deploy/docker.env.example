# Copy to project root as `.env` for docker compose variable substitution:
#   cp deploy/docker.env.example .env
#
# Service secrets still live in backend/.env and agents/.env (env_file).

# Public site URL (no trailing slash) — baked into frontend at build time
PUBLIC_APP_URL=https://campaign.example.com

# CRM origins allowed to iframe Campaign (comma-separated, no spaces required)
CRM_EMBED_ORIGINS=https://crm.example.com

# nginx server_name ('_' accepts any host)
NGINX_SERVER_NAME=_

# Space-separated origins for nginx CSP frame-ancestors (CRM iframe)
CRM_FRAME_ANCESTORS=https://crm.example.com https://campaign.example.com

# Set 1 on first deploy (or run migrate manually), then 0
RUN_DB_MIGRATE=0

# Optional: host port mapping (separate external ports for DevOps)
WEB_PORT=8080
API_PORT=3001
SOCKET_PORT=3002
AGENTS_PORT=8005
# 127.0.0.1 = local only (default). 0.0.0.0 = host-reachable for SFT catalog
# (firewall-restrict; requires INTERNAL_SERVICE_KEY on /internal/v1/agents*).
AGENTS_HOST_BIND=127.0.0.1
A2A_PORT=8040

# Hub registration — must match agents/.env A2A_PUBLIC_URL (nginx path /a2a/)
# Example: https://campaign.example.com/a2a
