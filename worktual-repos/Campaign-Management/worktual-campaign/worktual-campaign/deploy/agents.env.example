# Copy and edit before first run:
#   cp backend/.env.example backend/.env
#   cp agents/.env.example agents/.env
#
# Docker-specific overrides for agents/.env:
#   CAMPAIGN_API_BASE=http://backend:3001/api
#   REDIS_URL=redis://redis:6379   (in backend/.env)

AGENTS_HOST=0.0.0.0
AGENTS_PORT=8005

JWT_SECRET=change-me-in-production-campaign

# Reachable from the agents container (Docker service name)
CAMPAIGN_API_BASE=http://backend:3001/api

# Public browser-reachable API host — gallery images stored with this origin (not 127.0.0.1)
CAMPAIGN_API_PUBLIC_BASE=https://campaign.example.com

# Match PUBLIC_APP_URL from deploy/docker.env.example
CORS_ORIGIN=https://campaign.example.com

DATA_DIR=/data

# Optional QA lab only — templates use KB/user/form https URLs.
# WEB_TRACKING_LANDING_URL=

LLM_API_KEY=dummy
# LLM_MODEL=gpt-oss-120b
# LLM_BASE_URL=http://173.234.75.166:8003/v1
# LLM_MODEL=worktual-gemma-cx
# LLM_BASE_URL=http://81.17.61.149:8060/v1
LLM_MODEL=worktual-qwen-27B
LLM_BASE_URL=http://81.17.61.149:8066/v1

KB_ENABLED=true
KB_RETRIEVE_URL=http://173.234.75.165:8080/retrieve
KB_SALES_DOMAIN_ID=worktual_sales_may11
KB_SERVICE_DOMAIN_ID=worktual_service_kb

# MAS — production default all domains (override to empty for legacy-only)
MAS_ENABLED_DOMAINS=all
MAS_CREATE_CAMPAIGN_NATIVE=true
MAS_AUDIENCE_NATIVE=true

# SFT agent catalog — GET /internal/v1/agents* (fail closed when empty)
INTERNAL_SERVICE_KEY=change-me-campaign-sft-internal-key

# --- A2A spoke (Hub ↔ Campaign) — required for docker service `a2a` ---
# Docker: public URL via web nginx (no trailing slash)
# A2A_PUBLIC_URL=https://campaign.example.com/a2a
A2A_PUBLIC_URL=https://campaign.example.com/a2a
A2A_HOST=0.0.0.0
A2A_PORT=8040
A2A_SERVER_NAME=worktual-campaign
A2A_SPOKE_CLIENT_ID=worktual-hub-campaign
A2A_SPOKE_CLIENT_SECRET=change-me-hub-to-campaign-client-secret
A2A_HUB_JWT_SECRET=change-me-campaign-a2a-jwt-secret-min-32-chars
A2A_HUB_JWT_AUDIENCE=worktual-campaign-a2a
A2A_ACCESS_TOKEN_ISSUER=worktual-campaign-a2a-access
# Same as backend ACCOUNT_DATABASE_URL (token store + org JWT mint)
ACCOUNT_DATABASE_URL=
A2A_CAMPAIGN_API_TOKEN=
HUB_A2A_URL=
HUB_A2A_TOKEN_URL=
HUB_A2A_SERVER_NAME=worktual-hub
HUB_A2A_CLIENT_ID=
HUB_A2A_CLIENT_SECRET=
HUB_A2A_SPOKE_LABEL=Campaign
HUB_A2A_TIMEOUT_S=300
GEMINI_API_KEY=
