# nginx template — envsubst replaces ${VAR} at container start (nginx:alpine)
# Set NGINX_SERVER_NAME, CRM_FRAME_ANCESTORS in docker-compose / .env

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen 80;
  server_name ${NGINX_SERVER_NAME};

  client_max_body_size 12m;

  root /usr/share/nginx/html;
  index index.html;

  # CRM iframe embed — match frontend/vite.config.ts frame-ancestors
  add_header Content-Security-Policy "frame-ancestors 'self' ${CRM_FRAME_ANCESTORS}" always;

  location /api/ {
    proxy_pass http://backend:3001/api/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /health {
    proxy_pass http://backend:3001/health;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
  }

  location /docs {
    proxy_pass http://backend:3001/docs;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
  }

  location /docs/ {
    proxy_pass http://backend:3001/docs/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
  }

  # Campaign backend Socket.IO — dedicated port 3002 (host publish / DevOps)
  location /socket-io/ {
    proxy_pass http://backend:3002/socket-io/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 86400;
  }

  # Agents Socket.IO — public path without dots; map prefix → agents /socket-io/
  # Hub → Campaign A2A spoke (agent card, /token, JSON-RPC). Set A2A_PUBLIC_URL=https://<host>/a2a
  location /a2a/ {
    proxy_pass http://a2a:8040/a2a/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 300s;
  }

  location /agents-socket/ {
    proxy_pass http://agents:8005/socket-io/;
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 86400;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
