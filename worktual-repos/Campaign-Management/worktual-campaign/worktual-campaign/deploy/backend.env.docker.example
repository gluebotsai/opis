# Copy and edit before first run:
#   cp backend/.env.example backend/.env
#
# Docker-specific overrides for backend/.env:
#   REDIS_URL=redis://redis:6379
#   HOST=0.0.0.0
#   NODE_ENV=production
#   CORS_ORIGIN / NEXT_PUBLIC_APP_URL → UI host (e.g. https://rebuild-campaign.worktual.com)
#   API_PUBLIC_URL → public API host for email open/click pixels
#     (prefer https://rebuild-campaign-api.worktual.com when UI/API are split)

NODE_ENV=production
HOST=0.0.0.0
PORT=3001
SOCKET_PORT=3002

REDIS_URL=redis://redis:6379

# First deploy only — or run: docker compose run --rm backend npx prisma migrate deploy
RUN_DB_MIGRATE=0
