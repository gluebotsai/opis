# Create-campaign agents (Socket.IO + LangGraph)
AGENTS_HOST=0.0.0.0
AGENTS_PORT=8005
CORS_ORIGIN=http://localhost:5173

# Same JWT secret as campaign backend
JWT_SECRET=change-me-in-production-campaign

# CRM embed JWT (same values as campaign backend CRM_JWT_*)
CRM_JWT_ACCESS_SECRET=
CRM_JWT_ISSUER=worktual-crm
CRM_JWT_USER_ID_CLAIM=sub
CRM_JWT_ALGORITHM=HS256

# Node campaign API (tools call this with the user JWT)
CAMPAIGN_API_BASE=http://127.0.0.1:3001/api

# Browser-reachable API base for chat download links + media URLs.
# Prefer .../api so temporary sheet resolves to /api/public/temporary-contact-template.csv
# LAN example: http://192.168.13.91:3001/api
CAMPAIGN_API_PUBLIC_BASE=
# Dev only (with scripts/dev-lan.sh) — upload + preview media on LAN API. Never in production.
# MEDIA_ALLOW_LOCAL_PUBLISH=true
# LAN → rebuild media disk (bypass nginx). Same values as backend.
# MEDIA_PUBLIC_DIRECT_ORIGIN=http://82.113.92.49:3001
# MEDIA_PUBLIC_HOST_HEADER=rebuild-campaign-api.worktual.com

# OpenAI-compatible LLM gateway
LLM_API_KEY=dummy
# LLM_MODEL=gpt-oss-120b
# LLM_BASE_URL=http://173.234.75.166:8003/v1
# LLM_MODEL=worktual-gemma-cx
# LLM_BASE_URL=http://81.17.61.149:8060/v1
LLM_MODEL=worktual-qwen-27B
LLM_BASE_URL=http://81.17.61.149:8066/v1

# Full LLM request/response + tool call/result blocks (agents/logs/llm_io.log)
LLM_IO_LOG=1
# LLM_IO_LOG_PATH=/tmp/campaign-llm-io.log
# Chat story in Docker stdout: grep TURN  (ASK / TOOLS / CHAT TO USER)

# Knowledge — Enterprise Context Layer (POST /search). Do not call Meili directly.
KB_ENABLED=true
CONTEXT_LAYER_URL=http://82.113.92.47:7051
CONTEXT_LAYER_TIMEOUT_S=12
# Local: http://127.0.0.1:7051
# Legacy retrieve (unused when CONTEXT_LAYER_URL is set)
KB_RETRIEVE_URL=http://173.234.75.165:8080/retrieve
KB_SALES_DOMAIN_ID=worktual_sales_may11
KB_SERVICE_DOMAIN_ID=worktual_service_kb

# Chat NL analytics — semantic layer (Campaign product)
# POST {SEMANTIC_LAYER_GATEWAY_URL}/ask  body: query, organization_id, product
SEMANTIC_LAYER_GATEWAY_URL=http://82.113.92.44:8800
SEMANTIC_LAYER_PRODUCT=campaign
SEMANTIC_LAYER_TIMEOUT_S=30

# Ontology knowledge graph (Past Analyst) — POST chat/stream
# body: sessionID, query, organization_id
ONTOLOGY_CHAT_STREAM_URL=http://82.113.92.44:8000/chat/stream
ONTOLOGY_CHAT_TIMEOUT_S=90

# Session + chat persistence (JSON files under this dir)
DATA_DIR=./data

# Optional QA lab only — templates use KB/user/form https URLs, not this host.
# WEB_TRACKING_LANDING_URL=

# --- A2A spoke (Hub ↔ Campaign) ---
# Public URL Hub can reach (LAN IP). Local: starts with `python -m app.main` (A2A_AUTOSTART=1).
# Docker: separate compose service `a2a` — set A2A_AUTOSTART=0 on the agents container.
A2A_AUTOSTART=1
A2A_PUBLIC_URL=http://192.168.11.31:8040
A2A_HOST=0.0.0.0
A2A_PORT=8040
A2A_SERVER_NAME=worktual-campaign
# Hub → Campaign client (Campaign-only; do not reuse worktual-hub-crm)
A2A_SPOKE_CLIENT_ID=worktual-hub-campaign
A2A_SPOKE_CLIENT_SECRET=MA7fdPQALkoFmS3GMFadDAxvVKfAX45C_HoAqlhlkxE
# Signs Campaign access JWTs (do NOT share with Hub)
A2A_HUB_JWT_SECRET=change-me-campaign-a2a-jwt-secret
A2A_HUB_JWT_AUDIENCE=worktual-campaign-a2a
A2A_ACCESS_TOKEN_ISSUER=worktual-campaign-a2a-access
A2A_ACCESS_TOKEN_TTL_SECONDS=21600
A2A_REFRESH_TOKEN_TTL_SECONDS=5184000
# Shared accounts DB for a2a_spoke_clients (required for Hub SELECT of access_token)
# Same URL as campaign backend ACCOUNT_DATABASE_URL
ACCOUNT_DATABASE_URL="postgresql://nlp:CHANGE_ME@10.180.0.126:5432/worktual_bigint"
# Campaign API Bearer for skill execution (optional).
# Hub does NOT need to send campaignToken — A2A mints a SPA JWT from
# organizationId using JWT_SECRET + ACCOUNT_DATABASE_URL (same as backend).
# Set this only as a static override if minting is unavailable.
A2A_CAMPAIGN_API_TOKEN=

# Campaign → Hub (Hub A2A server credentials)
HUB_A2A_URL=http://192.168.13.112:8030
HUB_A2A_TOKEN_URL=http://192.168.13.112:8030/token
HUB_A2A_SERVER_NAME=worktual-hub
HUB_A2A_CLIENT_ID=worktual-crm-hub
HUB_A2A_CLIENT_SECRET=CdLdHlb-qM-TXj0W_oWbOKWIZsBf2mcMd4IkFNCf2t4
HUB_A2A_SPOKE_LABEL=Campaign
HUB_A2A_TIMEOUT_S=120

# MAS — production default in config is "all". Override to empty for legacy-only.
MAS_ENABLED_DOMAINS=all

# SFT agent catalog — GET /internal/v1/agents* (fail closed when empty)
INTERNAL_SERVICE_KEY=change-me-campaign-sft-internal-key

# My Accounts — App/Web push credentials (never persist FCM/APNs/VAPID in Campaign)
# ACCOUNTS_API_BASE_URL=https://staging-onboarding.worktual.com
# PRODUCT_MCP_CONNECTORS_TOKEN=
# Native create-campaign executors (bounded tools per executor). False = legacy monolith wrappers.
MAS_CREATE_CAMPAIGN_NATIVE=true
# Native Audience CRM executors (bounded tools per executor). False = legacy coordinator.
MAS_AUDIENCE_NATIVE=true
# Native Optimization executors (monitoring / analytics / recovery).
MAS_OPTIMIZATION_NATIVE=true
# Native Content executors (channels / WA approved-rejected / coach).
MAS_CONTENT_NATIVE=true
# Native Forms executors (theme / fields / design).
MAS_FORMS_NATIVE=true
# Native Image executors (generate / refine / attach) — enhance before Gemini API.
MAS_IMAGE_NATIVE=true

# Edit space: 1 = new per-channel LLM+tools specialists (no regex intent).
# 0 = legacy compose_edit / select_edit_skill. Flip after verifying locally.
# EDIT_SPACE_UNIFIED_AGENT=1

# Template Generation Director — design-then-content for email (Phase 1)
TEMPLATE_DIRECTOR_ENABLED=true
# Phase 2 email compose plugin (create + regenerate). false = old director path.
PHASE2_EMAIL_COMPOSE_ENABLED=false
# Cross-campaign layout rotation — needs backend GET /channel-templates/recent
TEMPLATE_ORG_FINGERPRINTS_ENABLED=false

# Gemini image generation — required for template hero / campaign AI images
# GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
# Optional: blue dev placeholder when GEMINI_API_KEY is unset (default: generation fails)
# GEMINI_IMAGE_ALLOW_DEV_STUB=false

