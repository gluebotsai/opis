{
  "name": "worktual-campaign-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --exclude '../node_modules/**' --exclude 'node_modules/**' src/index.ts",
    "predev": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json && mkdir -p dist/dao/data dist/modules/web-push/sdk && cp -r src/dao/data/. dist/dao/data/ && cp -r src/modules/web-push/sdk/. dist/modules/web-push/sdk/",
    "start": "node dist/index.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "daily-report:send": "tsx scripts/send-daily-report.ts",
    "daily-report:test": "tsx scripts/test-daily-report.ts",
    "gallery:test": "tsx scripts/test-gallery-metadata.ts",
    "gallery:bootstrap": "tsx scripts/test-gallery-bootstrap.ts",
    "gallery:repair-media": "tsx scripts/repair-gallery-localhost-urls.ts",
    "gallery:idempotency": "tsx scripts/test-gallery-idempotency.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/jwt": "^9.1.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.2",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.4.0",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.6.1",
    "pg": "^8.22.0",
    "socket.io": "^4.8.1",
    "web-push": "^3.6.7",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/web-push": "^3.6.4",
    "prisma": "^6.19.3",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
