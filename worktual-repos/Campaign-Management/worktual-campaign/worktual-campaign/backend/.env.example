# Shared Worktual DB (accounts + cdp + campaign schemas)
# ACCOUNT_DATABASE_URL: accounts.setup_users (read), cdp.contacts (CRUD on existing columns)
# DATABASE_URL / CAMPAIGN_DATABASE_URL: campaign schema (Prisma)
ACCOUNT_DATABASE_URL="postgresql://nlp:CHANGE_ME@10.180.0.126:5432/worktual_bigint"
CAMPAIGN_DATABASE_URL="postgresql://nlp:CHANGE_ME@10.180.0.126:5432/worktual_bigint?schema=campaign"
DATABASE_URL="postgresql://nlp:CHANGE_ME@10.180.0.126:5432/worktual_bigint?schema=campaign"

JWT_SECRET="change-me-in-production-campaign"
SESSION_SECRET="change-me-in-production-campaign"
JWT_EXPIRES_IN="7d"

# Worktual CRM access JWT (Path A — campaign routes only; separate from JWT_SECRET above)
# Ask CRM team for issuer + JWT_ACCESS_SECRET (or set CRM_JWT_ACCESS_SECRET here).
# CRM_JWT_ACCESS_SECRET=""
# CRM_JWT_ISSUER="worktual-crm"
# CRM_JWT_USER_ID_CLAIM="sub"
# CRM_JWT_ALGORITHM="HS256"
# CRM monitor/agent Personalised CRM (M2M) — not a JWT. Header: X-Crm-Integration-Key
# CRM_INTEGRATION_KEY=""
# Tenant = accounts.setup_users.organization_id (no static DEFAULT_TENANT_ID)
# Optional for local prisma seed only:
# DEFAULT_TENANT_ID="00000000-0000-4000-8000-000000000001"
PORT=3001
SOCKET_PORT=3002
HOST=0.0.0.0
# Fastify: warn+errors only (no per-request access logs). Set LOG_LEVEL=info to restore request logs.
# Hub on-demand template prepare (A2A spoke). Docker sets http://a2a:8040 via compose.
AGENTS_PREPARE_URL=http://127.0.0.1:8040
# Chat / gallery agents (optional; defaults to http://127.0.0.1:8005)
# AGENTS_INTERNAL_URL=http://127.0.0.1:8005
CORS_ORIGIN="http://localhost:5173,http://localhost:5500"
REDIS_URL="redis://127.0.0.1:6379"
NEXT_PUBLIC_APP_URL="http://localhost:5173"
# Public API URL — email open/click tracking pixels + mailbox verify links.
# MUST be internet-reachable HTTPS in production (Gmail cannot load localhost / LAN IPs).
# Split DNS: use the API host, e.g. https://rebuild-campaign-api.worktual.com
# Single host: same origin as the SPA is fine if /api/ is proxied there.
# Local: ngrok http 3001 → paste that https URL here.
# LAN dev (scripts/dev-lan.sh): sets API_PUBLIC_URL to http://<lan-ip>:3001 automatically.
API_PUBLIC_URL="http://localhost:3001"
# Dev only — store template images on this API without forward to rebuild (never set in production).
# MEDIA_ALLOW_LOCAL_PUBLISH=true
# LAN dev: publish uploads to rebuild disk (bypass nginx 502 on large JSON)
# MEDIA_PUBLIC_DIRECT_ORIGIN=http://82.113.92.49:3001
# MEDIA_PUBLIC_HOST_HEADER=rebuild-campaign-api.worktual.com

# Optional QA lab only. Live clicks stamp wt= onto the template destination URL.
# WEB_TRACKING_LANDING_URL=
WEB_TRACKING_HMAC_SECRET="change-me-web-tracking-hmac-secret-min-32-chars"

# Campaign + daily-report + sender-verify outbound mail: My Accounts mailbox only.
# Do not set ESP_PROVIDER, RESEND_API_KEY, ESP_VERIFY_FROM, or WORKTUAL_EMAIL_FROM.
EMAIL_WORKER_INTERVAL_MS=15000

# Daily campaign report (sent from the org Accounts mailbox)
DAILY_REPORT_ENABLED=true
DAILY_REPORT_WORKER_INTERVAL_MS=900000

# Phase 2 — My Accounts mailbox decrypt + optional OAuth refresh
# MS_TOKEN_ENCRYPTION_KEY must match My Accounts Setup Workspace
MS_TOKEN_ENCRYPTION_KEY="503eb755fde930c276de9baa62911ea5f7cf61fa4b93de8c4b1026b9850390fe"

GOOGLE_OAUTH_CLIENT_ID=714138144506-qnqqagcfag10am1ifle7dcnn6frpdgsl.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=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

# Microsoft OAuth mailboxes only (Outlook / M365):
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
# ACCOUNTS_EMAIL_RATE_PER_MINUTE=8
# ACCOUNTS_EMAIL_FAIL_RATE_PAUSE=0.15

# WhatsApp social-service (template submit / status / send)
# QA:     https://rebuild-ccaas-api.worktual.com/social-api
# ngrok:  https://uninvited-skinless-eel.ngrok-free.dev  (+ SOCIAL_SERVICE_NGROK_SKIP=true)
# Local:  http://localhost:3004
# Paths after base: /internal/v1/whatsapp/templates…
SOCIAL_SERVICE_BASE_URL="https://rebuild-ccaas-api.worktual.com/social-api"
# Must match rebuild CCaaS social-api (see deploy/server/backend.env).
INTERNAL_SERVICE_KEY="dev-internal-key"

# My Accounts Setup → Channel Setup (App Push / Web Push credentials).
# Empty = Campaign uses local push_channel_settings (legacy). Do not copy secrets into Campaign DB.
ACCOUNTS_API_BASE_URL="https://staging-onboarding.worktual.com"
# PRODUCT_MCP_CONNECTORS_TOKEN=""
# If PRODUCT_MCP_CONNECTORS_TOKEN is empty, Campaign sends x-internal-service-key (must match Accounts).
# My Accounts frontend: VITE_CAMPAIGN_WEB_PUSH_SDK_URL={API_PUBLIC_URL}/api/sdk/web-push.js
# Set true only when calling through ngrok free tier
SOCIAL_SERVICE_NGROK_SKIP=false
# Optional fallback when org has no Accounts WhatsApp row. Booxoo org uses DB id 1063.
# WHATSAPP_CHANNEL_CONFIG_ID="1063"
# Poll Meta only while templates are pending (5 min). No Meta call if none pending.
WHATSAPP_STATUS_POLL_INTERVAL_MS=1800000
WHATSAPP_WORKER_INTERVAL_MS=15000
# Future approved-template sends only (default 30 minutes). Does not change WHATSAPP_WORKER_INTERVAL_MS.
APPROVED_TEMPLATE_POLL_INTERVAL_MS=1800000

# Dynamic send personalization (pluggable per-recipient offers)
# fixture = demo JSON offers (different products per contact_id)
# noop = identity-only merge (prod-safe)
# When unset: fixture if NODE_ENV!=production, else noop
# PERSONALIZATION_ADAPTER=fixture
# PERSONALIZATION_ADAPTER=noop
