# Frontend talks to API via Vite proxy in dev (/api → :3001)
VITE_API_BASE_URL=/api
VITE_SOCKET_URL=
# Do NOT set VITE_AGENTS_URL for LAN dev — leave unset so Socket.IO uses /agents-socket proxy.
# VITE_AGENTS_URL=http://192.168.x.x:8005
# Temp header industry switcher (1 = show Generic B2B / Finance dropdown)
VITE_DEV_INDUSTRY_SWITCHER=
# LAN form links — run `npm run dev:lan` to auto-detect system IP
VITE_PUBLIC_APP_URL=
# CRM iframe parent origins (postMessage + frame-ancestors), comma-separated
# VITE_CRM_EMBED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
