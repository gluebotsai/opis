    {
      "name": "ask_semantic_layer",
      "description": "Certified KPI numbers via POST /v1/semantic/query. Read every slice metric and dimension, then pass the best-fit metrics[] ids — never the user sentence and never a weakly related first row. Optional group_by only for a requested break-down, filters [{dimension, op, value|values}], order_by, time only if they named a window, limit, dataScope org|mine. Runtime fills organizationId, userId, product, agent. Values only — not why. Combined value+why: also call ask_knowledge_graph.",
      "auth": "actor_or_api_key",
      "input_schema": {
        "type": "object",
        "properties": {
          "metrics": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "group_by": {
            "type": "array",
            "items": { "type": "string" }
          },
          "filters": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "dimension": { "type": "string" },
                "op": { "type": "string" },
                "value": {},
                "values": { "type": "array" }
              },
              "required": ["dimension"]
            }
          },
          "time": {
            "type": "object",
            "properties": {
              "period": { "type": "string" },
              "start": { "type": "string" },
              "end": { "type": "string" },
              "grain": { "type": "string" }
            }
          },
          "limit": { "type": "integer" },
          "dataScope": { "type": "string", "enum": ["org", "mine"] },
          "order_by": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["metrics"]
      }
    },
    {
      "name": "ask_sql_layer",
      "description": "List/search ticket rows via POST /v1/sql/query. Required instruction (one English sentence). Recommended entityHint wt:Ticket. Optional filters [{dimension, op, value|values}] and limit. Runtime fills organizationId, userId, originProduct, originAgent. No SQL, no table names, no empty args. Success with rows=[] is zero tickets — do not also call list_tickets. list_tickets only if this tool fails. Not for how-many/CSAT/SLA %.",
      "auth": "actor_or_api_key",
      "input_schema": {
        "type": "object",
        "properties": {
          "instruction": { "type": "string" },
          "entityHint": { "type": "string" },
          "entity_hint": { "type": "string" },
          "filters": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "dimension": { "type": "string" },
                "op": { "type": "string" },
                "value": {},
                "values": { "type": "array" }
              },
              "required": ["dimension"]
            }
          },
          "limit": { "type": "integer" }
        },
        "required": ["instruction"]
      }
    },
