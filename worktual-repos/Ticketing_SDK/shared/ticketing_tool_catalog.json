{
  "schema_version": "1.0",
  "namespace": "ticketing.v1",
  "tools": [
    {
      "name": "get_ticket",
      "description": "Get one ticket by ticket_number (e.g. 12345 or #12345).",
      "auth": "actor_or_api_key",
      "express": { "method": "GET", "path": "/api/tickets/{ticket_number}" },
      "input_schema": {
        "type": "object",
        "properties": {
          "ticket_number": { "type": "string" }
        },
        "required": ["ticket_number"]
      }
    },
    {
      "name": "list_tickets",
      "description": "List or search tickets using structured, actor-scoped filters.",
      "auth": "actor_or_api_key",
      "express": { "method": "GET", "path": "/api/tickets" },
      "input_schema": {
        "type": "object",
        "properties": {
          "scope": { "type": "string", "enum": ["default", "assignee", "team", "org", "search", "created", "unassigned"] },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "description": "Page size. Default 12 for chat lists." },
          "offset": { "type": "integer", "minimum": 0, "description": "Skip this many rows for the next page." },
          "created_by": { "type": "string", "enum": ["SELF"] },
          "assigned_to": { "type": "string" },
          "status": { "type": "string" },
          "priority": { "type": "string" },
          "channel": { "type": "string" },
          "query": { "type": "string", "maxLength": 200 },
          "queue": { "type": "string" },
          "customer": { "type": "string" },
          "due": { "type": "string", "enum": ["today", "overdue"] },
          "created_range": {
            "type": "string",
            "description": "Created-at window. Presets: today, yesterday, this_week, last_week, this_month, last_month, last_24h, last_7d, last_30d. Aliases like past_month map to last_30d. Or ISO YYYY-MM-DD or YYYY-MM-DD/YYYY-MM-DD from trusted now."
          },
          "updated_range": {
            "type": "string",
            "description": "Updated-at window. Same presets/aliases/ISO windows as created_range."
          },
          "sort": { "type": "string", "enum": ["latest", "oldest", "priority", "due"] }
        }
      }
    },
    {
      "name": "get_ticket_progress",
      "description": "Get ticket progress stepper and status history.",
      "auth": "actor_or_api_key",
      "express": { "method": "GET", "path": "/api/tickets/{ticket_number}/progress" },
      "input_schema": {
        "type": "object",
        "properties": {
          "ticket_number": { "type": "string" }
        },
        "required": ["ticket_number"]
      }
    },
    {
      "name": "list_ticket_notes",
      "description": "List recent notes for one ticket.",
      "auth": "actor_or_api_key",
      "express": { "method": "GET", "path": "/api/tickets/{ticket_number}/notes" },
      "input_schema": {
        "type": "object",
        "properties": { "ticket_number": { "type": "string" } },
        "required": ["ticket_number"]
      }
    },
    {
      "name": "get_triage_stats",
      "description": "Agent/admin triage cards: created by me, reassigned out, open on my teams.",
      "auth": "actor_or_api_key",
      "express": { "method": "GET", "path": "/api/agent/triage-stats" },
      "input_schema": { "type": "object", "properties": {} }
    },
    {
      "name": "get_dashboard_chart",
      "description": "Dashboard workload chart series for a time range.",
      "auth": "actor_or_api_key",
      "express": { "method": "GET", "path": "/api/dashboard/chart" },
      "input_schema": {
        "type": "object",
        "properties": {
          "chart_range": { "type": "string", "enum": ["24hours", "7days", "30days"] }
        }
      }
    },
    {
      "name": "list_activities",
      "description": "Recent Home dashboard activity rows.",
      "auth": "actor_or_api_key",
      "express": { "method": "GET", "path": "/api/activities" },
      "input_schema": { "type": "object", "properties": {} }
    },
    {
      "name": "create_ticket",
      "description": "Create a ticket (customerName and/or subject required).",
      "auth": "actor_or_api_key",
      "express": { "method": "POST", "path": "/api/tickets" },
      "input_schema": {
        "type": "object",
        "properties": {
          "customerName": { "type": "string" },
          "customerId": { "type": "string" },
          "customerEmail": { "type": "string" },
          "customerPhone": { "type": "string" },
          "subject": { "type": "string" },
          "description": { "type": "string" },
          "channel": { "type": "string" },
          "priority": { "type": "string" },
          "status": { "type": "string" },
          "queue": { "type": "string" },
          "category": { "type": "string" },
          "skill": { "type": "string" },
          "assigneeId": { "type": "string" },
          "resolverId": { "type": "string" },
          "queueId": { "type": "string" },
          "orderId": { "type": "string" },
          "productId": { "type": "string" },
          "references": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": { "type": "string" },
                "id": { "type": "string" }
              }
            }
          }
        }
      }
    },
    {
      "name": "enrich_ticket",
      "description": "Preview authoritative ticket triage and assignment before confirmation.",
      "auth": "actor_or_api_key",
      "express": { "method": "POST", "path": "/api/tickets/enrich" },
      "input_schema": {
        "type": "object",
        "properties": {
          "customerName": { "type": "string" },
          "customerEmail": { "type": "string" },
          "customerPhone": { "type": "string" },
          "issue": { "type": "string" }
        },
        "required": ["customerName", "issue"]
      }
    },
    {
      "name": "verify_ticket_customer",
      "description": "Check CDP/directory for email or phone during create-ticket before collecting the issue.",
      "auth": "actor_or_api_key",
      "input_schema": {
        "type": "object",
        "properties": {
          "customerName": { "type": "string" },
          "customerEmail": { "type": "string" },
          "customerPhone": { "type": "string" },
          "contact": { "type": "string" }
        }
      }
    },
    {
      "name": "update_ticket",
      "description": "Update ticket fields (status, priority, assignee, subject, …).",
      "auth": "actor_or_api_key",
      "express": { "method": "PUT", "path": "/api/tickets/{ticket_number}" },
      "input_schema": {
        "type": "object",
        "properties": {
          "ticket_number": { "type": "string" },
          "status": { "type": "string" },
          "priority": { "type": "string" },
          "assignee": { "type": "string" },
          "resolver": { "type": "string" },
          "subject": { "type": "string" },
          "description": { "type": "string" },
          "queue": { "type": "string" },
          "category": { "type": "string" },
          "ai_summary": { "type": "string" }
        },
        "required": ["ticket_number"]
      }
    },
    {
      "name": "escalate_ticket",
      "description": "Escalate a ticket; optional assignee/agent/rationale.",
      "auth": "actor_or_api_key",
      "express": { "method": "POST", "path": "/api/tickets/{ticket_number}/escalate" },
      "input_schema": {
        "type": "object",
        "properties": {
          "ticket_number": { "type": "string" },
          "assignee": { "type": "string" },
          "assignee_id": { "type": "string" },
          "agent": { "type": "string" },
          "agent_id": { "type": "string" },
          "rationale": { "type": "string" }
        },
        "required": ["ticket_number"]
      }
    },
    {
      "name": "auto_assign_ticket",
      "description": "Auto-assign a ticket via backend routing. Never invent the assignee.",
      "auth": "actor_or_api_key",
      "express": { "method": "POST", "path": "/api/tickets/{ticket_number}/auto-assign" },
      "input_schema": {
        "type": "object",
        "properties": {
          "ticket_number": { "type": "string" }
        },
        "required": ["ticket_number"]
      }
    },
    {
      "name": "add_ticket_note",
      "description": "Add a note to a ticket by ticket_number.",
      "auth": "actor_or_api_key",
      "express": { "method": "POST", "path": "/api/tickets/{ticket_number}/notes" },
      "input_schema": {
        "type": "object",
        "properties": {
          "ticket_number": { "type": "string" },
          "text": { "type": "string" },
          "visibility": { "type": "string", "enum": ["internal", "public"] },
          "send_customer_email": { "type": "boolean" }
        },
        "required": ["ticket_number", "text"]
      }
    },
    {
      "name": "list_queues",
      "description": "List teams. For the members of one team, set query to that team's name. For every team, set list_all true and omit query.",
      "auth": "actor_or_api_key",
      "express": { "method": "GET", "path": "/api/queues" },
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Team name when they want one team or its members. Omit when listing every team."
          },
          "list_all": {
            "type": "boolean",
            "description": "True only when they want every team. Do not set this when they named one team."
          }
        }
      }
    },
    {
      "name": "create_queue",
      "description": "Create a queue/team by name.",
      "auth": "actor_or_api_key",
      "express": { "method": "POST", "path": "/api/queues" },
      "input_schema": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "members": { "type": "array", "items": { "type": "string" } },
          "member_ids": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["name"]
      }
    },
    {
      "name": "update_queue",
      "description": "Update a queue/team (name, description, members). For adding people to an existing team, pass only the new staff in members/member_ids and set add_members=true so existing members are kept. Without add_members, members/member_ids replace the full roster.",
      "auth": "actor_or_api_key",
      "express": { "method": "PATCH", "path": "/api/queues/{queue_id}" },
      "input_schema": {
        "type": "object",
        "properties": {
          "queue_id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "members": { "type": "array", "items": { "type": "string" } },
          "member_ids": { "type": "array", "items": { "type": "string" } },
          "add_members": {
            "type": "boolean",
            "description": "When true, merge members/member_ids into the existing team roster instead of replacing it."
          }
        },
        "required": ["queue_id"]
      }
    },
    {
      "name": "delete_queue",
      "description": "Delete a queue/team by id.",
      "auth": "actor_or_api_key",
      "express": { "method": "DELETE", "path": "/api/queues/{queue_id}" },
      "input_schema": {
        "type": "object",
        "properties": { "queue_id": { "type": "string" } },
        "required": ["queue_id"]
      }
    },
    {
      "name": "resolve_ticket_person",
      "description": "List and rank live staff for ticket reassignment or escalation.",
      "auth": "actor_or_api_key",
      "express": { "method": "GET", "path": "/api/agents" },
      "input_schema": {
        "type": "object",
        "properties": {
          "response": { "type": "string" },
          "ticket_number": { "type": "string" },
          "target_role": { "type": "string", "enum": ["agent", "resolver", "admin"] },
          "user_query": { "type": "string" },
          "proceed": { "type": "integer", "minimum": 0, "maximum": 1 }
        }
      }
    },
    {
      "name": "list_kb",
      "description": "List knowledge base articles, 10 per page. First page: offset 0. Next page of the same list: offset from the prior TOOL RESULT nextOffset.",
      "auth": "actor_or_api_key",
      "express": { "method": "GET", "path": "/api/kb" },
      "input_schema": {
        "type": "object",
        "properties": {
          "query": { "type": "string" },
          "category": { "type": "string" },
          "status": { "type": "string" },
          "limit": { "type": "integer", "description": "Page size. Use 10." },
          "offset": { "type": "integer", "description": "0 for a new list. Next page uses the prior nextOffset." }
        }
      }
    },
    {
      "name": "search_kb",
      "description": "Retrieve the single best published knowledge article for how-to or troubleshooting. Uses the Meilisearch index. Quote the TOOL RESULT only. Use list_kb or get_kb to browse or open an article.",
      "auth": "actor_or_api_key",
      "express": { "method": "POST", "path": "/api/internal/kb/search" },
      "input_schema": {
        "type": "object",
        "properties": {
          "query": { "type": "string" }
        },
        "required": ["query"]
      }
    },
    {
      "name": "list_kb_categories",
      "description": "List category labels derived from live knowledge articles.",
      "auth": "actor_or_api_key",
      "express": { "method": "GET", "path": "/api/kb" },
      "input_schema": { "type": "object", "properties": {} }
    },
    {
      "name": "manage_kb_category",
      "description": "Validate and stage a knowledge category label, or list categories.",
      "auth": "actor_or_api_key",
      "input_schema": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "maxLength": 64 },
          "mode": { "type": "string", "enum": ["add", "list"] }
        },
        "required": ["name"]
      }
    },
    {
      "name": "export_kb",
      "description": "Export live knowledge articles as JSON, CSV, Markdown, text, PDF, or Word.",
      "auth": "actor_or_api_key",
      "express": { "method": "GET", "path": "/api/kb" },
      "input_schema": {
        "type": "object",
        "properties": {
          "fmt": { "type": "string", "enum": ["json", "csv", "md", "txt", "pdf", "doc"] },
          "category": { "type": "string" }
        }
      }
    },
    {
      "name": "import_kb_articles",
      "description": "Import knowledge articles from a JSON array.",
      "auth": "actor_or_api_key",
      "express": { "method": "POST", "path": "/api/kb" },
      "input_schema": {
        "type": "object",
        "properties": { "articles_json": { "type": "string" } },
        "required": ["articles_json"]
      }
    },
    {
      "name": "get_kb",
      "description": "Get one knowledge article by id.",
      "auth": "actor_or_api_key",
      "express": { "method": "GET", "path": "/api/kb/{article_id}" },
      "input_schema": {
        "type": "object",
        "properties": { "article_id": { "type": "string" } },
        "required": ["article_id"]
      }
    },
    {
      "name": "update_kb_article",
      "description": "Update a KB article (title, content, category, status).",
      "auth": "actor_or_api_key",
      "express": { "method": "PATCH", "path": "/api/kb/{article_id}" },
      "input_schema": {
        "type": "object",
        "properties": {
          "article_id": { "type": "string" },
          "title": { "type": "string" },
          "content": { "type": "string" },
          "category": { "type": "string" },
          "status": { "type": "string" }
        },
        "required": ["article_id"]
      }
    },
    {
      "name": "publish_kb_article",
      "description": "Publish a KB article by id.",
      "auth": "actor_or_api_key",
      "express": { "method": "PATCH", "path": "/api/kb/{article_id}" },
      "input_schema": {
        "type": "object",
        "properties": { "article_id": { "type": "string" } },
        "required": ["article_id"]
      }
    },
    {
      "name": "create_kb_article",
      "description": "Create and publish a KB article with title, content, category.",
      "auth": "actor_or_api_key",
      "express": { "method": "POST", "path": "/api/kb" },
      "input_schema": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "content": { "type": "string" },
          "category": { "type": "string" },
          "author": { "type": "string" }
        },
        "required": ["title", "content", "category"]
      }
    },
    {
      "name": "draft_kb_article",
      "description": "Save a KB article as a staff-only draft with title, content, category.",
      "auth": "actor_or_api_key",
      "express": { "method": "POST", "path": "/api/kb" },
      "input_schema": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "content": { "type": "string" },
          "category": { "type": "string" },
          "author": { "type": "string" }
        },
        "required": ["title", "content", "category"]
      }
    },
    {
      "name": "list_customers",
      "description": "List customers in the directory.",
      "auth": "actor_or_api_key",
      "express": { "method": "GET", "path": "/api/customers" },
      "input_schema": {
        "type": "object",
        "properties": {
          "query": { "type": "string" },
          "status": { "type": "string" },
          "exact_email": { "type": "string" },
          "exact_phone": { "type": "string" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
          "offset": { "type": "integer", "minimum": 0 }
        }
      }
    },
    {
      "name": "get_customer_360",
      "description": "Get customer ticket history and counts by email.",
      "auth": "actor_or_api_key",
      "express": { "method": "GET", "path": "/api/customers/360" },
      "input_schema": {
        "type": "object",
        "properties": { "email": { "type": "string" } },
        "required": ["email"]
      }
    },
    {
      "name": "import_customers",
      "description": "Import customers from CSV text. Do not invent rows.",
      "auth": "actor_or_api_key",
      "express": { "method": "POST", "path": "/api/customers/import" },
      "input_schema": {
        "type": "object",
        "properties": { "csv_text": { "type": "string" } },
        "required": ["csv_text"]
      }
    },
    {
      "name": "create_customer",
      "description": "Create a customer in the directory (admin). Same body as Customers form.",
      "auth": "actor_or_api_key",
      "express": { "method": "POST", "path": "/api/customers" },
      "input_schema": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "email": { "type": "string" },
          "phone": { "type": "string" },
          "accountName": { "type": "string" }
        },
        "required": ["name"]
      }
    },
    {
      "name": "list_macros",
      "description": "List macros. Optional q searches title/body in SQL.",
      "auth": "actor_or_api_key",
      "express": { "method": "GET", "path": "/api/macros" },
      "input_schema": {
        "type": "object",
        "properties": { "q": { "type": "string" } }
      }
    },
    {
      "name": "create_macro",
      "description": "Create a macro with title and body.",
      "auth": "actor_or_api_key",
      "express": { "method": "POST", "path": "/api/macros" },
      "input_schema": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "body": { "type": "string" }
        },
        "required": ["title", "body"]
      }
    },
    {
      "name": "update_macro",
      "description": "Patch a macro title and/or body.",
      "auth": "actor_or_api_key",
      "express": { "method": "PATCH", "path": "/api/macros/{macro_id}" },
      "input_schema": {
        "type": "object",
        "properties": {
          "macro_id": { "type": "string" },
          "title": { "type": "string" },
          "body": { "type": "string" }
        },
        "required": ["macro_id"]
      }
    },
    {
      "name": "delete_macro",
      "description": "Delete a macro by id.",
      "auth": "actor_or_api_key",
      "express": { "method": "DELETE", "path": "/api/macros/{macro_id}" },
      "input_schema": {
        "type": "object",
        "properties": { "macro_id": { "type": "string" } },
        "required": ["macro_id"]
      }
    },
    {
      "name": "list_agents",
      "description": "List assignable staff for the org.",
      "auth": "actor_or_api_key",
      "express": { "method": "GET", "path": "/api/agents" },
      "input_schema": { "type": "object", "properties": {} }
    },
    {
      "name": "list_priorities",
      "description": "List priority catalog entries.",
      "auth": "actor_or_api_key",
      "express": { "method": "GET", "path": "/api/priorities" },
      "input_schema": {
        "type": "object",
        "properties": { "include_inactive": { "type": "boolean" } }
      }
    },
    {
      "name": "create_priority",
      "description": "Create a priority (admin): display name + resolution hours (whole hours; sub-hour values store as 1h minimum). On user affirmation call with confirmed=true.",
      "auth": "actor_or_api_key",
      "express": { "method": "POST", "path": "/api/priorities" },
      "input_schema": {
        "type": "object",
        "properties": {
          "display_name": { "type": "string" },
          "displayName": { "type": "string" },
          "resolution_hours": { "type": "number" },
          "resolutionHours": { "type": "number" },
          "hours": { "type": "number" },
          "confirmed": { "type": "boolean" }
        }
      }
    },
    {
      "name": "update_priority",
      "description": "Patch priority display name, SLA hours, or active flag (admin).",
      "auth": "actor_or_api_key",
      "express": { "method": "PATCH", "path": "/api/priorities/{priority_id}" },
      "input_schema": {
        "type": "object",
        "properties": {
          "priority_id": { "type": "string" },
          "displayName": { "type": "string" },
          "resolutionHours": { "type": "number" },
          "active": { "type": "boolean" }
        },
        "required": ["priority_id"]
      }
    },
    {
      "name": "delete_priority",
      "description": "Delete one or more priorities in a single call (admin). Pass priority_ids with every numeric id from list_priorities they asked to remove. For one row, priority_id is enough. Never call this tool more than once this turn.",
      "auth": "actor_or_api_key",
      "express": { "method": "DELETE", "path": "/api/priorities/{priority_id}" },
      "input_schema": {
        "type": "object",
        "properties": {
          "priority_id": { "type": "string" },
          "priority_ids": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    {
      "name": "list_statuses",
      "description": "List ticket status catalog entries.",
      "auth": "actor_or_api_key",
      "express": { "method": "GET", "path": "/api/statuses" },
      "input_schema": {
        "type": "object",
        "properties": { "include_inactive": { "type": "boolean" } }
      }
    },
    {
      "name": "create_status",
      "description": "Create a ticket status (admin).",
      "auth": "actor_or_api_key",
      "express": { "method": "POST", "path": "/api/statuses" },
      "input_schema": {
        "type": "object",
        "properties": { "display_name": { "type": "string" } },
        "required": ["display_name"]
      }
    },
    {
      "name": "update_status",
      "description": "Patch status display name or active flag (admin).",
      "auth": "actor_or_api_key",
      "express": { "method": "PATCH", "path": "/api/statuses/{status_id}" },
      "input_schema": {
