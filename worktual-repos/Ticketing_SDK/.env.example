# =============================================================================
# Docker Compose — split DNS (default): web :3355 + api :4000 + agents internal
#   docker compose up -d --build
# Uses DATABASE_URL from this root .env (NOT ai-agents/.env).
# =============================================================================
# APP_URL=https://rebuild-ticketing.worktual.com
# API_PORT=4000
# WEB_PORT=3355
# WEB_BIND=0.0.0.0
# API_BIND=0.0.0.0
# COOKIE_SECURE=1
# CORS_ORIGINS=https://rebuild-ticketing.worktual.com
# JWT_SECRET=replace-with-long-random-string
# COWORKER_TASKS_SECRET=replace-with-long-random-string
# COWORKER_MODEL_URL=http://YOUR_LLM_HOST:8011/v1
# MODEL_URL=http://YOUR_LLM_HOST:8011/v1
# COWORKER_MODEL_NAME=worktual-gemma
# SEED_DEMO=0
# Only if using --profile local-db:
# POSTGRES_USER=ticketing
# POSTGRES_PASSWORD=replace-with-strong-db-password
# POSTGRES_DB=ticketing

# Public SPA URL (cookies, portal links). DevOps nginx upstreams:
#   SPA  https://rebuild-ticketing.worktual.com     → 127.0.0.1:3355  (docker service: web)
#   API  https://rebuild-ticketing-api.worktual.com → 127.0.0.1:4000  (docker service: api)
# Also on SPA host: proxy /api/ and /uploads/ → :4000 (browser relative /api calls).
# For HTTP IP testing (e.g. http://SERVER_IP:3355), set COOKIE_SECURE=0 temporarily.
APP_URL="https://rebuild-ticketing.worktual.com"
API_PORT=4000
WEB_PORT=3355
WEB_BIND=0.0.0.0
API_BIND=0.0.0.0
COOKIE_SECURE=1
CORS_ORIGINS=https://rebuild-ticketing.worktual.com

# PostgreSQL — required. Host/tsx can use 127.0.0.1. Docker api must not:
# localhost inside the container is the API itself (connect timeout).
# Local compose DB: docker compose --profile local-db up
#   DATABASE_URL_DOCKER=postgresql://ticketing:PASSWORD@postgres:5432/ticketing
# Postgres on the host: keep DATABASE_URL as 127.0.0.1 or set
#   DATABASE_URL_DOCKER=postgresql://USER:PASSWORD@host.docker.internal:5432/DATABASE_NAME
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME"
# DATABASE_URL_DOCKER=
# Cap each process pool. Shared remote Postgres hits 53300 if leftover stacks stay up.
PG_POOL_MAX=3

# Dummy skills DB — must already exist (app will NOT CREATE DATABASE). Optional.
SKILLS_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ticketing_skills"

# JWT secret for auth cookies (REQUIRED in production — must not be the default)
JWT_SECRET="change-me-to-a-long-random-string"

# Outbound customer email: log (default if no SMTP) | smtp | off
MAIL_MODE=log
# SLA reminder/breach SMTP (default off). Create/reply/resolve still use MAIL_MODE.
SLA_MAIL=off
MAIL_FROM="Support <support@yourdomain.com>"
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# Optional inbound poll (Gmail SMTP reuses these). IMAP_ENABLE=0 to disable.
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASS=
# IMAP_MAILBOX=INBOX
# IMAP_POLL_MS=30000
# Poller stores last UID in ticketing.imap_poll_cursor (unseen/new only; no 3-day replay).

# Portal OTP SMS: log (default) | twilio | off
SMS_MODE=log
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# Local/dev only: seed demo org+admin and stamp SEED_DEMO_PASSWORD for null hashes.
# Leave unset/false in production customer deployments.
SEED_DEMO=0
SEED_DEMO_PASSWORD=

# Worktual Context Layer — slice, semantic KPIs, and SQL list rows (single base URL).
# POST /v1/ontology/slice, POST /v1/semantic/query, POST /v1/sql/query
# organization_id / user_id come from the logged-in staff user per request.
CONTEXT_LAYER_URL=http://192.168.11.25:8765
CONTEXT_LAYER_TIMEOUT=30
CONTEXT_LAYER_PRODUCT=ticketing

# Upload files (portal logo, ticket attachments). Docker API uses /app/uploads.
# UPLOAD_DIR=/app/uploads

# Standalone KB embed service (PDF extract + Meilisearch ingest). Not CONTEXT_LAYER_URL.
KB_EMBED_URL=http://127.0.0.1:8040
KB_EMBED_TOKEN=change-me-kb-embed-token
KB_EMBED_TIMEOUT=20
KB_STRUCTURE_TIMEOUT=45
ONTOLOGY_CHAT_URL=http://82.113.92.44:8000
ONTOLOGY_CHAT_TIMEOUT=90

# Hub A2A remainder (Ticketing → Hub). Plain HTTP client_credentials + message/send.
# Seed DB row: python scripts/seed_hub_a2a_client.py (same secret as HUB_A2A_CLIENT_SECRET).
HUB_A2A_URL=http://192.168.13.112:8030
# HUB_A2A_TOKEN_URL=http://192.168.13.112:8030/token
HUB_A2A_CLIENT_ID=worktual-ticketing-hub
HUB_A2A_CLIENT_SECRET=change-me-hub-a2a-client-secret
HUB_A2A_SERVER_NAME=worktual-hub
HUB_A2A_SPOKE_LABEL="Ticketing System"
HUB_A2A_TIMEOUT=120

# Inbound A2A spoke (Hub → Ticketing). npm run dev:a2a → :8021
# Seed: python scripts/seed_a2a_spoke_client.py (A2A_SPOKE_CLIENT_SECRET)
A2A_PUBLIC_URL=http://192.168.13.42:8021
A2A_SERVER_NAME=worktual-ticketing
A2A_SPOKE_CLIENT_ID=worktual-hub-ticketing
A2A_SPOKE_CLIENT_SECRET=change-me-ticketing-a2a-spoke-secret
A2A_HUB_JWT_SECRET=change-me-ticketing-a2a-jwt-secret
A2A_HUB_JWT_AUDIENCE=worktual-ticketing-a2a
A2A_ACCESS_TOKEN_ISSUER=worktual-ticketing-a2a-access
A2A_ACCESS_TOKEN_TTL_SECONDS=21600
A2A_REFRESH_TOKEN_TTL_SECONDS=5184000

# Worktual co-worker model (UI status + Python LangGraph)
COWORKER_MODEL_NAME="worktual-gemma"
COWORKER_MODEL_URL="https://YOUR_LLM_HOST/v1"
VITE_COWORKER_MODEL_NAME="worktual-gemma"
VITE_COWORKER_MODEL_URL="https://YOUR_LLM_HOST/v1"

# Python FastAPI multi-agent service (ai-agents/)
COWORKER_AGENTS_URL="http://127.0.0.1:8012"
# Shared secret for ALL agents routes (header X-Coworker-Tasks-Key). REQUIRED in production.
COWORKER_TASKS_SECRET="change-me-tasks-secret"

# Split layout (npm dev on host — same ports as Docker web/api):
TICKETING_API_URL="http://127.0.0.1:3001"
TICKETING_API_ONLY=1

# CRM integration (Path A JWT verification)
# CRM_JWT_ACCESS_SECRET=
# CRM_JWT_ISSUER=worktual-crm
# CRM_JWT_USER_ID_CLAIM=sub

# Spoke-to-spoke (Campaign/Social/CCaaS core → intake), SFT catalog :8022,
# and Accounts onboarding mint (POST /api/auth/onboarding-dashboard-link).
# (header x-internal-service-key). If empty, :8022 falls back to COWORKER_TASKS_SECRET.
# INTERNAL_SERVICE_KEY=change-me-internal-service-key

# CCaaS email thread on ticket Email tab. Same on/off idea as SLA_MAIL.
# CCAAS_EMAIL_SP=on  → MySQL CALL ccaas_ai_get_email_conversation (current)
# CCAAS_EMAIL_SP=off → cdp.identity_keys + ccass.conversations + conversation_messages
CCAAS_EMAIL_SP=on
# CCAAS_MYSQL_HOST=
# CCAAS_MYSQL_USER=
# CCAAS_MYSQL_PASSWORD=
# CCAAS_MYSQL_DATABASE=ccaas_ai
# CCAAS_MYSQL_PORT=3306
# CCAAS_EMAIL_DOMAIN_ID=20708

# Outbound ticket webhooks (CRM/CCaaS consumers)
# TICKETING_WEBHOOK_URL=
# WEBHOOK_SIGNING_SECRET=

# iframe embed CSP (production: restrict to CRM/CCaaS origins)
# TICKETING_FRAME_ANCESTORS=frame-ancestors 'self' https://crm.example.com
