# Vite HTTPS proxies (when UI is https://HOST:5174)
# On the Asterisk host use 127.0.0.1; from a laptop point at the server IP.
VITE_PROXY_API=http://127.0.0.1:3000
VITE_PROXY_ARI_WS=ws://127.0.0.1:8088
