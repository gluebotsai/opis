VITE_AGENT_EXTENSION=w1001
VITE_AGENT_PASSWORD=webrtc_pass1001
VITE_API_KEY=demo-tenant-api-key-12345

# Plain HTTP fallback only — browsers block mic on http://IP
VITE_API_BASE=http://127.0.0.1:3000
