# Copy to deploy/.env ON THE SERVER (never commit). Used by docker compose.
# GitHub Actions does not write this file.

# Public QA URL (OAuth redirects + CORS)
FRONTEND_ORIGIN=https://rebuild-crm.worktual.com
NEXT_PUBLIC_APP_URL=https://rebuild-crm.worktual.com
OAUTH_CALLBACK_ORIGIN=https://rebuild-crm-api.worktual.com
GOOGLE_REDIRECT_URI=https://rebuild-crm-api.worktual.com/api/google/oauth/callback
MICROSOFT_REDIRECT_URI=https://rebuild-crm-api.worktual.com/api/microsoft/oauth/callback
# Published host ports (5173 + legacy 80 → container 5173; API 4000; socket 4001).
WEB_PORT=5173
API_PORT=4000
SOCKET_PORT=4001

# Shared Worktual DB — CRM DML only on inventory; no DDL on cdp/accounts/inventory
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/worktual_bigint?schema=crm
ACCOUNT_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/worktual_bigint
CAMPAIGN_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/worktual_bigint?schema=campaign

DEFAULT_ORGANIZATION_ID=1000
NODE_ENV=production
AGENT_LOG_RETENTION_DAYS=5
# Required for http://IP QA — Secure cookies are not sent over plain HTTP.
COOKIE_SECURE=false
SESSION_SECRET=change-me
# Accounts post-invite mint (CRM-only). Header: x-internal-service-key
# Do not reuse Campaign INTERNAL_SERVICE_KEY or ENRICH_INTERNAL_SECRET.
INTERNAL_SERVICE_KEY=change-me-crm-onboarding-key
# Org connectors (Semrush, LinkedIn, research APIs) — Onboarding internal API
ONBOARDING_INTERNAL_BASE_URL=https://staging-onboarding.worktual.com
PRODUCT_MCP_CONNECTORS_TOKEN=
# ONBOARDING_ALLOW_SETUP_APP_CONNECTIONS_FALLBACK=true

# ZoomInfo via Worktual gateway (CRM never holds ZoomInfo OAuth tokens).
# search_contacts = free; enrich_contacts = 1 data credit per contact.
ZOOMINFO_GATEWAY_URL=http://173.234.75.165:8199
ZOOMINFO_GATEWAY_TOKEN=
SEMRUSH_GATEWAY_URL=http://173.234.75.165:8090
SEMRUSH_GATEWAY_TOKEN=
ZOOMINFO_ENRICH_MAX_PER_IMPORT=1
CRON_SECRET=change-me
ENRICH_INTERNAL_SECRET=change-me
MCP_EXECUTION_JWT_SECRET=change-me-long-random
MCP_EXECUTION_JWT_ISSUER=worktual-crm-api
MCP_EXECUTION_JWT_AUDIENCE=worktual-crm-mcp

# CRM A2A spoke (ai-a2a :8020). Hub is a separate server; JWT shared with Hub.
A2A_PUBLIC_URL=http://ai-a2a:8020
HUB_A2A_URL=
HUB_A2A_TOKEN_URL=
HUB_A2A_SERVER_NAME=worktual-hub
HUB_A2A_CLIENT_ID=
HUB_A2A_CLIENT_SECRET=
HUB_A2A_SPOKE_LABEL=CRM
HUB_A2A_TIMEOUT_SECONDS=300
A2A_HUB_JWT_SECRET=change-me-a2a-hub-jwt
A2A_HUB_JWT_ISSUER=worktual-hub
A2A_HUB_JWT_AUDIENCE=worktual-crm-a2a
A2A_ACCESS_TOKEN_ISSUER=worktual-crm-a2a-access
A2A_SERVER_NAME=worktual-crm
A2A_SPOKE_CLIENT_ID=
A2A_SPOKE_CLIENT_SECRET=
A2A_ACCESS_TOKEN_TTL_SECONDS=21600
A2A_REFRESH_TOKEN_TTL_SECONDS=5184000

# OAuth / email — CRM requests scopes in code (not env). After changing these:
# 1) Register redirect URIs in Google Cloud + Azure (below)
# 2) Enable Gmail API + Calendar API (Google); grant admin consent (Microsoft)
# 3) Restart api container; users Disconnect + Reconnect in Configuration → Email
#
# Google scopes (backend/src/service/google/calendar.ts GOOGLE_SCOPES):
#   gmail.send, gmail.modify, calendar.events, calendar.readonly,
#   meetings.space.readonly, meetings.conference.media.readonly, openid, email, profile
# Microsoft scopes (backend/src/service/microsoft/oauth.ts MICROSOFT_MAIL_SCOPES):
#   User.Read, Mail.Read, Mail.Send, Calendars.Read, offline_access, openid, profile, email
#
# Patch on server: export GOOGLE_* / MICROSOFT_* then bash scripts/update-oauth-env.sh
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=7187d92d-dcd9-4b36-9a5e-d30a0da3ccd1
# Mail OAuth must stay "common" so personal Outlook + other orgs work.
# Pinning to a tenant GUID forces login into that tenant only (breaks @outlook.com).
MICROSOFT_MAIL_TENANT=common
MICROSOFT_ORGANIZER_USER_ID=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Must match Accounts exactly (AES-256-GCM for mail_oauth_connections tokens).
# Wrong/missing value → nurture: "Unsupported state or unable to authenticate data".
MS_TOKEN_ENCRYPTION_KEY=

# LLM (ai-service) — shared by ai-orchestrator + ai-mcp + ai-a2a (all CRM agents)
# QA server:  bash scripts/patch-llm-env.sh  &&  bash scripts/verify-llm.sh
# Meet add-on: bash scripts/patch-meet-addon-env.sh  (after exporting meeting secrets)
LLM_API_KEY=EMPTY
LLM_MODEL=worktual-qwen-27B
LLM_BASE_URL=http://81.17.61.149:8066/v1
# Proposal pattern extract + generate (native Gemini). Required for Configuration → Proposal patterns.
# GEMINI_API_KEY is an alias for PROPOSAL_LLM_API_KEY. After setting, recreate ai-orchestrator:
#   bash scripts/patch-proposal-gemini-env.sh
PROPOSAL_LLM_API_KEY=
GEMINI_API_KEY=
PROPOSAL_LLM_MODEL=gemini-3.5-flash
PROPOSAL_LLM_THINKING_LEVEL=high
# shadow (default): log content-QA mismatches. active: rewrite flagged sections. off: skip.
PROPOSAL_CONTENT_QA_MODE=shadow
# Isolated V2 generate (default off)
# PROPOSAL_PIPELINE_V2=off
# PROPOSAL_PIPELINE_V2_ORGS=
# PROPOSAL_OUTLINE_MODE=frozen
SOCIAL_IMAGE_MODEL=gemini-3.1-flash-image-preview
# Proposal pattern PDF storage (mounted volume in docker-compose.yml)
CORPUS_STORAGE_DIR=/app/backend/data/proposal-corpus
# Knowledge base: POST /retrieve (domain_id + query) or legacy POST /search
KNOWLEDGE_BASE_URL=http://82.113.92.47:7051/search
KB_DOMAIN_ID=
KB_ORGANIZATION_ID=0000
KB_PRODUCT_ID=crm
KNOWLEDGE_BASE_TIMEOUT_S=12
KNOWLEDGE_BASE_JOB_TIMEOUT_S=45
KNOWLEDGE_BASE_PROBE_TIMEOUT_S=3
SEMANTIC_LAYER_GATEWAY_URL=
SEMANTIC_LAYER_PRODUCT=crm
ONTOLOGY_GATEWAY_URL=
ONTOLOGY_GATEWAY_TIMEOUT_S=90

# Marketing / Campaign MS (remote API + UI iframe) — REQUIRED for Marketing module
# CAMPAIGN_UI_URL = Campaign SPA host for iframe (NOT CRM, NOT /campaign-proxy)
# MARKETING_MS_URL = Campaign UI/API embed host
# CAMPAIGN_API_BASE_URL = nurture personalised-crm REST (live API)
# CRM_INTEGRATION_KEY = X-Crm-Integration-Key for POST …/personalised-crm/automation
# JWT_ACCESS_SECRET must equal Campaign CRM_JWT_ACCESS_SECRET (shared HS256)
# CRM_JWT_ISSUER=worktual-crm (must match Campaign CRM_JWT_ISSUER)
# deploy.sh refuses to start if CAMPAIGN_UI_URL / MARKETING_MS_URL / JWT_ACCESS_SECRET are empty.
# Campaign must allowlist https://rebuild-crm.worktual.com in frame-ancestors.
MARKETING_MS_URL=https://rebuild-campaign.worktual.com
CAMPAIGN_UI_URL=https://rebuild-campaign.worktual.com
CAMPAIGN_API_BASE_URL=https://rebuild-campaign-api.worktual.com
CRM_INTEGRATION_KEY=

# Lead nurture voice (cc-core auto-bot-call) — required for Configuration → Lead nurture
# “cc-core voice configured” and for POST …/internal/v1/voice/auto-bot-call
CC_CORE_API_BASE_URL=https://rebuild-ccaas-api.worktual.com/cc-core-api
CC_CORE_INTERNAL_SERVICE_KEY=
# Optional: disable periodic lead-nurture sweep on scheduler only (api still enqueues on score)
# LEAD_NURTURE_CRON_ENABLED=false

# IP fallback: http://82.113.92.49:8080 for both
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
CRM_JWT_ISSUER=worktual-crm
MARKETING_MS_TOKEN=
SERVICE_MS_URL=
SERVICE_MS_TOKEN=

# Digital Marketing: Semrush gateway for the seed (1 hit / ~20 units), LLM related + fallback.
# SEO_KEYWORD_SOURCE=llm
SEMRUSH_GATEWAY_URL=http://173.234.75.165:8090
SEMRUSH_GATEWAY_TOKEN=
# LinkedIn Posts API version (YYYYMM). Tokens come from MyAccounts setup_app_connections.
# LINKEDIN_API_VERSION=202608
# Legacy Semrush MCP (not used when SEMRUSH_GATEWAY_TOKEN is set)
# SEMRUSH_MCP_ENABLED=true

# Meet add-on (project NUMBER, not OAuth client id). Used by meeting-service Path B
# and optionally baked into the web image for the legacy SPA host.
VITE_GOOGLE_CLOUD_PROJECT_NUMBER=
# Must match ACCOUNTS / GOOGLE_ADDON client project (714138144506-… client id prefix).
GOOGLE_ADDON_CLOUD_PROJECT_NUMBER=714138144506
# Meet GIS sign-in: same editable Web client as ACCOUNTS_GOOGLE_* (NOT locked Marketplace …4p9g…).
# JS origin on that client: https://rebuild-crm.worktual.com — secret stays API-only (not meeting-service).
GOOGLE_ADDON_CLIENT_ID=714138144506-qnqqagcfag10am1ifle7dcnn6frpdgsl.apps.googleusercontent.com
ACCOUNTS_GOOGLE_CLIENT_ID=714138144506-qnqqagcfag10am1ifle7dcnn6frpdgsl.apps.googleusercontent.com
ACCOUNTS_GOOGLE_CLIENT_SECRET=

# Each CRM employee's configured Google mailbox identifies that person in Meet.
# Tiles no connected mailbox recognizes are the customer. 0 = host name only, shadow = log only.
MEET_CHANNEL_BINDINGS=1

# Meeting notetaker + Sales Assist add-on (Path B) — see docs/meeting-service-integration.md
NOTETAKER_PROVIDER=vexa
MEETING_SERVICE_PUBLIC_URL=https://rebuild-crm.worktual.com
CRM_SERVICE_JWT_SECRET=change-me-meeting-jwt
MEETING_SERVICE_WEBHOOK_SECRET=change-me-webhook-hmac
CRM_BOT_API_KEY=change-me-crm-bot-key
CRM_USERS_API_KEY=
MEETING_POSTGRES_PASSWORD=meeting
# Vexa Lite runs in this compose (service vexa-lite). deploy.sh sets this
# and copies VEXA_API_KEY from the container after the first boot.
VEXA_API_BASE=http://vexa-lite:8056
VEXA_API_KEY=
# Optional: public URL Vexa uses to POST status (default is in-compose http://meeting-service:8030/...)
# MEETING_SERVICE_VEXA_WEBHOOK_URL=http://meeting-service:8030/internal/vexa/webhook
MEETING_CAPTURE_BOT_DISPLAY_NAME=Worktual Notetaker
# GPU Whisper used by meeting-whisper adapter
# WHISPER_UPSTREAM_URL=http://173.234.75.165:7789/v1/audio/translations
# WHISPER_UPSTREAM_TOKEN=EMPTY
# WHISPER_UPSTREAM_MODEL=worktual-large-v3

# Legacy Recall (omit when NOTETAKER_PROVIDER=vexa)
# Without these, meeting activities show "Transcript: capture failed — check bot config".
# Verify on server: bash scripts/verify-meeting-bot.sh
MEETING_BOT_API_KEY=
MEETING_BOT_WEBHOOK_BASE_URL=https://rebuild-crm-api.worktual.com
# MEETING_BOT_API_BASE_URL=https://us-east-1.recall.ai/api/v1
# MEETING_BOT_DISPLAY_NAME=Worktual Assist
# MEETING_CAPTURE_BOT_DISPLAY_NAME=Worktual Notetaker
# MEETING_CAPTURE_BOT_JOIN_SKEW_MINUTES=5
# MEETING_CAPTURE_BOT_ENABLED=true
# MEETING_CAPTURE_TRANSCRIPT_PROVIDER=recallai_streaming
# MEETING_CAPTURE_TRANSCRIPT_MODE=prioritize_accuracy
# MEETING_CAPTURE_TRANSCRIPT_LANGUAGE=auto
# CRM_API_PUBLIC_URL=https://rebuild-crm-api.worktual.com
# Calendar events.watch (HTTPS). Do not reuse the Gmail Pub/Sub topic.
# CALENDAR_PUSH_WEBHOOK_URL=https://rebuild-crm-api.worktual.com/api/webhooks/google-calendar/push
# In Recall dashboard: subscribe POST /api/webhooks/meeting-bot/recall (transcript.done, bot.done)
# See docs/meeting-transcript-archive.md
