# Drop these into the Vexa stack (vexa/deploy/compose/.env).
# Join the same Docker network: crm-meetings
# Point at meeting-service whisper-adapter (host :8032, docker DNS whisper-adapter:8000).
# Do not put this file in the CRM app. Do not put Google OAuth here.

# Required — Vexa defaults to whisper-1 without this; Worktual GPU rejects whisper-1 (500, no segments).
TRANSCRIPTION_SERVICE_URL=http://whisper-adapter:8000
TRANSCRIPTION_SERVICE_TOKEN=EMPTY
TRANSCRIPTION_MODEL=worktual-large-v3

# Live Assist — required on every meeting-bot container (in-bot Whisper is off).
# Stock vexaai/vexa-lite does not include this forwarder; run:
#   ./scripts/patch-vexa-live-pcm.sh
VEXA_LIVE_PCM_WS_BASE=ws://meeting-service:8030
VEXA_LIVE_PCM_BOT_KEY=local-meeting-bot-key
# meeting-service POST /bots always uses transcribe_enabled=false

# GPU native endpoint (adapter already wraps this):
# http://173.234.75.165:7789/v1/audio/translations
