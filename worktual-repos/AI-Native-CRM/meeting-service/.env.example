# Copy to .env. Never commit real secrets. Never put these in the CRM frontend.

# Postgres (compose default) or sqlite for local tests
DATABASE_URL=postgresql+psycopg://meeting:meeting@postgres:5432/meeting_service

CRM_SERVICE_JWT_SECRET=change-me-to-a-long-random-string
PASSCODE_FERNET_KEY=

# Vexa Lite runs in this same compose (service vexa-lite, host :18056).
# Compose overrides VEXA_API_BASE to http://vexa-lite:8056 inside the network.
# Copy the minted key after first boot: docker exec vexa-lite cat /run/vexa/key.env
VEXA_API_BASE=http://vexa-lite:8056
VEXA_API_KEY=
WEBHOOK_SECRET=change-me-webhook-hmac
PUBLIC_BASE_URL=http://meeting-service:8030/internal/vexa/webhook

WHISPER_BASE_URL=http://whisper-adapter:8000
WHISPER_API_TOKEN=EMPTY
WHISPER_MODEL=worktual-large-v3

# Live PCM: gain×2 → HP → DTLN → Silero VAD; STT = raw PCM + pre-roll
LIVE_PCM_ENABLED=true
LIVE_PCM_PRE_SPEECH_MS=500
LIVE_PCM_GAIN=2
LIVE_PCM_VAD_MODE=silero
LIVE_PCM_DTLN_ENABLED=true
# LIVE_PCM_DTLN_MODEL_DIR=/app/models/dtln
LIVE_PCM_SILERO_THRESHOLD=0.5
LIVE_PCM_SILERO_MIN_SILENCE_MS=600
LIVE_PCM_SILERO_SPEECH_PAD_MS=30
# 0 = one Whisper call per Silero utterance (no rolling drafts)
LIVE_PCM_DRAFT_MS=0
# energy fallback only when LIVE_PCM_VAD_MODE=energy
LIVE_PCM_SILENCE_MS=600
LIVE_PCM_ENERGY_THRESHOLD=7000
LIVE_PCM_WHISPER_TIMEOUT_SEC=8
# Force English STT (matches whisper-adapter CCaaS default). Leave empty for auto-detect.
LIVE_PCM_WHISPER_LANGUAGE=en
# Live Assist: only path — Vexa capture → live-pcm WS → Whisper here (never in-bot STT)

# GPU Whisper (whisper-adapter → translations API; meeting-service STT calls adapter)
# WHISPER_UPSTREAM_URL=http://173.234.75.165:7789/v1/audio/translations
# WHISPER_UPSTREAM_TOKEN=EMPTY
# WHISPER_UPSTREAM_MODEL=worktual-large-v3

LLM_BASE_URL=http://173.234.75.165:7789/v1
LLM_API_KEY=EMPTY
LLM_MODEL=local
LLM_TIMEOUT_SEC=60

REDIS_URL=redis://redis:6379/0

HOST=0.0.0.0
PORT=8030
TESTING=false

# Default when POST /v1/meetings omits recording_enabled.
# Per meeting: { "recording_enabled": true } stores Vexa audio+video (uses more RAM/CPU).
VEXA_RECORDING_ENABLED=false

# Simultaneous Meet bots (Vexa Chrome), not Whisper HTTP RPS.
MAX_CONCURRENT_MEETINGS=20
MAX_CONCURRENT_PER_ORG=10
MAX_QUEUED_MEETINGS=1000
MAX_QUEUED_PER_ORG=100
LOBBY_TIMEOUT_SEC=1200
# Keep bot in lobby until CRM expected_end_at when set (sales may join late).
LOBBY_TIMEOUT_UNTIL_SLOT_END=true
# CRM slot end policy: after expected_end_at + grace, worker stops bot (host-ended).
MEETING_SLOT_DURATION_SEC=1800
HOST_ENDED_GRACE_SEC=90
# 0 = do not stop the notetaker because the call went quiet. It stays until the host leaves.
HOST_ENDED_SILENCE_SEC=0
# Ignore bot-alone / empty-room snapshots until this long after admit
HOST_ENDED_ALONE_GRACE_SEC=90
# false = end capture when host leaves / Vexa completes, not when calendar slot ends
FINALIZE_ON_SCHEDULED_SLOT_END=false
# false = do not stop on bot-alone / empty-room Vexa snapshots (recommended for Meet)
FINALIZE_ON_BOT_ALONE=false
CONSENT_REQUIRED=true
LIVE_TIPS_ENABLED=false
NOTETAKER_PROVIDER=vexa
POST_MEETINGS_RATE_PER_MIN=30

TRANSCRIPT_RETENTION_DAYS=90
AUDIO_RETENTION_DAYS=30
WEBHOOK_SKEW_SEC=300
RETRY_AFTER_SEC=15
EXTRACT_MAX_ATTEMPTS=3
DEFAULT_BOT_NAME=Worktual Notetaker
ENABLE_TEST_UI=true

# Meet Assist add-on → CRM bot (POST {CRM_BOT_BASE_URL}/v1/assist/ask)
# Dummy (in-process OpenAI client): CRM_BOT_BASE_URL=internal
# Real bot later: CRM_BOT_BASE_URL=https://your-crm-bot.example
CRM_BOT_BASE_URL=internal
CRM_BOT_API_KEY=
CRM_BOT_OPENAI_BASE_URL=http://127.0.0.1:8011/v1
CRM_BOT_OPENAI_API_KEY=
CRM_BOT_OPENAI_MODEL=worktual-gemma
# Google sign-in for the Meet add-on (Marketplace SDK OAuth client — not CRM login client).
# Local: ./scripts/sync-meeting-service-env.sh copies from root .env after you set keys there.
# Editable Web client for GIS (local ngrok). Locked Marketplace client …4p9g… cannot add JS origins.
GOOGLE_ADDON_CLIENT_ID=853886404171-2s9fp2erm14jnbvfpspr5hjsldptv5sp.apps.googleusercontent.com
# Local CRMproject Web client (…2s9f…): 853886404171. Server ACCOUNTS client: 714138144506.
GOOGLE_ADDON_CLOUD_PROJECT_NUMBER=853886404171
# If CRM login uses a different Web client, set GOOGLE_CLIENT_ID (and/or comma-separated GOOGLE_OAUTH_EXTRA_CLIENT_IDS).
GOOGLE_CLIENT_ID=
GOOGLE_OAUTH_EXTRA_CLIENT_IDS=
# Dummy CRM user map until real CRM lookup exists
CRM_USERS_BASE_URL=internal
CRM_USERS_API_KEY=
CRM_ASSIST_DUMMY_ORG_ID=1003
ASSIST_SESSION_TTL_SEC=28800

# CRM webhook — transcript attach + post-meeting-process
# CRM_COMPLETED_WEBHOOK_URL=https://api.your-domain.com/api/webhooks/meeting-service/completed
CRM_COMPLETED_WEBHOOK_URL=
