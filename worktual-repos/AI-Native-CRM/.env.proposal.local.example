# =============================================================================
# Local proposal generate — copy this file to repo-root `.env` and fill FILL_ME.
#
#   cp .env.proposal.local.example .env
#
# `.env` is gitignored. Do not commit secrets.
#
# Services we WILL start after you fill this:
#   - Fastify CRM API     :4000   (backend)
#   - Python ai-service   :8000   (proposal agents + coworker turns)
#   - Python MCP          :8010   (coworker AI chat tools)
#
# Services we will NOT start:
#   - A2A spoke :8020
#   - meeting-service, campaign-ms, meet-media-worker
# =============================================================================

# --- Postgres (required) -----------------------------------------------------
# Same Worktual DB as Prisma: crm.* + inventory.products + accounts + cdp.
# Local example: postgresql://USER:PASSWORD@127.0.0.1:5432/worktual_bigint
ACCOUNT_DATABASE_URL="postgresql://FILL_ME_DB_USER:FILL_ME_DB_PASSWORD@FILL_ME_DB_HOST:5432/worktual_bigint"
DATABASE_URL="postgresql://FILL_ME_DB_USER:FILL_ME_DB_PASSWORD@FILL_ME_DB_HOST:5432/worktual_bigint?schema=crm"

# --- Process wiring (required, local defaults are fine) ----------------------
API_PORT=4000
API_HOST=0.0.0.0
FRONTEND_ORIGIN="http://localhost:5173"
AI_SERVICE_BASE_URL="http://127.0.0.1:8000"
CRM_API_BASE_URL="http://127.0.0.1:4000"
ENRICH_INTERNAL_SECRET="dev-proposal-local-secret"

# Coworker AI chat (Fastify issues MCP JWTs; Python MCP verifies the same secret).
MCP_BASE_URL="http://127.0.0.1:8010/mcp/v1"
MCP_PREFER_HTTP=true
MCP_EXECUTION_JWT_SECRET="local-mcp-execution-jwt-secret-min-32-chars"
MCP_EXECUTION_JWT_ISSUER="worktual-crm-api"
MCP_EXECUTION_JWT_AUDIENCE="worktual-crm-mcp"
COWORKER_NATIVE_ENABLED=true
COWORKER_NATIVE_ALLOWLIST="*"

# Keep background jobs off while we stabilize generate.
CRON_SCHEDULER_ENABLED=false
AI_WORKER_ENABLED=false
READINESS_REQUIRE_REDIS=false
ORCHESTRATOR_STM_ENABLED=false
NAMED_AGENTS_NATIVE_ENABLED=false

# Session / JWT (local-only; 32+ chars). Change if you like.
SESSION_SECRET="local-proposal-session-secret-min-32-chars"
JWT_ACCESS_SECRET="local-proposal-jwt-access-secret-min-32"
JWT_ACCESS_TTL_SECONDS=900
CRM_JWT_ISSUER="worktual-crm"
DEFAULT_ORGANIZATION_ID="1000"

# Proposal PDF corpus on disk (learn patterns). Default is fine.
CORPUS_STORAGE_DIR="./data/proposal-corpus"
PROPOSAL_CONTENT_QA_MODE=shadow
# PROPOSAL_PIPELINE_V2=off
# PROPOSAL_OUTLINE_MODE=frozen

# --- Proposal LLM (required for generate) ------------------------------------
# Native Gemini. GEMINI_API_KEY is an alias for PROPOSAL_LLM_API_KEY.
# Point PROPOSAL_LLM_MODEL at any Gemini your key can use, e.g. gemini-2.0-flash.
PROPOSAL_LLM_API_KEY="FILL_ME_GEMINI_API_KEY"
GEMINI_API_KEY="FILL_ME_GEMINI_API_KEY"
PROPOSAL_LLM_MODEL="gemini-2.0-flash"
PROPOSAL_LLM_THINKING_LEVEL="high"
PROPOSAL_LLM_BASE_URL=

# --- CRM LLM fallback (optional; used if Gemini key is empty) ----------------
LLM_API_KEY="EMPTY"
LLM_MODEL="worktual-qwen-27B"
LLM_BASE_URL="http://81.17.61.149:8066/v1"

# Knowledge base — POST /retrieve (domain_id). Index uid, not CRM org numeric id.
KNOWLEDGE_BASE_URL="http://192.168.13.29:7051/search"
KB_DOMAIN_ID=""
KB_ORGANIZATION_ID="0000"
KB_PRODUCT_ID="crm"
KNOWLEDGE_BASE_TIMEOUT_S=12
KNOWLEDGE_BASE_JOB_TIMEOUT_S=45
KNOWLEDGE_BASE_PROBE_TIMEOUT_S=3

# ai-service process
APP_ENV=development
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS="http://localhost:5173"
