# Shared Worktual DB (10.180.0.126) — accounts.setup_users + cdp.*
# No DDL against accounts/cdp — app only reads/writes existing rows/columns.
ACCOUNT_DATABASE_URL="postgresql://USER:PASSWORD@10.180.0.126:5432/worktual_bigint"

# CRM transactional data — worktual schemas on the same server (not localhost)
# Products: inventory.products only (Prisma multi-schema). Other CRM tables: crm.*.
# DML only on inventory; no DDL. DATABASE_URL may still use ?schema=crm for migrate.
DATABASE_URL="postgresql://USER:PASSWORD@10.180.0.126:5432/worktual_bigint?schema=crm"

# Campaign microservice — worktual.campaign schema on the same server
CAMPAIGN_DATABASE_URL="postgresql://USER:PASSWORD@10.180.0.126:5432/worktual_bigint?schema=campaign"

# Optional: signed server session cookie for integrations
SESSION_SECRET="change-me-in-production"

# Accounts post-invite mint (CRM-only). Header: x-internal-service-key
# Do not reuse Campaign INTERNAL_SERVICE_KEY or ENRICH_INTERNAL_SECRET.
INTERNAL_SERVICE_KEY="change-me-crm-onboarding-key"

# Org product connectors (Semrush, LinkedIn, research APIs) — Onboarding internal API.
# GET {ONBOARDING_INTERNAL_BASE_URL}/api/v1/internal/connected-apps/{app_key}/credentials?organization_id=
# Authorization: Bearer PRODUCT_MCP_CONNECTORS_TOKEN
ONBOARDING_INTERNAL_BASE_URL="https://staging-onboarding.worktual.com"
PRODUCT_MCP_CONNECTORS_TOKEN=""
# Local dev only: fall back to accounts.setup_app_connections SELECT when API misses.
# ONBOARDING_ALLOW_SETUP_APP_CONNECTIONS_FALLBACK=true

# ZoomInfo via Worktual gateway (CRM never holds ZoomInfo OAuth tokens).
# search_contacts = free; enrich_contacts = 1 data credit per contact.
ZOOMINFO_GATEWAY_URL="http://173.234.75.165:8199"
ZOOMINFO_GATEWAY_TOKEN=""

# Semrush via Worktual gateway (Bearer only). 1 keyword_metrics ≈ 20 units / 1 daily hit.
SEMRUSH_GATEWAY_URL="http://173.234.75.165:8090"
SEMRUSH_GATEWAY_TOKEN=""
# SEO_KEYWORD_SOURCE=llm
# Max ZoomInfo enrich calls when importing a prospect-pull selection (credit-safe).
ZOOMINFO_ENRICH_MAX_PER_IMPORT=1

# Default tenant UUID for multi-tenant-ready rows (change per deployment)
DEFAULT_ORGANIZATION_ID="1000"

# Protect /api/cron/* with Authorization: Bearer <CRON_SECRET>
# CRON_SECRET=""

# Python LangGraph ai-service (all CRM agents: enrich, score, summary, nurture,
# lifecycle, assign-sales, transcript, chat). LLM keys live in ai-service/.env
# (LLM_API_KEY / LLM_BASE_URL / LLM_MODEL) — not OpenAI cloud from Next.js.
# Knowledge base: POST /retrieve (domain_id + query) or legacy POST /search
KNOWLEDGE_BASE_URL=http://82.113.92.47:7051/search
KB_DOMAIN_ID=
KB_ORGANIZATION_ID=0000
KB_PRODUCT_ID=crm
KNOWLEDGE_BASE_TIMEOUT_S=12
KNOWLEDGE_BASE_JOB_TIMEOUT_S=45
KNOWLEDGE_BASE_PROBE_TIMEOUT_S=3

# Proposal pattern corpus PDF storage (default: ./data/proposal-corpus)
# CORPUS_STORAGE_DIR=/var/crm/proposal-corpus

# Proposal content QA after section assembly: shadow (log) | active (rewrite) | off
# PROPOSAL_CONTENT_QA_MODE=shadow

# Isolated V2 generate pipeline (default off). Kill switch wins over org list.
# PROPOSAL_PIPELINE_V2=off
# PROPOSAL_PIPELINE_V2_ORGS=
# PROPOSAL_PIPELINE_V2_KILL=
# PROPOSAL_OUTLINE_MODE=frozen
# PROPOSAL_LEAF_CONCURRENCY=1
# PROPOSAL_EVALS_ENABLED=false

# Optional Zoom transcript webhook HMAC secret
# ZOOM_WEBHOOK_SECRET=
# ENRICH_INTERNAL_SECRET="dev-enrich-secret"
# MCP_EXECUTION_JWT_SECRET="" # strong server-only shared key; never expose to Vite
# MCP_EXECUTION_JWT_TTL_SECONDS=60
# MCP_EXECUTION_JWT_ISSUER="worktual-crm-api"
# MCP_EXECUTION_JWT_AUDIENCE="worktual-crm-mcp"
# ORCHESTRATOR_STM_ENABLED=false
# ORCHESTRATOR_REDIS_URL="redis://127.0.0.1:6379/0"
# ORCHESTRATOR_STM_TTL_SECONDS=86400
# ORCHESTRATOR_STM_FAILURE_MODE="graceful" # graceful | closed
# Native coworker requires this Fastify switch plus the same ai-service switch.
# COWORKER_NATIVE_ENABLED=false
# COWORKER_NATIVE_ALLOWLIST="" # org ids, org:user pairs, or * (comma-separated)
# NAMED_AGENTS_NATIVE_ENABLED=false
# NAMED_AGENTS_NATIVE_ALLOWLIST=""
# NAMED_AGENTS_LEGACY_ALLOWLIST=""

# Marketing / Campaign microservice — CRM BFF + embed iframe
# Lab: API :3001 + UI :5173 on Campaign host (browser loads iframe directly)
# MARKETING_MS_URL — Campaign API (Marketing embed list/create)
# CAMPAIGN_API_BASE_URL — nurture personalised-crm REST (live API, not the UI host, not LAN)
# CRM_INTEGRATION_KEY — X-Crm-Integration-Key for POST …/personalised-crm/automation (nurture/agents)
# MARKETING_MS_URL="http://192.168.11.31:3001"
# CAMPAIGN_API_BASE_URL="https://rebuild-campaign-api.worktual.com"
# CRM_INTEGRATION_KEY="<shared with Campaign CRM_INTEGRATION_KEY>"

# cc-core auto-bot-call (lead nurture voice/WhatsApp) — body: organizationId, number, data, instruction
# CC_CORE_API_BASE_URL="https://rebuild-ccaas-api.worktual.com/cc-core-api"
# CC_CORE_INTERNAL_SERVICE_KEY="dev-internal-key"
# CAMPAIGN_UI_URL="http://192.168.11.31:5173"
# CAMPAIGN_PROXY_TARGET="http://192.168.11.31:5173"  # optional; used when UI url is /campaign-proxy
# Do NOT set CAMPAIGN_UI_URL to CRM /campaign-proxy — Campaign Vite assets use absolute /src paths.
# Server (recommended):
MARKETING_MS_URL="https://rebuild-campaign.worktual.com"
CAMPAIGN_UI_URL="https://rebuild-campaign.worktual.com"
# IP fallback: http://82.113.92.49:8080 for both
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_ACCESS_TTL_SECONDS=900
CRM_JWT_ISSUER="worktual-crm"
# MARKETING_MS_TOKEN=""  # inbound lead webhook only (Campaign → CRM)

# Service microservice (own DB) — CRM hands off onboarding on Closed Won
# SERVICE_MS_URL="https://service.internal"
# SERVICE_MS_TOKEN=""

# Optional: transactional email for password reset (https://resend.com)
# RESEND_API_KEY=""
# PASSWORD_RESET_FROM_EMAIL="Worktual CRM <noreply@yourdomain.com>"

# Legacy OPENAI_* on Next.js is unused — configure LLM on ai-service instead.

# Public app URL used to build OAuth redirect (default http://localhost:3000)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Split-stack (Vite :5173 + Fastify :4000) — set these and register callback URIs on Google/Azure:
# FRONTEND_ORIGIN="http://localhost:5173"
# OAUTH_CALLBACK_ORIGIN="http://localhost:4000"
# GOOGLE_REDIRECT_URI="http://localhost:4000/api/google/oauth/callback"
# MICROSOFT_REDIRECT_URI="http://localhost:4000/api/microsoft/oauth/callback"
#
# Production (Meet add-on sidePanelUrl = FRONTEND_ORIGIN, not the API host):
# FRONTEND_ORIGIN="https://rebuild-crm.worktual.com"
# OAUTH_CALLBACK_ORIGIN="https://rebuild-crm-api.worktual.com"
# GOOGLE_REDIRECT_URI="https://rebuild-crm-api.worktual.com/api/google/oauth/callback"

# ── Email: Google (Gmail send + inbox + Google Meet / Calendar) ──
# Enable Gmail API + Calendar API. Redirect: /api/google/oauth/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Calendar insert: externalOnly (faster) vs all (slow; waits on guest mail). Optional timeout ms.
# Fast schedule API: write event with sendUpdates=none, email guests in background.
# GOOGLE_CALENDAR_DEFER_SEND_UPDATES=true
# GOOGLE_CALENDAR_SEND_UPDATES=externalOnly
# GOOGLE_CALENDAR_FETCH_TIMEOUT_MS=30000
GOOGLE_REDIRECT_URI="http://localhost:4000/api/google/oauth/callback"

# Accounts CRM bot mailbox (setup_channel_configs product_ids ⊇ crm).
# Same AES-256-GCM key Accounts uses for mail_oauth_connections.*_encrypted
# (iv:tag:ciphertext). Env name matches Accounts/CCaaS: MS_TOKEN_ENCRYPTION_KEY.
# 64 hex chars → 32 bytes; otherwise SHA-256 of the string (also 32-byte base64).
# Must match Accounts exactly or nurture/bot mail fails with
# "Unsupported state or unable to authenticate data" (AES-GCM auth tag).
# MS_TOKEN_ENCRYPTION_KEY=""
# Legacy alias only (prefer MS_TOKEN_ENCRYPTION_KEY): ACCOUNTS_TOKEN_ENCRYPTION_KEY=""
# If Accounts had no encryption key at mailbox connect time, tokens used scrypt
# fallback: scrypt(MS_CLIENT_SECRET, salt="worktual-mail-oauth", 32).
# MS_CLIENT_SECRET=""
# One Google OAuth app for inbox + CRM bot: set GOOGLE_* and ACCOUNTS_GOOGLE_* to the same client id/secret.
# If Accounts OAuth app differs from CRM inbox Google client:
# ACCOUNTS_GOOGLE_CLIENT_ID=""
# ACCOUNTS_GOOGLE_CLIENT_SECRET=""
# ACCOUNTS_MICROSOFT_CLIENT_ID=""
# ACCOUNTS_MICROSOFT_CLIENT_SECRET=""

# ── Email: Microsoft Outlook (delegated OAuth) ──
# App registration with redirect /api/microsoft/oauth/callback
# Delegated: Mail.Send, Mail.Read, User.Read, offline_access
# Supported account types: personal + work (multitenant) recommended for Outlook.com
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# Org tenant — used for Teams app-only meetings
MICROSOFT_TENANT_ID=""
# Mail OAuth tenant — keep "common" so personal Outlook accounts can send mail
MICROSOFT_MAIL_TENANT="common"
MICROSOFT_REDIRECT_URI="http://localhost:3000/api/microsoft/oauth/callback"

# ── Meetings: Microsoft Teams (application / client credentials) ──
# Same app can add Application permission OnlineMeetings.ReadWrite.All
# MICROSOFT_ORGANIZER_USER_ID = host user UPN or object id
MICROSOFT_ORGANIZER_USER_ID=""

# ── Meetings: Zoom (Server-to-Server OAuth) ──
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""

# Google Meet add-on (project NUMBER, not client id) — Vite: VITE_GOOGLE_CLOUD_PROJECT_NUMBER
NEXT_PUBLIC_GOOGLE_CLOUD_PROJECT_NUMBER=853886404171
# VITE_GOOGLE_CLOUD_PROJECT_NUMBER=853886404171

# Worktual STT (OpenAI-compatible /audio/transcriptions) for Meet Media worker
WORKTUAL_STT_BASE_URL="http://173.234.75.165:7789/v1"
WORKTUAL_STT_API_KEY="EMPTY"
WORKTUAL_STT_MODEL="worktual-large-v3"

# Daily dashboard voice briefing (Indian English). Fastify proxies; browsers never call this host.
TTS_BASE_URL="http://173.234.75.165:7024/tts"
# Raw PCM from that TTS host is labeled audio/wav but has no RIFF header.
TTS_PCM_SAMPLE_RATE="22050"

# Meeting notetaker — Vexa via meeting-service (Path B Meet add-on)
NOTETAKER_PROVIDER=vexa
# Use 8050 with meeting-service/docker-compose.local.yml (8030–8041 often SSH-tunneled to QA).
# meeting-service/docker-compose publishes :8030 on the host (use 8050 only if you map that port)
MEETING_SERVICE_URL=http://127.0.0.1:8030
# Local Meet iframe: HTTPS ngrok → :4000 (./scripts/up-meet-ngrok.sh). Paste deployment.json from repo root render script.
MEETING_SERVICE_PUBLIC_URL=""      # e.g. https://studied-clamp-galvanize.ngrok-free.dev (must match Google HTTP deployment)
CRM_SERVICE_JWT_SECRET=""          # shared with meeting-service/
MEETING_SERVICE_WEBHOOK_SECRET=""  # shared WEBHOOK_SECRET for completed webhook
CRM_BOT_API_KEY=""                 # meeting-service → POST /v1/assist/ask
CRM_USERS_API_KEY=""               # meeting-service → GET /v1/users/by-email
# Local Meet GIS: editable Web client (…2s9f…), NOT locked “Google Workspace Add-ons” …4p9g…
GOOGLE_ADDON_CLIENT_ID="853886404171-2s9fp2erm14jnbvfpspr5hjsldptv5sp.apps.googleusercontent.com"
# Local …2s9f… client → 853886404171. Server ACCOUNTS client → 714138144506 (deploy/.env).
GOOGLE_ADDON_CLOUD_PROJECT_NUMBER="853886404171"
# Omit MEETING_BOT_API_KEY when using Vexa (Recall bot name "Worktual Notetaker" must not run)
# See docs/meeting-service-integration.md

# Meet Media worker (optional native path) — Developer Preview
# MEETING_ASSIST_LIVE_SOURCE="bot"   # bot (default) | meet_media | ask_only
# Live coach latency (~1.5 s Heard → suggested reply on clear questions)
# LIVE_ASSIST_MIN_GAP_MS=400
# LIVE_ASSIST_QUERY_DEBOUNCE_MS=80
# LIVE_ASSIST_AI_TIMEOUT_MS=12000
# LIVE_ASSIST_IMMEDIATE_SCORE=38
# LIVE_ASSIST_DRAFT_SCORE=38
# MEETING_BOT_API_KEY=""             # Recall.ai token (legacy; omit when NOTETAKER_PROVIDER=vexa)
# MEETING_BOT_API_BASE_URL="https://us-east-1.recall.ai/api/v1"
# MEETING_BOT_WEBHOOK_BASE_URL=""    # public HTTPS API origin for Recall webhooks
# MEETING_BOT_WEBHOOK_SECRET=""      # optional; send as x-meeting-bot-secret
# MEETING_BOT_DISPLAY_NAME="Worktual Assist"
# MEET_MEDIA_WORKER_URL="http://127.0.0.1:4010"
# MEET_MEDIA_WORKER_SECRET=""   # falls back to ENRICH_INTERNAL_SECRET
# CRM_API_PUBLIC_URL="http://127.0.0.1:4000"

# Each CRM employee's configured Google mailbox identifies that person in Meet.
# Tiles no connected mailbox recognizes are the customer. 0 = host name only, shadow = log only.
MEET_CHANNEL_BINDINGS=1

# Optional Redis pub/sub for multi-instance Assist event fan-out.
# REDIS_URL is the CRM cache. SIP registration, live call captions, and
# agent Ready/Not Ready presence use TRANSCRIPT_REDIS_URL when that is set,
# because the audio gateway and ACD read that Redis.
# REDIS_URL="redis://127.0.0.1:6379"
# SIP_REGISTRATION_DOMAIN="call.worktual.com"
# SIP_WSS_URL="wss://nlp-audiosgw.worktual.co.uk:57344"
# CALL_SERVER_TURN_URL="turn:audioturnv4.worktual.co.uk:3478"
# CALL_SERVER_TURN_URL_V6="turn:audioturnv6.worktual.co.uk:3478"
# CALL_SERVER_TURN_USERNAME="admin"
# CALL_SERVER_TURN_CREDENTIAL="system123"
# TRANSCRIPT_REDIS_URL=""
# If empty, call assist uses REDIS_URL. Set this to the audio-gateway Redis
# when REDIS_URL is the in-cluster cache (docker redis:6379).
# CRM_AGENT_PRESENCE_PUB="CRM_AGENT_PRESENCE_PUB"
# CRM_AGENT_PRESENCE_SUB="CRM_AGENT_PRESENCE_SUB"
# Agent SSE uses the same Redis for multi-instance fan-out.
# AGENT_SSE_HEARTBEAT_MS=15000
# Production process split: API sets both false; dedicated commands run each.
# CRON_SCHEDULER_ENABLED=true
# CRON_SCHEDULER_VERBOSE=false
# Disable only the periodic lead-nurture sweep (direct pipeline processing remains enabled).
# LEAD_NURTURE_CRON_ENABLED=true
# Dev laptops on the shared Worktual DB get a per-host cron lock automatically.
# Override only when debugging lock collisions on one machine:
# CRON_SCHEDULER_LOCK_ID="824673152019"
# AI_WORKER_ENABLED=true

# Post-meeting capture for lifecycle agents (bot primary; native webhooks backup)
# MEETING_CAPTURE_BOT_ENABLED=true
# MEETING_CAPTURE_BOT_DISPLAY_NAME="Worktual Notetaker"
# MEETING_CAPTURE_BOT_JOIN_SKEW_MINUTES=2
# MEETING_CAPTURE_MISSING_GRACE_HOURS=2
# MEETING_BOT_API_KEY=""
# MEETING_BOT_WEBHOOK_BASE_URL=""   # public HTTPS API origin for Recall
# MEETING_TRANSCRIPT_WEBHOOK_BASE_URL=""   # Teams Graph subscription base
# TEAMS_TRANSCRIPT_WEBHOOK_CLIENT_STATE=""
# GOOGLE_MEET_PUBSUB_VERIFICATION_TOKEN=""
# GOOGLE_MEET_TRANSCRIPT_HOST_USER_ID=""
# Google Calendar events.watch (HTTPS) + Gmail Pub/Sub push (same CRM webhook multiplexer).
# GCP example project: gmail-test-502808 — topic projects/gmail-test-502808/topics/Gmail_Mcp
# Push subscription mcp-push → POST .../api/webhooks/google-calendar/push (alias: .../gmail/push)
# GMAIL_PUBSUB_TOPIC="projects/gmail-test-502808/topics/Gmail_Mcp"
# GMAIL_PUBSUB_VERIFICATION_TOKEN=""
# ngrok the CRM API (:4000), then:
# CALENDAR_PUSH_WEBHOOK_URL="https://<ngrok>.ngrok-free.app/api/webhooks/google-calendar/push"
# Optional query token on calendar watch URL: CALENDAR_PUSH_VERIFICATION_TOKEN=""
# CRM_API_PUBLIC_URL="https://<ngrok>.ngrok-free.app"
# See docs/google-meet-scheduled-capture.md
# ZOOM_WEBHOOK_SECRET=""
# See docs/meeting-transcript-archive.md

