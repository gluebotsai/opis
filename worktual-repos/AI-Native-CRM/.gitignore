# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/frontend/node_modules
/backend/node_modules
/frontend/dist
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# production
/build
/out

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*.local
!.env.example
!.env*.example
deploy/.env
deploy/.env.images

# typescript
*.tsbuildinfo

# proposal corpus PDF storage (local)
/data/proposal-corpus/
backend/data/proposal-corpus/

# ai-service local envs
ai-service/.venv/
ai-service/.venv-py39/
ai-service/.deps/
ai-service/.pytest_cache/
ai-service/logs/
.dev-logs/
**/__pycache__/

# B2C handoff DB dump — share out of band, never commit
/db-dumps/

# Live DB dump used to rebuild reports schema docs (contains PII)
scripts/reports-schema-live.json

# Personal ngrok reserved domain (copy from ngrok.local.yml.example)
meeting-service/addons/google-meet/ngrok.local.yml
