# ai-service local settings (gitignored via .env pattern if configured)
# Copy values into a real .env — this documents keys only.
APP_ENV=development
HOST=0.0.0.0
PORT=8000
# Daily JSONL operational logs; durable receipts are retained separately.
AGENT_LOG_RETENTION_DAYS=5
ENRICH_INTERNAL_SECRET=
CRM_API_BASE_URL=http://127.0.0.1:4000
CORS_ORIGINS=http://localhost:3000

# Same CRM Postgres as Prisma (MCP writes crm.*; products via inventory.products).
# Prisma-style ?schema=crm is honored; search_path also includes inventory.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/worktual_bigint?schema=crm
# Optional: accounts DB for role lookups (defaults to DATABASE_URL)
ACCOUNT_DATABASE_URL=

# Dedicated MCP ASGI service (uvicorn app.mcp_main:app --port 8010).
MCP_BASE_URL=http://127.0.0.1:8010/mcp/v1
MCP_PREFER_HTTP=true
MCP_MOUNT_IN_API=true
# Required in production; identical only in Fastify and the MCP service.
MCP_EXECUTION_JWT_SECRET=
MCP_EXECUTION_JWT_ISSUER=worktual-crm-api
MCP_EXECUTION_JWT_AUDIENCE=worktual-crm-mcp
MCP_POLICY_VERSION=crm-modules-v1
# Compatibility is explicit and restricted to APP_ENV=development/test.
MCP_ALLOW_LEGACY_SECRET_AUTH=false
MCP_ALLOW_TEST_INPROCESS=false

# Native orchestrator STM. Disabled preserves client sessionMemory authority.
# When enabled, Redis keys are isolated by organization:user:conversation.
ORCHESTRATOR_STM_ENABLED=false
ORCHESTRATOR_REDIS_URL=redis://127.0.0.1:6379/0
ORCHESTRATOR_STM_TTL_SECONDS=86400
ORCHESTRATOR_STM_LOCK_TTL_SECONDS=15
ORCHESTRATOR_STM_MAX_BYTES=16384
# graceful keeps compatibility memory on Redis errors; closed rejects the run.
ORCHESTRATOR_STM_FAILURE_MODE=graceful

# Native coworker supervisor + bounded MCP loop. Both the switch and tenant/user
# allowlist are required; empty values keep the legacy crm_agent path.
COWORKER_NATIVE_ENABLED=false
COWORKER_NATIVE_ALLOWLIST=
COWORKER_NATIVE_DEADLINE_SECONDS=120

# Stable proactive/meeting route migration. Global switch plus optional
# comma-separated native allowlist; legacy allowlist always wins for rollback.
NAMED_AGENTS_NATIVE_ENABLED=false
NAMED_AGENTS_NATIVE_ALLOWLIST=
NAMED_AGENTS_LEGACY_ALLOWLIST=
NAMED_AGENTS_NATIVE_DEADLINE_SECONDS=120
NAMED_AGENTS_PROPOSAL_DEADLINE_SECONDS=240

# Safe operational guardrails (raise deliberately after observing metrics).
AGENT_GLOBAL_CONCURRENCY=64
AGENT_TENANT_CONCURRENCY=12
AGENT_REQUESTS_PER_MINUTE=240
DEPENDENCY_CIRCUIT_FAILURES=5
DEPENDENCY_CIRCUIT_RECOVERY_SECONDS=30
READINESS_REQUIRE_REDIS=false

# CRM A2A spoke (uvicorn app.a2a_main:app --port 8020).
# A2A_HUB_JWT_SECRET signs CRM-issued access JWTs. Hub authenticates /token with
# client_id/client_secret (also stored on accounts.a2a_spoke_clients).
A2A_PORT=8020
A2A_PUBLIC_URL=http://127.0.0.1:8020
HUB_A2A_URL=
HUB_A2A_TOKEN_URL=
HUB_A2A_SERVER_NAME=worktual-hub
HUB_A2A_CLIENT_ID=
HUB_A2A_CLIENT_SECRET=
HUB_A2A_SPOKE_LABEL=CRM
HUB_A2A_TIMEOUT_SECONDS=300
A2A_HUB_JWT_SECRET=
A2A_HUB_JWT_ISSUER=worktual-hub
A2A_HUB_JWT_AUDIENCE=worktual-crm-a2a
A2A_ACCESS_TOKEN_ISSUER=worktual-crm-a2a-access
A2A_SERVER_NAME=worktual-crm
A2A_SPOKE_CLIENT_ID=
A2A_SPOKE_CLIENT_SECRET=
A2A_ACCESS_TOKEN_TTL_SECONDS=21600
A2A_REFRESH_TOKEN_TTL_SECONDS=5184000
# Leftover domains CRM does not own (not Hub's skill catalog).
A2A_PEER_SKILL_TAGS=campaign,marketing,ccaas,service,cvm

# OpenAI-compatible LLM (worktual-qwen-27B — all agents except proposal learn/generate)
LLM_API_KEY=EMPTY
LLM_MODEL=worktual-qwen-27B
LLM_BASE_URL=http://81.17.61.149:8066/v1

# Proposal extract + generate only (native google-genai). Coworker stays on LLM_*.
# GEMINI_API_KEY is an alias for PROPOSAL_LLM_API_KEY. OpenAI-compat BASE_URL is unused here.
PROPOSAL_LLM_API_KEY=
GEMINI_API_KEY=
PROPOSAL_LLM_MODEL=gemini-3.5-flash
PROPOSAL_LLM_THINKING_LEVEL=high
PROPOSAL_LLM_BASE_URL=
# Social post images (Generate Posts). Reuses GEMINI_API_KEY.
SOCIAL_IMAGE_MODEL=gemini-3.1-flash-image-preview

# Reports domain agent (reports-analytics-agent): rpt.* warehouse + Neo4j graph
# Optional override; defaults to DATABASE_URL with readonly rpt search_path
REPORTS_WAREHOUSE_DATABASE_URL=
# Prefer REPORTS_* ; NEO4J_* (pack name) is also accepted as fallback
REPORTS_NEO4J_URI=bolt://127.0.0.1:7687
REPORTS_NEO4J_USER=neo4j
REPORTS_NEO4J_PASSWORD=
# NEO4J_URI=
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=
# Live pytest against rpt.* (test_kpi_execution, test_role_security)
REPORTS_WAREHOUSE_INTEGRATION=0

# Legacy gateways (unused by reports-analytics-agent after B2B pack rollout)
SEMANTIC_LAYER_GATEWAY_URL=http://82.113.92.44:8800
SEMANTIC_LAYER_PRODUCT=crm
ONTOLOGY_GATEWAY_URL=http://82.113.92.44:8000
ONTOLOGY_GATEWAY_TIMEOUT_S=90

# Knowledge base: POST /retrieve (domain_id + query) or legacy POST /search
KNOWLEDGE_BASE_URL=http://82.113.92.47:7051/search
KB_DOMAIN_ID=
KB_ORGANIZATION_ID=0000
KB_PRODUCT_ID=crm
KNOWLEDGE_BASE_TIMEOUT_S=12
KNOWLEDGE_BASE_JOB_TIMEOUT_S=45
KNOWLEDGE_BASE_PROBE_TIMEOUT_S=3

# llm = skip Semrush (estimates only). Default is Semrush seed + LLM related.
# SEO_KEYWORD_SOURCE=llm
SEMRUSH_MCP_ENABLED=false
SEMRUSH_GATEWAY_URL=http://173.234.75.165:8090
SEMRUSH_GATEWAY_TOKEN=

# ZoomInfo via Worktual gateway (search free; enrich = 1 data credit).
# Same token as Fastify; CRM never holds ZoomInfo OAuth secrets.
ZOOMINFO_GATEWAY_URL=http://173.234.75.165:8199
ZOOMINFO_GATEWAY_TOKEN=
