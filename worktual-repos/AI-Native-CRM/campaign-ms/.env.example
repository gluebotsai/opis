# Account database (my_account_qa) — login users only (read). Do not add campaign tables here.
ACCOUNT_DATABASE_URL="postgresql://postgres@localhost:5432/my_account_qa"

# Campaign database (campaign_db) — campaigns, branches, entitlements
CAMPAIGN_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campaign_db"
# Prisma reads DATABASE_URL; keep in sync with CAMPAIGN_DATABASE_URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campaign_db"

# Signed session cookie
SESSION_SECRET="change-me-in-production-campaign"

# Default tenant UUID (must match CRM organization_id / my_account users.organization_id)
DEFAULT_TENANT_ID="1000"

# Public URL for this service (CRM MARKETING_MS_URL should point here)
NEXT_PUBLIC_APP_URL="http://localhost:3001"
