  @@index([contactId, startedAt])
  @@index([organizationId, agent, startedAt])
  @@schema("crm")
  @@map("agent_step_events")
}

/// Last LLM input fingerprint per (org, agent, entity) — cron sweeps
/// (pipeline-forecast, collection-risk, revenue-gap, dunning, escalation,
/// score-decay, etc.) skip the LLM call when the input is unchanged since
/// the last run. See dao/ai/agent-input-fingerprint.ts.
model AgentInputFingerprint {
  id             String    @id @default(cuid())
  organizationId BigInt    @map("organization_id")
