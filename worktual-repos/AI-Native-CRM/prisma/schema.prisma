  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([organizationId, agent, entityType, entityId])
  @@index([organizationId, lastCheckedAt])
  @@schema("crm")
  @@map("agent_input_fingerprints")
}

