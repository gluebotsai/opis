  raw                Json?
  syncedAt           DateTime @default(now()) @map("synced_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, externalProjectId])
  @@index([organizationId, syncedAt])
  @@schema("crm")
  @@map("seo_projects")
}

/// Per-tool Semrush MCP payload for a project (query path reads this, not live MCP).
model SeoToolSnapshot {
  id                 String   @id @default(cuid())
  organizationId     BigInt   @map("organization_id")
  externalProjectId  String   @map("external_project_id")
  toolName           String   @map("tool_name")
  payload            Json?
  error              String?
  fetchedAt          DateTime @default(now()) @map("fetched_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, externalProjectId, toolName])
  @@index([organizationId, fetchedAt])
  @@schema("crm")
  @@map("seo_tool_snapshots")
}

/// SEO content packages saved from the Marketing → Digital Marketing agent.
model SeoGeneratedContent {
  id              String   @id @default(cuid())
  organizationId  BigInt   @map("organization_id")
  userId          BigInt?  @map("user_id")
  projectId       String?  @map("project_id")
  contentType     String   @map("content_type")
  title           String
  slug            String?
  seoScore        Int?     @map("seo_score")
  body            Json
  status          String   @default("draft")
  campaignId      String?  @map("campaign_id")
  primaryKeyword  String?  @map("primary_keyword")
  keywordQueryId  String?  @map("keyword_query_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([organizationId, updatedAt])
  @@index([organizationId, contentType])
  @@index([organizationId, keywordQueryId])
  @@schema("crm")
  @@map("seo_generated_content")
}

/// One Semrush keyword-research request per org/seed/locale (cached ≤ 31 days).
model SeoKeywordQuery {
  id              String    @id @default(cuid())
  organizationId  BigInt    @map("organization_id")
  userId          BigInt?   @map("user_id")
  seed            String
  location        String    @default("us")
  language        String    @default("en")
  filters         Json      @default("{}")
  cacheKey        String    @map("cache_key")
  semrushCalledAt DateTime? @map("semrush_called_at")
  expiresAt       DateTime  @map("expires_at")
  payload         Json      @default("[]")
  error           String?
  budgetSkipped   Boolean   @default(false) @map("budget_skipped")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([organizationId, cacheKey])
  @@index([organizationId, updatedAt])
  @@schema("crm")
  @@map("seo_keyword_queries")
}

/// User-starred keywords from a cached Semrush query.
model SeoSavedKeyword {
  id             String   @id @default(cuid())
  organizationId BigInt   @map("organization_id")
  queryId        String   @map("query_id")
  term           String
  metrics        Json     @default("{}")
  contentId      String?  @map("content_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, queryId, term])
  @@index([organizationId, updatedAt])
  @@schema("crm")
  @@map("seo_saved_keywords")
}

/// Platform-native social posts derived from master Digital Marketing content.
model SeoSocialPost {
  id                    String    @id @default(cuid())
  organizationId        BigInt    @map("organization_id")
  userId                BigInt?   @map("user_id")
  contentId             String?   @map("content_id")
  platform              String
  postType              String    @default("feed") @map("post_type")
  copy                  Json      @default("{}")
  status                String    @default("draft")
  scheduledAt           DateTime? @map("scheduled_at")
  publishedAt           DateTime? @map("published_at")
  externalPostId        String?   @map("external_post_id")
  lastError             String?   @map("last_error")
  accountsConnectionId  String?   @map("accounts_connection_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([organizationId, updatedAt])
  @@index([organizationId, contentId])
  @@schema("crm")
  @@map("seo_social_posts")
}

/// One inbound or outbound SIP call. Live writes come later.
model VoiceConversation {
  id              String    @id @default(cuid())
  organizationId  BigInt    @map("organization_id")
  userId          BigInt    @map("user_id")
  ext             String    @db.VarChar(32)
  /// inbound | outbound
  direction       String    @db.VarChar(16)
  /// ringing | rejected | missed | connected | ended | failed
  status          String    @db.VarChar(16)
  remoteNumber    String    @map("remote_number") @db.VarChar(32)
  remoteName      String?   @map("remote_name")
  /// X-Outbound-Number on an outbound call.
  callerId        String?   @map("caller_id") @db.VarChar(32)
  /// cdp.customer_profile.cdp_id when the number matches a contact.
  contactId       String?   @map("contact_id")
  sipCallId       String    @map("sip_call_id")
  startedAt       DateTime  @map("started_at")
  answeredAt      DateTime? @map("answered_at")
  endedAt         DateTime? @map("ended_at")
  durationSeconds Int?      @map("duration_seconds")
  /// hangup | remote_bye | rejected | busy | failed
  endReason       String?   @map("end_reason") @db.VarChar(32)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([organizationId, sipCallId])
  @@index([organizationId, userId, startedAt])
  @@index([organizationId, contactId, startedAt])
  @@schema("crm")
  @@map("voice_conversations")
}

/// Live phone-call transcript for the signed-in browser SIP call.
/// Lines arrive from the audio gateway; one call activity is written on hangup.
model CallTranscriptSession {
  id               String    @id @default(cuid())
  organizationId   BigInt    @map("organization_id")
  userId           BigInt    @map("user_id")
  ext              String    @db.VarChar(32)
  contactId        String    @map("contact_id")
  contactName      String?   @map("contact_name")
  /// Last 10 digits of the connected party, used to match gateway lines.
  remoteDigits     String    @map("remote_digits") @db.VarChar(32)
  /// inbound | outbound
  direction        String    @db.VarChar(16)
  gatewaySession   String?   @map("gateway_session_id")
  /// active | ended
  status           String    @db.VarChar(16)
  activityId       String?   @map("activity_id")
  /// hangup | remote_bye | failed
  endReason        String?   @map("end_reason") @db.VarChar(32)
  startedAt        DateTime  @default(now()) @map("started_at")
  endedAt          DateTime? @map("ended_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  chunks CallTranscriptChunk[]

  @@index([organizationId, status, ext, remoteDigits])
  @@index([userId, status])
  @@schema("crm")
  @@map("call_transcript_sessions")
}

model CallTranscriptChunk {
  id           String   @id @default(cuid())
  sessionId    String   @map("session_id")
  seq          Int
  speaker      String?
  isBot        Boolean  @default(false) @map("is_bot")
  text         String
  emotion      String?
  transcriptTm String?  @map("transcript_tm")
  raw          Json
  createdAt    DateTime @default(now()) @map("created_at")

  session CallTranscriptSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, seq])
  @@index([sessionId, transcriptTm])
  @@schema("crm")
  @@map("call_transcript_chunks")
}

/// cc-core nurture voice session. Transcript lines stay in ccass.*; this row is the join key.
model NurtureVoiceCall {
  id             String   @id @default(cuid())
  organizationId BigInt   @map("organization_id")
  /// cdp.customer_profile.cdp_id
  contactId      String   @map("contact_id")
  activityId     String   @map("activity_id")
  /// cc-core auto-bot-call session id (ccass.conversations.external_thread_id)
  sessionId      String   @unique @map("session_id")
  /// When CRM received the session id from cc-core.
  triggeredAt    DateTime @map("triggered_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([activityId])
  @@index([organizationId, contactId])
  @@schema("crm")
  @@map("nurture_voice_calls")
}
