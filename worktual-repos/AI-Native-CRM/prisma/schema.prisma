model Company {
  id             String   @id @default(cuid())
  organizationId BigInt   @map("organization_id")
  name           String
  domain         String?
  industry       String?
  employeeCount  Int?     @map("employee_count")
  linkedinUrl    String?  @map("linkedin_url")
  logoUrl        String?  @map("logo_url")
  ownerUserId    BigInt?  @map("owner_user_id")
  /// Channel hierarchy under the same tenant (franchise B2B2C).
  channelRole    CompanyChannelRole @default(standard) @map("channel_role")
  parentCompanyId String? @map("parent_company_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  /// Expansion & Revenue Matcher overlay (HITL): agent only flags a signal + drafts
  /// outreach talking points on closed-won deal history; never creates a deal/quote
  /// or contacts the company itself (human-only send).
  expansionSignal    String?   @map("expansion_signal") @db.VarChar(16)
  expansionReason    String?   @map("expansion_reason")
  expansionDraft     String?   @map("expansion_draft")
  expansionLastRunAt DateTime? @map("expansion_last_run_at")

  /// Company Collection Risk Agent overlay (HITL): aggregates this company's
  /// whole invoice payment history into a risk band. Flag only — agent never
  /// blocks/pauses the account.
  collectionRiskLevel    String?   @map("collection_risk_level") @db.VarChar(16)
  collectionRiskReason   String?   @map("collection_risk_reason")
  collectionRiskLastRunAt DateTime? @map("collection_risk_last_run_at")

  parentCompany   Company?  @relation("CompanyHierarchy", fields: [parentCompanyId], references: [id], onDelete: SetNull)
  childCompanies  Company[] @relation("CompanyHierarchy")
  locations       CompanyLocation[]
  deals           Deal[]
  orders          SalesOrder[]
  invoices        Invoice[]
  contracts       Contract[]
  contactProfiles ContactProfile[]

  @@index([name])
  @@index([createdAt])
  @@index([organizationId])
  @@index([organizationId, updatedAt])
  @@index([ownerUserId, updatedAt])
  @@index([organizationId, channelRole])
  @@index([parentCompanyId])
  @@index([organizationId, expansionSignal])
  @@index([organizationId, collectionRiskLevel])
  @@schema("crm")
  @@map("companies")
}

model CompanyLocation {
  id             String       @id @default(cuid())
  organizationId BigInt       @map("organization_id")
  companyId      String       @map("company_id")
  name           String
  type           LocationType @default(branch)
  address        String?
  city           String?
  industry       String?
  employeeCount  Int?         @map("employee_count")
  ownerUserId    BigInt?      @map("owner_user_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deals           Deal[]
  contactProfiles ContactProfile[]

  @@index([companyId])
  @@index([companyId, type])
  @@index([ownerUserId])
  @@index([organizationId])
  @@index([organizationId, companyId])
  @@schema("crm")
  @@map("company_locations")
}

/// CRM-only overlay for a CDP person (`account_contact_id` = `cdp.customer_profile.cdp_id`).
model ContactProfile {
  id               String   @id @default(cuid())
  /// CDP person key (`cdp.customer_profile.cdp_id` text).
  accountContactId String   @unique @map("account_contact_id")
  organizationId   BigInt   @map("organization_id")
  companyId        String?  @map("company_id")
  locationId       String?  @map("location_id")
  ownerUserId      BigInt?  @map("owner_user_id")
  /// User who created the CRM overlay. Distinct from owner (score-gated assignment).
  createdByUserId  BigInt?  @map("created_by_user_id")
  /// Assignment Agent ownership (score-gated route)
  assignmentReason String?  @map("assignment_reason")
  slaDeadline      DateTime? @map("sla_deadline")
  assignedAt       DateTime? @map("assigned_at")
  assignmentEscalated Boolean @default(false) @map("assignment_escalated")
  /// owner_notified | owner_reminded | manager_notified | admin_notified | acted
  assignmentFollowupStage String? @map("assignment_followup_stage") @db.VarChar(32)
  /// lead_status at assignment, so a later status change counts as action
  assignmentBaselineStatus String? @map("assignment_baseline_status") @db.VarChar(32)
  /// Nurturing Agent ownership overlay
  nurtureStatus    String?  @map("nurture_status") @db.VarChar(32)
  nurtureSequenceStep Int?  @map("nurture_sequence_step")
  nurtureStartedAt DateTime? @map("nurture_started_at")
  nurtureLastTouchAt DateTime? @map("nurture_last_touch_at")
  /// Lifecycle Agent review flag (ambiguous evidence / stall)
  flaggedForReview Boolean @default(false) @map("flagged_for_review")
  flagReason       String?  @map("flag_reason") @db.VarChar(500)
  lifecycleLastAction String? @map("lifecycle_last_action") @db.VarChar(64)
  lifecycleLastReason String? @map("lifecycle_last_reason")
  lifecycleLastRunAt DateTime? @map("lifecycle_last_run_at")
  leadSource       String?  @map("lead_source") @db.VarChar(128)
  leadStatus       String   @default("new") @map("lead_status") @db.VarChar(32)
  disqualifyReason String?  @map("disqualify_reason") @db.VarChar(64)
  bantBudget       Boolean? @map("bant_budget")
  bantAuthority    Boolean? @map("bant_authority")
  bantNeed         Boolean? @map("bant_need")
  bantTimeline     Boolean? @map("bant_timeline")
  /// Customer's own words when they named a budget, decision, need, or date.
  bantBudgetDetail    String? @map("bant_budget_detail") @db.VarChar(160)
  bantAuthorityDetail String? @map("bant_authority_detail") @db.VarChar(160)
  bantNeedDetail      String? @map("bant_need_detail") @db.VarChar(160)
  bantTimelineDetail  String? @map("bant_timeline_detail") @db.VarChar(160)
  convertedDealId  String?  @map("converted_deal_id")
  tags             String[] @default([])
  status           String   @default("active") @map("crm_status") @db.VarChar(32)
  notes            String?
  /// Compliance & Privacy Control Agent — durable marketing suppression.
  /// Enforced in lead-nurture-job.ts before any automated send.
  marketingOptOut   Boolean   @default(false) @map("marketing_opt_out")
  marketingOptOutAt DateTime? @map("marketing_opt_out_at")
  /// Vertical pack field values (CRM overlay — never CDP columns).
  customAttributes Json?    @map("custom_attributes")
  isPinned         Boolean  @default(false) @map("is_pinned")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  company  Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  location CompanyLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([leadStatus])
  @@index([status])
  @@index([companyId])
  @@index([locationId])
  @@index([ownerUserId, leadStatus])
  @@index([createdByUserId])
  @@index([isPinned, updatedAt])
  @@index([organizationId, updatedAt])
  @@index([organizationId, flaggedForReview])
  @@schema("crm")
  @@map("contact_profiles")
}

/// Buying role for a person on a company, and optionally on one deal.
model ContactBuyingRole {
  id             String   @id @default(cuid())
  organizationId BigInt   @map("organization_id")
  contactId      String   @map("contact_id")
  companyId      String   @map("company_id")
  dealId         String?  @map("deal_id")
  role           String   @db.VarChar(40)
  influence      String?  @db.VarChar(16)
  attitude       String?  @db.VarChar(16)
  /// confirmed | suggested | rejected
  status         String   @default("suggested") @db.VarChar(16)
  confidence     Float?
  evidence       String?
  /// user | ai
  source         String   @default("user") @db.VarChar(16)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([organizationId, companyId])
  @@index([organizationId, dealId])
  @@index([contactId])
  @@schema("crm")
  @@map("contact_buying_roles")
}

/// Person-to-person link inside a company. AI rows stay suggested until confirmed.
model ContactRelationship {
  id             String   @id @default(cuid())
  organizationId BigInt   @map("organization_id")
  companyId      String   @map("company_id")
  fromContactId  String   @map("from_contact_id")
  toContactId    String   @map("to_contact_id")
  /// reports_to | influences | former_colleague | introduced_by
  kind           String   @db.VarChar(32)
  strength       String?  @db.VarChar(16)
  /// confirmed | suggested | rejected
  status         String   @default("suggested") @db.VarChar(16)
  evidence       String?
  source         String   @default("user") @db.VarChar(16)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([organizationId, companyId])
  @@schema("crm")
  @@map("contact_relationships")
}

/// Optional CRM pack config. Tenant industry is accounts.organizations.industry_type.
model OrganizationProfile {
  organizationId  BigInt                 @id @map("organization_id")
  vertical        OrganizationVertical   @default(general)
  verticalConfig  Json                   @default("{}") @map("vertical_config")
  /// Auto-derived (or admin-entered) email domains treated as "internal" for
  /// this org — foundation for future Internal Meeting Assist routing.
  /// Derived from `setup_users.work_email` via `emailDomainType()`, excluding
  /// free/public providers (gmail, yahoo, outlook, ...).
  internalDomains          String[]  @default([]) @map("internal_domains")
  /// derived | manual | needs_manual — see backend/src/service/account/internal-domains.ts
  internalDomainsMode      String    @default("derived") @map("internal_domains_mode") @db.VarChar(16)
  /// Specific email addresses always treated as internal regardless of
  /// domain (alias/personal-email edge case), admin-entered only.
  internalDomainOverrides  String[]  @default([]) @map("internal_domain_overrides")
  internalDomainsUpdatedAt DateTime? @map("internal_domains_updated_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  @@schema("crm")
  @@map("organization_profiles")
}

model Deal {
  id                String    @id @default(cuid())
  organizationId    BigInt    @map("organization_id")
  title             String
  stage             DealStage @default(qualification)
  amount            Decimal?  @db.Decimal(12, 2)
  companyId         String    @map("company_id")
  locationId        String    @map("location_id")
  /// Optional CDP person key (`cdp.customer_profile.cdp_id`).
  contactId         String?   @map("contact_id")
  contactName       String?   @map("contact_name")
  contactEmail      String?   @map("contact_email")
  ownerUserId       BigInt?   @map("owner_user_id")
  notes             String?
  lostReason        String?   @map("lost_reason")
  expectedCloseDate DateTime? @map("expected_close_date")
  closedAt          DateTime? @map("closed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  /// Pipeline Forecast Auditor overlay — never mutates stage/expectedCloseDate itself.
  forecastCategory          String?   @map("forecast_category") @db.VarChar(32)
  forecastConfidencePercent Int?      @map("forecast_confidence_percent")
  forecastFlagged           Boolean   @default(false) @map("forecast_flagged")
  forecastReason            String?   @map("forecast_reason")
  forecastLastRunAt         DateTime? @map("forecast_last_run_at")

  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location   CompanyLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  activities DealActivity[]
  proposals  Proposal[]
  quotes     Quote[]
  orders     SalesOrder[]
  invoices   Invoice[]

  @@index([companyId])
  @@index([locationId])
  @@index([stage])
  @@index([stage, updatedAt])
  @@index([updatedAt])
  @@index([locationId, updatedAt])
  @@index([organizationId])
  @@index([organizationId, stage, updatedAt])
  @@index([ownerUserId, stage])
  @@index([companyId, stage])
  @@index([organizationId, forecastFlagged])
  @@schema("crm")
  @@map("deals")
}

model DealActivity {
  id              String       @id @default(cuid())
  organizationId  BigInt       @map("organization_id")
  dealId          String       @map("deal_id")
  type            ActivityType
  subject         String
  body            String?
  dueAt           DateTime?    @map("due_at")
  completedAt     DateTime?    @map("completed_at")
  createdByUserId BigInt?      @map("created_by_user_id")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@index([dealId, createdAt])
  @@index([organizationId])
  @@index([organizationId, dealId, createdAt])
  @@schema("crm")
  @@map("deal_activities")
}

/// Contact timeline rows. contactId is `cdp.customer_profile.cdp_id` (text).
model ContactActivity {
  id              String          @id @default(cuid())
  organizationId  BigInt          @map("organization_id")
  contactId       String          @map("contact_id")
  type            ActivityType
  folder          InboxFolder     @default(inbox)
  /// Groups replies into one conversation in the Inbox UI
  threadId        String?         @map("thread_id")
  gmailMessageId  String?         @unique @map("gmail_message_id")
  gmailThreadId   String?         @map("gmail_thread_id")
  /// Provider-agnostic message id (Gmail id or Graph message id) for dedupe
  providerMessageId String?       @unique @map("provider_message_id")
  /// Provider-agnostic conversation id (Gmail threadId or Graph conversationId)
  providerThreadId  String?       @map("provider_thread_id")
  mailProvider      MailProvider? @map("mail_provider")
  /// RFC Message-ID header — required for client-side reply threading
  rfcMessageId    String?         @map("rfc_message_id")
  emailDirection  EmailDirection? @map("email_direction")
  /// Set by the auto-reply agent when a human must answer (sensitive content)
  needsManualResponse Boolean     @default(false) @map("needs_manual_response")
  subject         String
  body            String?
  dueAt           DateTime?       @map("due_at")
  /// Task assignee (required for type=task)
  assigneeUserId  BigInt?         @map("assignee_user_id")
  /// Task workflow status (null for non-task activities). Overdue is derived.
  taskStatus      TaskStatus?     @map("task_status")
  /// Legacy 1-hour reminder flag (mirrored to reminder1hSentAt for back-compat)
  reminderSentAt  DateTime?       @map("reminder_sent_at")
  /// Set when the T−24h owner + customer reminder legs completed (or permanently skipped)
  reminder24hSentAt DateTime?     @map("reminder_24h_sent_at")
  /// Set when the T−1h owner + customer reminder legs completed (or permanently skipped)
  reminder1hSentAt  DateTime?     @map("reminder_1h_sent_at")
  /// Set when admins were escalated that this meeting was not conducted (no transcript)
  missEscalatedAt DateTime?       @map("miss_escalated_at")
  /// Set when Minutes of Meeting email was sent after transcript attach
  momSentAt       DateTime?       @map("mom_sent_at")
  /// Meeting / call transcript text once a provider (or manual upload) supplies it
  transcriptText     String?    @map("transcript_text")
  transcriptSource   String?    @map("transcript_source")
  transcriptAnalyzedAt DateTime? @map("transcript_analyzed_at")
  /// Extracted signals: intent, commitments, objections, BANT hints
  transcriptInsights Json?      @map("transcript_insights")
  /// Outcome word for this touch, written by the disposition agent. Not a fixed list.
  disposition     String?         @map("disposition") @db.VarChar(48)
  /// Hash of the text already judged, so the same transcript or email is not tagged again.
  dispositionTextHash String?    @map("disposition_text_hash") @db.VarChar(64)
  completedAt     DateTime?       @map("completed_at")
  createdByUserId BigInt?         @map("created_by_user_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@index([contactId])
  @@index([contactId, createdAt])
  @@index([folder, createdAt])
  @@index([threadId, createdAt])
  @@index([gmailThreadId])
  @@index([providerThreadId])
  @@index([type, dueAt, reminderSentAt])
  @@index([type, dueAt, reminder24hSentAt])
  @@index([type, dueAt, reminder1hSentAt])
  @@index([type, dueAt, missEscalatedAt])
  @@index([type, dueAt, momSentAt])
  @@index([assigneeUserId, taskStatus, dueAt])
  @@index([organizationId, contactId, createdAt])
  @@index([organizationId, folder, createdAt])
  @@schema("crm")
  @@map("contact_activities")
}

/// Per-user OAuth for Email (Gmail send) and Calendar. Lives in crm_qa only.
model UserIntegrationConnection {
  id             String              @id @default(cuid())
  organizationId BigInt              @map("organization_id")
  userId         BigInt              @map("user_id")
  provider       IntegrationProvider
  accountEmail   String?             @map("account_email")
  accessToken    String              @map("access_token")
  refreshToken   String?             @map("refresh_token")
  tokenExpiresAt DateTime?           @map("token_expires_at")
  scope          String?
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  @@unique([userId, provider])
  @@index([userId])
  @@index([organizationId])
  @@index([organizationId, userId])
  @@schema("crm")
  @@map("user_integration_connections")
}

enum SalesSeniorityTier {
  junior
  mid
  senior
  @@schema("crm")
}

/// Per-org sales assignment thresholds (deal-size → seniority routing).
model OrgAssignmentSettings {
  id                     String   @id @default(cuid())
  organizationId         BigInt   @unique @map("organization_id")
  seniorAmountThreshold  Int      @default(50000) @map("senior_amount_threshold")
  /// ICP knobs for Fit scoring: { targetIndustries, sizeTiers, serviceableGeos }
  leadIcp                Json?    @map("lead_icp")
  /// Admin reminder cadence. Null uses product defaults (hot/warm/cold).
  followupPolicy         Json?    @map("followup_policy")
  updatedByUserId        BigInt?  @map("updated_by_user_id")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@schema("crm")
  @@map("org_assignment_settings")
}

/// Per-org Finance billing policy, bank details, and gateway credentials.
model OrgFinanceSettings {
  id                     String   @id @default(cuid())
  organizationId         BigInt   @unique @map("organization_id")
  defaultPaymentTerms    String   @default("Net 30") @map("default_payment_terms")
  zeroAmountAutoPaid     Boolean  @default(true) @map("zero_amount_auto_paid")
  offlineReferenceMinLen Int      @default(4) @map("offline_reference_min_len")
  duplicateInvoiceGuard  Boolean  @default(true) @map("duplicate_invoice_guard")
  onlinePaymentsEnabled  Boolean  @default(true) @map("online_payments_enabled")
  /// { defaultProvider, rules: [{ currency, offlineOnlyAbove, allowedProviders }] }
  paymentRoutingRules    Json?    @map("payment_routing_rules")
  /// { accountName, bankName, accountNumber, ifsc, iban, swift, ... }
  bankDetails            Json?    @map("bank_details")
  invoiceNumberPrefix    String?  @map("invoice_number_prefix")
  invoiceNumberNextSeq   Int      @default(1) @map("invoice_number_next_seq")
  stripePublishableKey   String?  @map("stripe_publishable_key")
  stripeSecretKeyEnc     String?  @map("stripe_secret_key_enc")
  stripeWebhookSecretEnc String?  @map("stripe_webhook_secret_enc")
  razorpayKeyId          String?  @map("razorpay_key_id")
  razorpayKeySecretEnc   String?  @map("razorpay_key_secret_enc")
  razorpayWebhookSecretEnc String? @map("razorpay_webhook_secret_enc")
  /// Day of month (1–28) used for subscription billing cutoff scheduling.
  billingCutoffDay       Int      @default(20) @map("billing_cutoff_day")
  /// Days before contract end to create renewal deal.
  renewalWindowDays      Int      @default(30) @map("renewal_window_days")
  autoRenewDefault       Boolean  @default(false) @map("auto_renew_default")
  renewalQuoteAutoCreate Boolean  @default(true) @map("renewal_quote_auto_create")
  /// Revenue Gap Forecast Agent — optional admin-set targets. Both optional;
  /// the agent degrades to an at-risk-only summary when neither is set.
  revenueTargetMonthly    Decimal? @map("revenue_target_monthly") @db.Decimal(12, 2)
  revenueTargetQuarterly  Decimal? @map("revenue_target_quarterly") @db.Decimal(12, 2)
  /// Cached last forecast — { hasTarget, narrative, atRiskInvoiceIds, gapScenario, source }.
  revenueForecastLastRun   Json?     @map("revenue_forecast_last_run")
  revenueForecastLastRunAt DateTime? @map("revenue_forecast_last_run_at")
  updatedByUserId        BigInt?  @map("updated_by_user_id")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@schema("crm")
  @@map("org_finance_settings")
}

/// Per-org lead nurture policy (voice bot calls via cc-core).
model OrgNurtureSettings {
  id                      String   @id @default(cuid())
  organizationId          BigInt   @unique @map("organization_id")
  nurtureCallEnabled      Boolean  @default(false) @map("nurture_call_enabled")
  nurtureCallDelayMinutes Int      @default(15) @map("nurture_call_delay_minutes")
  updatedByUserId         BigInt?  @map("updated_by_user_id")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@schema("crm")
  @@map("org_nurture_settings")
}

/// Idempotency log for payment gateway webhooks.
model PaymentGatewayEvent {
  id              String                 @id @default(cuid())
  organizationId  BigInt                 @map("organization_id")
  provider        PaymentGatewayProvider
  externalEventId String                 @map("external_event_id")
  invoiceId       String?                @map("invoice_id")
  payload         Json?
  processedAt     DateTime               @default(now()) @map("processed_at")

  @@unique([provider, externalEventId])
  @@index([organizationId, processedAt])
  @@index([invoiceId])
  @@schema("crm")
  @@map("payment_gateway_events")
}

/// Per-rep CRM overlay for assignment capacity, PTO, tier, and territory.
model SalesUserAssignmentProfile {
  id              String              @id @default(cuid())
  organizationId  BigInt              @map("organization_id")
  userId          BigInt              @map("user_id")
  acceptingLeads  Boolean             @default(true) @map("accepting_leads")
  maxOpenDeals    Int?                @map("max_open_deals")
  seniorityTier   SalesSeniorityTier? @map("seniority_tier")
  onPtoUntil      DateTime?           @map("on_pto_until") @db.Date
  country         String?             @db.VarChar(128)
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@schema("crm")
  @@map("sales_user_assignment_profiles")
}

/// Common catalog for B2B, B2C, and B2B2C. Physical table is inventory.products
/// only — no crm.products view. DML on existing columns; ask inventory owners
/// before any field change.
model Product {
  id             String        @id @default(cuid())
  organizationId BigInt        @map("organization_id")
  name           String
  /// Short line shown on cards
  tagline        String?
  description    String?
  /// Full specifications / details (long text)
  specifications String?
  imageUrl       String?       @map("image_url")
  /// Extra image URLs (JSON string array)
  galleryUrls    Json?         @map("gallery_urls")
  /// Product page / PDP / datasheet. Not an image. Null = none.
  productUrl     String?       @map("product_url")
  sku            String?
  /// Retail / commerce merchandising (optional on B2B).
  brand          String?
  subcategory    String?
  /// Warehouse units. Null = not inventory-tracked (services, subscriptions).
  stockOnHand    Int?          @map("stock_on_hand")
  price          Decimal?      @db.Decimal(12, 2)
  /// Discount above this % on any quote line for this product requires Finance approval before send. Null = no cap.
  maxDiscountPercent Decimal?  @db.Decimal(5, 2) @map("max_discount_percent")
  currency       String        @default("USD")
  status         ProductStatus @default(draft)
  productType    ProductType   @default(fixed) @map("product_type")
  category       String?
  /// Comma-separated or freeform tags
  tags           String?
  billingType    ProductBillingType      @default(one_time) @map("billing_type")
  billingFrequency ProductBillingFrequency? @map("billing_frequency")
  unitOfMeasure  ProductUnitOfMeasure    @default(flat) @map("unit_of_measure")
  /// Legacy volume tiers on product (prefer Addon / AddonTier for customizable)
  pricingTiers   Json?         @map("pricing_tiers")
  /// Non-pricing industry labels/notes (not used for quote math).
  customAttributes Json?       @map("custom_attributes")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  addons           Addon[]
  offers           ProductOffer[]
  priceBookEntries PriceBookEntry[]
  quoteLines       QuoteLine[]
  orderLines       OrderLine[]
  invoiceLines     InvoiceLine[]

  @@index([name])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, sku])
  @@index([organizationId, productType])
  @@index([organizationId, brand])
  @@schema("inventory")
  @@map("products")
}

/// Named commercial package under a product (plan, edition, or usage pack).
model ProductOffer {
  id               String                    @id @default(cuid())
  organizationId   BigInt                    @map("organization_id")
  productId        String                    @map("product_id")
  name             String
  code             String?
  billingType      ProductBillingType?       @map("billing_type")
  billingFrequency ProductBillingFrequency?  @map("billing_frequency")
  includedQty      Int?                      @map("included_qty")
  meterKey         AddonMeterKey?            @map("meter_key")
  sortOrder        Int                       @default(0) @map("sort_order")
  status           ProductStatus             @default(active)
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")

  product          Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceBookEntries PriceBookEntry[]

  @@index([productId])
  @@index([organizationId])
  @@index([organizationId, productId])
  @@schema("crm")
  @@map("product_offers")
}

/// Org-level rate card (region / market / currency list).
model PriceBook {
  id             String   @id @default(cuid())
  organizationId BigInt   @map("organization_id")
  name           String
  code           String?
  currency       String   @default("USD")
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  entries PriceBookEntry[]

  @@index([organizationId])
  @@index([organizationId, isDefault])
  @@schema("crm")
  @@map("price_books")
}

/// List price for a product, offer, or addon within a price book (exactly one target).
model PriceBookEntry {
  id               String                   @id @default(cuid())
  organizationId   BigInt                   @map("organization_id")
  priceBookId      String                   @map("price_book_id")
  productId        String?                  @map("product_id")
  offerId          String?                  @map("offer_id")
  addonId          String?                  @map("addon_id")
  amount           Decimal                  @db.Decimal(12, 2)
  billingFrequency ProductBillingFrequency? @map("billing_frequency")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  priceBook PriceBook     @relation(fields: [priceBookId], references: [id], onDelete: Cascade)
  product   Product?      @relation(fields: [productId], references: [id], onDelete: Cascade)
  offer     ProductOffer? @relation(fields: [offerId], references: [id], onDelete: Cascade)
  addon     Addon?        @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@index([priceBookId])
  @@index([organizationId])
  @@index([productId])
  @@index([offerId])
  @@index([addonId])
  @@index([organizationId, priceBookId])
  @@schema("crm")
  @@map("price_book_entries")
}

/// Optional add-on sold with a customizable product (1:N).
model Addon {
  id             String            @id @default(cuid())
  organizationId BigInt            @map("organization_id")
  productId      String            @map("product_id")
  name           String
  unitLabel      String?           @map("unit_label")
  meterKey       AddonMeterKey?    @map("meter_key")
  isOverage      Boolean           @default(false) @map("is_overage")
  pricingModel   AddonPricingModel @map("pricing_model")
  flatPrice      Decimal?          @map("flat_price") @db.Decimal(12, 2)
  unitPrice      Decimal?          @map("unit_price") @db.Decimal(12, 4)
  stepSize       Int?              @map("step_size")
  stepPrice      Decimal?          @map("step_price") @db.Decimal(12, 2)
  sortOrder      Int               @default(0) @map("sort_order")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  product          Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  tiers            AddonTier[]
  invoiceLines     InvoiceLine[]
  priceBookEntries PriceBookEntry[]

  @@index([productId])
  @@index([organizationId])
  @@index([organizationId, productId])
  @@schema("crm")
  @@map("product_addons")
}

/// Quantity bands for tiered addon pricing.
model AddonTier {
  id             String   @id @default(cuid())
  organizationId BigInt   @map("organization_id")
  addonId        String   @map("addon_id")
  minQty         Int      @map("min_qty")
  maxQty         Int?     @map("max_qty")
  unitPrice      Decimal  @map("unit_price") @db.Decimal(12, 4)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  addon Addon @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@index([addonId])
  @@index([organizationId])
  @@index([organizationId, addonId])
  @@schema("crm")
  @@map("product_addon_tiers")
}

model ProposalTemplate {
  id             String                @id @default(cuid())
  organizationId BigInt                @map("organization_id")
  name           String
  code           String?
  kind           ProposalTemplateKind  @default(standard)
  /// Sections: [{ id, key, title, body, sortOrder }]
  sections       Json
  /// HTML brand blueprint: { version, html, css, theme, slots }
  blueprint      Json?
  /// Inline assets: [{ id, kind, mime, dataBase64 }]
  assets         Json?
  isDefault      Boolean               @default(false) @map("is_default")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  proposals Proposal[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, isDefault])
  @@schema("crm")
  @@map("proposal_templates")
}

model Proposal {
  id              String         @id @default(cuid())
  organizationId  BigInt         @map("organization_id")
  dealId          String         @map("deal_id")
  templateId      String?        @map("template_id")
  number          String
  title           String
  summary         String?
  /// Customer-specific section bodies after merge/edit
  sections        Json?
  /// Cloned HTML blueprint from template (layout stays fixed)
  blueprint       Json?
  /// Cloned assets from template
  assets          Json?
  /// Display name used in the document (company or contact)
  customerName    String?        @map("customer_name")
  version         Int            @default(1)
  status          ProposalStatus @default(draft)
  attachmentUrl   String?        @map("attachment_url")
  sharedAt        DateTime?      @map("shared_at")
  /// Human approval gate — send/share requires both fields non-null
  approvedByUserId BigInt?       @map("approved_by_user_id")
  approvedAt      DateTime?      @map("approved_at")
  approvalStatus  String         @default("drafting") @map("approval_status") @db.VarChar(32)
  createdByUserId BigInt?        @map("created_by_user_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  deal     Deal              @relation(fields: [dealId], references: [id], onDelete: Cascade)
  template ProposalTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  quotes   Quote[]
  generationRuns ProposalGenerationRun[]

  @@unique([organizationId, number, version])
  @@index([organizationId, dealId])
  @@index([organizationId, status, updatedAt])
  @@index([dealId])
  @@index([templateId])
  @@schema("crm")
  @@map("proposals")
}

/// Durable V2 generate job. Additive; unused when PROPOSAL_PIPELINE_V2 is off.
model ProposalGenerationRun {
  id                    String    @id @default(cuid())
  organizationId        BigInt    @map("organization_id")
  dealId                String    @map("deal_id")
  replacesProposalId    String?   @map("replaces_proposal_id")
  baseProposalUpdatedAt DateTime? @map("base_proposal_updated_at")
  pipelineVersion       Int       @default(2) @map("pipeline_version")
  proposalId            String?   @unique @map("proposal_id")
  actorUserId           String?   @map("actor_user_id")
  status                String    @default("queued") @db.VarChar(32)
  inputHash             String    @map("input_hash")
  promptVersion         String    @default("v2") @map("prompt_version")
  playbookId            String?   @map("playbook_id")
  contentPlaybookId     String?   @map("content_playbook_id")
  requirementText       String    @default("") @map("requirement_text")
  inputJson             Json?     @map("input_json")
  requirementProfile    Json?     @map("requirement_profile")
  kbSnapshot            Json?     @map("kb_snapshot")
  catalogSnapshot       Json?     @map("catalog_snapshot")
  dealPlan              Json?     @map("deal_plan")
  outline               Json?
  pricingSnapshot       Json?     @map("pricing_snapshot")
  pricingIssues         Json?     @map("pricing_issues")
  dealBrief             Json?     @map("deal_brief")
  qaReport              Json?     @map("qa_report")
  error                 Json?
  tokensIn              Int       @default(0) @map("tokens_in")
  tokensOut             Int       @default(0) @map("tokens_out")
  costEstimate          Decimal?  @map("cost_estimate") @db.Decimal(10, 4)
  startedAt             DateTime  @default(now()) @map("started_at")
  finishedAt            DateTime? @map("finished_at")
  heartbeatAt           DateTime? @map("heartbeat_at")
  claimedAt             DateTime? @map("claimed_at")
  nextRetryAt           DateTime? @map("next_retry_at")
  maxTokens             Int?      @map("max_tokens")
  expiresAt             DateTime? @map("expires_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  proposal Proposal?                 @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  leaves   ProposalGenerationLeaf[]

  @@index([organizationId, status])
  @@index([organizationId, inputHash])
  @@index([dealId, status])
  @@index([status, heartbeatAt])
  @@index([status, nextRetryAt])
  @@schema("crm")
  @@map("proposal_generation_runs")
}

model ProposalGenerationLeaf {
  id          String    @id @default(cuid())
  runId       String    @map("run_id")
  leafKey     String    @map("leaf_key")
  sectionType String    @default("") @map("section_type")
  title       String    @default("")
  wave        Int       @default(1)
  status      String    @default("pending") @db.VarChar(32)
  attempts    Int       @default(0)
  errorClass  String?   @map("error_class")
  nextRetryAt DateTime? @map("next_retry_at")
  outputJson  Json?     @map("output_json")
  modelUsed   String?   @map("model_used")
  latencyMs   Int?      @map("latency_ms")
  tokensIn    Int?      @map("tokens_in")
  tokensOut   Int?      @map("tokens_out")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  run ProposalGenerationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, leafKey])
  @@index([runId, status])
  @@index([status, nextRetryAt])
  @@schema("crm")
  @@map("proposal_generation_leaves")
}

model QuoteTemplate {
  id             String            @id @default(cuid())
  organizationId BigInt            @map("organization_id")
  name           String
  code           String?
  kind           QuoteTemplateKind @default(standard)
  /// Document sections: [{ id, key, title, body, sortOrder }]
  sections       Json
  /// HTML brand blueprint: { version, html, css, theme, slots }
  blueprint      Json?
  /// Inline assets: [{ id, kind, mime, dataBase64 }]
  assets         Json?
  isDefault      Boolean           @default(false) @map("is_default")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  quotes Quote[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, isDefault])
  @@schema("crm")
  @@map("quote_templates")
}

model Quote {
  id             String      @id @default(cuid())
  organizationId BigInt      @map("organization_id")
  dealId         String      @map("deal_id")
  /// Optional link when a quote was created from a proposal
  proposalId     String?     @map("proposal_id")
  /// Renewal quote linked to an existing contract (Phase 3).
  renewalContractId String?  @map("renewal_contract_id")
  templateId     String?     @map("template_id")
  number         String
  version        Int         @default(1)
  status         QuoteStatus @default(draft)
  currency       String      @default("USD")
  subtotal       Decimal     @default(0) @db.Decimal(12, 2)
  discountPct    Decimal     @default(0) @map("discount_pct") @db.Decimal(5, 2)
  total          Decimal     @default(0) @db.Decimal(12, 2)
  validUntil     DateTime?   @map("valid_until")
  notes          String?
  /// Customer-specific document sections after template merge/edit
  documentSections Json?     @map("document_sections")
  /// Cloned HTML blueprint from template
  blueprint      Json?
  /// Cloned assets from template
  assets         Json?
  customerName   String?     @map("customer_name")
  companyName    String?     @map("company_name")
  vendorName     String?     @map("vendor_name")
  sentAt         DateTime?   @map("sent_at")
  acceptedAt     DateTime?   @map("accepted_at")
  approvedByUserId BigInt?   @map("approved_by_user_id")
  approvedAt     DateTime?   @map("approved_at")
  approvalStatus String      @default("drafting") @map("approval_status") @db.VarChar(32)
  /// Finance approve/reject note (reject requires a reason).
  approvalNote   String?     @map("approval_note")
  createdByUserId BigInt?    @map("created_by_user_id")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  deal     Deal           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  proposal Proposal?      @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  template QuoteTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  lines    QuoteLine[]
  orders   SalesOrder[]

  @@unique([organizationId, number, version])
  @@index([organizationId, dealId])
  @@index([organizationId, status, createdAt])
  @@index([dealId])
  @@index([proposalId])
  @@index([renewalContractId])
  @@index([templateId])
  @@schema("crm")
  @@map("quotes")
}

model QuoteLine {
  id             String   @id @default(cuid())
  organizationId BigInt   @map("organization_id")
  quoteId        String   @map("quote_id")
  productId      String?  @map("product_id")
  name           String
  quantity       Decimal  @default(1) @db.Decimal(12, 2)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(12, 2)
  amount         Decimal  @db.Decimal(12, 2)
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([organizationId])
  @@index([organizationId, quoteId])
  @@schema("crm")
  @@map("quote_lines")
}

model SalesOrder {
  id             String      @id @default(cuid())
  organizationId BigInt      @map("organization_id")
  dealId         String?     @map("deal_id")
  quoteId        String?     @map("quote_id")
  /// Optional for B2C contact-first commerce orders.
  companyId      String?     @map("company_id")
  /// Consumer / contact on the order (B2C / B2B2C). CDP person key.
  contactId      String?     @map("contact_id")
  number         String
  status         OrderStatus @default(confirmed)
  currency       String      @default("USD")
  total          Decimal     @default(0) @db.Decimal(12, 2)
  confirmedAt    DateTime?   @map("confirmed_at")
  createdByUserId BigInt?    @map("created_by_user_id")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  deal     Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  quote    Quote?       @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  company  Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  lines    OrderLine[]
  invoices Invoice[]
  sourceContracts Contract[] @relation("ContractSourceOrder")

  @@unique([organizationId, number])
  @@index([organizationId, status, createdAt])
  @@index([companyId])
  @@index([dealId])
  @@index([contactId])
  @@schema("crm")
  @@map("sales_orders")
}

model OrderLine {
  id             String   @id @default(cuid())
  organizationId BigInt   @map("organization_id")
  orderId        String   @map("order_id")
  productId      String?  @map("product_id")
  name           String
  quantity       Decimal  @default(1) @db.Decimal(12, 2)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(12, 2)
  amount         Decimal  @db.Decimal(12, 2)
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  order   SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([organizationId])
  @@index([organizationId, orderId])
  @@schema("crm")
  @@map("order_lines")
}

model InvoiceTemplate {
  id             String              @id @default(cuid())
  organizationId BigInt              @map("organization_id")
  name           String
  code           String?
  kind           InvoiceTemplateKind @default(standard)
  /// Document sections: [{ id, key, title, body, sortOrder }]
  sections       Json
  /// HTML brand blueprint: { version, html, css, theme, slots }
  blueprint      Json?
  /// Inline assets: [{ id, kind, mime, dataBase64 }]
  assets         Json?
  isDefault      Boolean             @default(false) @map("is_default")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  invoices Invoice[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, isDefault])
  @@schema("crm")
  @@map("invoice_templates")
}

model Invoice {
  id              String        @id @default(cuid())
  organizationId  BigInt        @map("organization_id")
  /// Optional — set when invoice comes from quote accept / commerce order.
  orderId         String?       @map("order_id")
  /// Optional — set when Finance creates invoice from a deal.
  dealId          String?       @map("deal_id")
  companyId       String?       @map("company_id")
  templateId      String?       @map("template_id")
  number          String
  status          InvoiceStatus @default(draft)
  currency        String        @default("USD")
  total           Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount       Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)
  /// Global tax snapshot (IN GST / UK VAT / US sales tax components).
  taxDetails      Json?         @map("tax_details")
  issueDate       DateTime?     @map("issue_date")
  paymentTerms    String?       @map("payment_terms")
  notes           String?
  billingAddress  String?       @map("billing_address")
  leadEmail       String?       @map("lead_email")
  leadPhone       String?       @map("lead_phone")
  taxId           String?       @map("tax_id")
  dueAt           DateTime?     @map("due_at")
  paidAt          DateTime?     @map("paid_at")
  /// Customer-specific document sections after template merge/edit
  sections        Json?
  /// Cloned HTML blueprint from template
  blueprint       Json?
  /// Cloned assets from template
  assets          Json?
  approvedByUserId BigInt?      @map("approved_by_user_id")
  approvedAt      DateTime?     @map("approved_at")
  approvalStatus  String        @default("drafting") @map("approval_status") @db.VarChar(32)
  approvalNote    String?       @map("approval_note")
  billingKind     InvoiceBillingKind @default(standard) @map("billing_kind")
  submittedForApprovalAt DateTime? @map("submitted_for_approval_at")
  resubmittedAt   DateTime?     @map("resubmitted_at")
  paymentMethod   InvoicePaymentMethod? @map("payment_method")
  paymentReference String?      @map("payment_reference")
  paymentConfirmedByUserId BigInt? @map("payment_confirmed_by_user_id")
  paymentConfirmedAt DateTime?  @map("payment_confirmed_at")
  paymentProvider InvoicePaymentProvider? @map("payment_provider")
  paymentLinkUrl  String?       @map("payment_link_url")
  paymentSessionId String?      @map("payment_session_id")
  paymentSessionExpiresAt DateTime? @map("payment_session_expires_at")
  paymentSessionStatus InvoicePaymentSessionStatus? @map("payment_session_status")
  sentAt          DateTime?     @map("sent_at")
  lastSentAt      DateTime?     @map("last_sent_at")
  voidedAt        DateTime?     @map("voided_at")
  voidReason      String?       @map("void_reason")
  voidedByUserId  BigInt?       @map("voided_by_user_id")
  createdByUserId BigInt?       @map("created_by_user_id")
  /// Invoice Escalation Agent — collections-risk overlay. Agent only ever
  /// writes these four fields (+ notifications); never marks paid/void, never
  /// changes dueAt/total, never sends escalationDraft itself (human-only send).
  escalationSeverity  String?   @map("escalation_severity") @db.VarChar(16)
  escalationReason    String?   @map("escalation_reason")
  escalationDraft     String?   @map("escalation_draft")
  escalationLastRunAt DateTime? @map("escalation_last_run_at")
  /// Invoice Dunning Agent — staged reminder->warning->pause_notice cadence.
  /// Agent only ever writes these three fields (+ notifications); draft only,
  /// a human always reviews and sends (same HITL rule as escalation above).
  dunningStage       String    @default("none") @map("dunning_stage") @db.VarChar(16)
  dunningStageSentAt DateTime? @map("dunning_stage_sent_at")
  dunningDraft       String?   @map("dunning_draft")
  contractId      String?       @map("contract_id")
  billingScheduleId String?     @map("billing_schedule_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  order    SalesOrder?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  deal     Deal?            @relation(fields: [dealId], references: [id], onDelete: SetNull)
  company  Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  template InvoiceTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  contract Contract?        @relation(fields: [contractId], references: [id], onDelete: SetNull)
  billingSchedule ContractBillingSchedule? @relation(fields: [billingScheduleId], references: [id], onDelete: SetNull)
  lines    InvoiceLine[]

  @@unique([organizationId, number])
  @@index([organizationId, status, createdAt])
  @@index([companyId])
  @@index([orderId])
  @@index([dealId])
  @@index([contractId])
  @@index([billingScheduleId])
  @@index([templateId])
  @@index([organizationId, escalationSeverity])
  @@index([organizationId, dunningStage])
  @@schema("crm")
  @@map("invoices")
}

model InvoiceLine {
