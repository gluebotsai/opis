// CRM transactional models live in crm_qa (DATABASE_URL), including inbox
// activities, Google email/calendar OAuth (user_integration_connections), and
// contact_profiles (CRM fields for shared account contacts).
// my_account_qa (ACCOUNT_DATABASE_URL): auth + shared person contacts only
// (accessed via the pg account pool — not Prisma). CRM must not store
// product-specific fields on my_account_qa.public.contacts.
//
// PARALLEL B2B/B2C WORK: high-touch shared file — both business-type tracks
// edit this schema. Coordinate before adding/changing models here, log the
// change in docs/parallel-work-log.md, and validate the merged
// prisma/migrations/ folder on a throwaway DB before deploying to the shared
// worktual_bigint DB. See docs/merge-validation-checklist.md.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["crm", "inventory"]
}

