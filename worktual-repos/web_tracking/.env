# Web Tracking Platform — local dev (production DNS map: see .env.example)

# QA DNS (production server IP: 82.113.92.44)
# qatracking.worktual.com        → 7862  /
# qatrackingapi.worktual.com/api/ → 7861
# qatrackingapi.worktual.com/webtracking/ → 7860  (ingest)
# qatrackingapi.worktual.com/chat/ → 7863

# PostgreSQL (auth + config)
DATABASE_URL=postgresql://nlp:nLpTeam%40561@10.180.0.126:5432/worktual_bigint?schema=public
DB_HOST=10.180.0.126
DB_PORT=5432
DB_NAME=worktual_bigint
DB_USER=nlp
DB_PASSWORD=nLpTeam@561
DB_SCHEMA=public
POSTGRES_READ_ONLY=true

# ClickHouse dictionary → PostgreSQL (domain validation for ingest)
CH_DICT_PG_HOST=10.180.0.126
CH_DICT_PG_PORT=5432
CH_DICT_PG_DB=worktual_bigint
CH_DICT_PG_USER=ch_sync
CH_DICT_PG_PASSWORD=Click1234
CH_DICT_PG_SCHEMA=public
CH_DICT_PG_TABLE=v_web_tracking_ingest_registry

# ClickHouse (analytics events)
CLICKHOUSE_HOST=10.180.0.126
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=worktual@567
CLICKHOUSE_DATABASE=web_tracking

# Redis (optional API cache)
# REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL_SECONDS=120

# Service ports
INGEST_PORT=7860
API_PORT=7861
WEB_PORT=7862
AI_CHAT_PORT=7863
SDK_PORT=7864
SERVICE_HOST=0.0.0.0


# Ingest (direct: python etl/run_ingest.py)
# Max request body: events 512 KiB (INGEST_MAX_BODY_BYTES), replay chunks 2 MiB (INGEST_MAX_REPLAY_BODY_BYTES)
INGEST_MAX_REPLAY_BODY_BYTES=2097152
# Write path: direct (ClickHouse only), kafka (Kafka only), dual (both — QA verification)
INGEST_WRITE_MODE=kafka
# Kafka (when INGEST_WRITE_MODE=kafka or dual)
KAFKA_BOOTSTRAP_SERVERS=192.168.13.207:9092
# KAFKA_BOOTSTRAP_SERVERS=82.113.92.45:9092
KAFKA_TOPIC=cdp.ingestion.webtracking
KAFKA_CLIENT_ID=webtracking-ingest
KAFKA_CONSUMER_GROUP=webtracking-ch-writer
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# Visitor IP: SDK fetches https://getip.worktual.co.uk/ and sends clientIp on payloads
IP_HASH_SALT=change-me-in-production
GEOIP_HTTP_FALLBACK=true


CDP_CDC_KAFKA_BOOTSTRAP_SERVERS=10.180.0.126:9092
CDP_CDC_KAFKA_TOPIC_CUSTOMER_PROFILE=cdc.cdp.customer_profile
CDP_CDC_KAFKA_TOPIC_IDENTITY_KEYS=cdc.cdp.identity_keys




INSIGHTS_INTERNAL_KEY=wk_insights_a8f3k2m9x7p4q1
AI_CHAT_INSIGHTS_URL=http://127.0.0.1:7863/insights/generate
INSIGHTS_CACHE_TTL_SECONDS=600


# Analytics API (Node + AI Chat JWT)
API_SECRET_KEY=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=https://qatracking.worktual.com,https://qatracking.worktual.co.uk,http://localhost:7862

# AI Chat — leave VITE_AI_CHAT_WS_URL unset so the browser uses same-origin
# wss://<dashboard-host>/chat/ws/chat (proxied by Vite → AI_CHAT :7863).
# Only set this if you proxy chat on qatrackingapi instead:
# VITE_AI_CHAT_WS_URL=wss://qatrackingapi.worktual.com/chat/ws/chat
AI_CHAT_HOST=0.0.0.0
LLM_API_KEY=
LLM_MODEL_NAME=gpt-oss-120b
LLM_BASE_URL=http://173.234.75.166:8003/v1

# Frontend (VITE_* baked at build time)
# VITE_API_URL=http://localhost:7861
# Production: VITE_API_URL=https://qatrackingapi.worktual.com
