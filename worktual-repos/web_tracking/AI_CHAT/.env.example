# AI Analytics Chat — standalone environment (copy to AI_CHAT/.env)
#
# Deploy this service on its own server/process. The API login service signs JWTs;
# this service only verifies them — API_SECRET_KEY MUST match the API exactly.

# ClickHouse (read-only analytics queries)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
# ClickHouse analytics database (SQL name: web_tracking — Worktual Web Analytics)
CLICKHOUSE_DATABASE=web_tracking

# JWT (must match api/ login service)
API_SECRET_KEY=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256

# Service
AI_CHAT_HOST=0.0.0.0
AI_CHAT_PORT=7863
AI_CHAT_LOG_LEVEL=INFO
AI_CHAT_SQL_TIMEOUT=30
AI_CHAT_SQL_MAX_ROWS=500
AI_CHAT_SCHEMA_CACHE_TTL=600

# LLM
LLM_API_KEY=
LLM_MODEL_NAME=gpt-oss-120b
LLM_BASE_URL=http://173.234.75.166:8003/v1

# Internal insights route (must match api-node INSIGHTS_INTERNAL_KEY)
INSIGHTS_INTERNAL_KEY=change-me-insights-internal-key

# Worktual Context Layer (ontology + semantic). 195.168.11.25 timed out; 192 is live.
CONTEXT_LAYER_URL=http://192.168.11.25:8765
CONTEXT_LAYER_TIMEOUT=20

# Co-worker MAS: set to 1 for a third LLM pass to polish answers (slower).
# AI_CHAT_LLM_REPLY=0

# Turn audit JSON lines (default: AI_CHAT/logs/coworker-turn-YYYY-MM-DD.log)
# AI_CHAT_TURN_LOG_DIR=/home/you/CURSOR/cursor_session_sep_8_live/AI_CHAT/logs

# Optional: restrict browser origins (comma-separated). Empty = allow all.
# AI_CHAT_CORS_ORIGINS=https://analytics.example.com
