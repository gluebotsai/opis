# Web Tracking Platform — copy to .env

# =============================================================================
# QA DNS mapping (server IP: 82.113.92.44)
# Reverse proxy routes public hostname + path → internal port
# =============================================================================
#
# qatracking.worktual.com  → 7862  Frontend
#   /                      Dashboard SPA
#   /webtracking.min.js    SDK script (static)
#
# qatrackingapi.worktual.com
#   /api/*                 → 7861  Backend API
#   /webtracking/*         → 7860  Ingest (strip /webtracking when forwarding)
#   /chat/*                → 7863  AI Chat (WebSocket)
#
# Ingest production flow:
#   Browser → https://qatrackingapi.worktual.com/webtracking/v1/tracking/nfs-ingestions
#          → python etl/run_ingest.py :7860 → ClickHouse
# =============================================================================

# PostgreSQL (auth + config)
# URL-encode special characters in password (@ -> %40) when using DATABASE_URL
DATABASE_URL=postgresql://nlp:your_password@10.180.0.126:5432/worktual_bigint?schema=public
DB_HOST=10.180.0.126
DB_PORT=5432
DB_NAME=worktual_bigint
DB_USER=nlp
DB_PASSWORD=your_password
DB_SCHEMA=accounts
POSTGRES_READ_ONLY=true
# Login: accounts.setup_users (work_email) + setup_user_product_access (WEB_TRACKING_REFERENCE.md §12)
AUTH_SOURCE=my_accounts

# ClickHouse dictionary → PostgreSQL (website validation for ingest)
# Source: public.v_web_tracking_ingest_registry (My Accounts JSON — not admin_accounts)
CH_DICT_PG_HOST=10.180.0.126
CH_DICT_PG_PORT=5432
CH_DICT_PG_DB=worktual_bigint
CH_DICT_PG_USER=ch_sync
CH_DICT_PG_PASSWORD=your_password
CH_DICT_PG_SCHEMA=public
CH_DICT_PG_TABLE=v_web_tracking_ingest_registry

# ClickHouse (analytics events)
CLICKHOUSE_HOST=10.180.0.126
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your_password
CLICKHOUSE_DATABASE=web_tracking

# Redis (api-node cache + live presence; ingest must use same REDIS_URL for live writes)
# Comment out REDIS_URL to use ClickHouse-only Live Users (poll + fact_page_views / events_staging).
# Local (Redis on same host as ingest + api-node):
REDIS_URL=redis://127.0.0.1:6379
# Remote QA example (nlp-crm app -> dedicated Redis; encode @ in password as %40):
# REDIS_URL=redis://:qaR3d15%409244@82.113.92.44:6379
REDIS_CACHE_TTL_SECONDS=120
# Live Users hot path (ingest writes, api-node reads; window matches UI "Last 5 minutes")
LIVE_PRESENCE_ENABLED=true
LIVE_PRESENCE_TTL_SECONDS=300
INGEST_FAST_ACK=true

# Service ports
INGEST_PORT=7860
API_PORT=7861
WEB_PORT=7862
AI_CHAT_PORT=7863
SDK_PORT=7864
SERVICE_HOST=0.0.0.0

# Ingest (direct: python etl/run_ingest.py)
# Max request body: events 512 KiB (INGEST_MAX_BODY_BYTES), replay chunks 2 MiB (INGEST_MAX_REPLAY_BODY_BYTES)
INGEST_MAX_REPLAY_BODY_BYTES=2097152
# Write path (see docs/REDIS_LIVE_PRESENCE.md):
#   kafka  — CDP consumes Kafka; CH via consumer only (Live Users without Redis = consumer lag).
#   dual   — Kafka for CDP + direct CH on ingest (same payloadId; consumer skips duplicate CH row).
#   direct — CH only; no Kafka (do not use if CDP reads Kafka).
# QA production (CDP + faster Live Users without Redis): INGEST_WRITE_MODE=dual
INGEST_WRITE_MODE=dual
# Kafka (required when INGEST_WRITE_MODE=kafka or dual)
KAFKA_BOOTSTRAP_SERVERS=192.168.13.207:9092
KAFKA_TOPIC=cdp.ingestion.webtracking
KAFKA_CLIENT_ID=webtracking-ingest
KAFKA_CONSUMER_GROUP=webtracking-ch-writer
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# Visitor IP: SDK fetches https://getip.worktual.co.uk/ and sends clientIp on payloads
IP_HASH_SALT=change-me-in-production
GEOIP_HTTP_FALLBACK=true
GEOIP_DB_PATH=

# GPS reverse geocode (lat/lon → city, region, country when visitor grants location)
REVERSE_GEOCODE_ENABLED=true
REVERSE_GEOCODE_URL=https://nominatim.openstreetmap.org/reverse
REVERSE_GEOCODE_USER_AGENT=WorktualWebTracking/1.0 (contact: support@worktual.com)
REVERSE_GEOCODE_TIMEOUT=5

# Analytics API (Node + AI Chat JWT)
API_SECRET_KEY=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=https://qatracking.worktual.com
# Local dev: CORS_ORIGINS=https://qatracking.worktual.com,http://localhost:7862
# Ingest API — cross-origin SDK from customer sites (default * in code if unset)
INGEST_CORS_ORIGINS=*
# My Accounts → dashboard SSO (Campaign-style: x-internal-service-key header)
INTERNAL_SERVICE_KEY=
DASHBOARD_PUBLIC_URL=https://qatracking.worktual.com
ONBOARDING_CODE_TTL_SECONDS=600

# AI Chat
AI_CHAT_HOST=0.0.0.0
VITE_AI_CHAT_WS_URL=wss://qatrackingapi.worktual.com/chat/ws/chat
# Local dev: VITE_AI_CHAT_WS_URL=ws://localhost:7863/ws/chat
LLM_API_KEY=
LLM_MODEL_NAME=gpt-oss-120b
LLM_BASE_URL=http://173.234.75.166:8003/v1

# Worktual Context Layer (AI_CHAT ontology + semantic)
CONTEXT_LAYER_URL=http://192.168.11.25:8765
CONTEXT_LAYER_TIMEOUT=20

# Analytics insights (api-node → AI_CHAT internal route)
INSIGHTS_INTERNAL_KEY=change-me-insights-internal-key
AI_CHAT_INSIGHTS_URL=http://127.0.0.1:7863/insights/generate
INSIGHTS_CACHE_TTL_SECONDS=600
# Bounce rate: view (default) uses ClickHouse v_session_bounce; facts = inline CTE before CH migration
BOUNCE_QUERY_SOURCE=view

# Frontend (VITE_* baked at build time)
# Comma-separated Host headers nginx/docker may send to Vite (fixes "host is not allowed").
VITE_ALLOWED_HOSTS=qatracking.worktual.com,backend_qatracking,.worktual.com
VITE_LOGO_URL=https://qatracking.worktual.com/logo.png
# Split-host production build: VITE_API_URL=https://qatrackingapi.worktual.com
# Local dev: VITE_LOGO_URL=/logo.png
VITE_DASHBOARD_REFRESH_MS=30000
# Live Users poll when API presence_source=redis (default 3s); fallback when ClickHouse (default 10s)
# Live Users poll (ms): Redis path uses first value; ClickHouse fallback uses _FALLBACK or same as first
VITE_LIVE_USERS_REFRESH_MS=3000
VITE_LIVE_USERS_REFRESH_MS_FALLBACK=3000
VITE_VISITORS_REFRESH_MS=15000
VITE_SESSION_REPLAY_REFRESH_MS=10000
# Local UI-only work (dev server): login page shows "Preview UI locally (no API)"
# VITE_DEV_UI_PREVIEW=true

# Public URLs (SDK embed + admin install snippet)
INGEST_PUBLIC_URL=https://qatrackingapi.worktual.com/webtracking/v1/tracking/nfs-ingestions
SDK_PUBLIC_URL=https://qatracking.worktual.com
# Campaign email click attribution — must match Campaign backend WEB_TRACKING_HMAC_SECRET exactly.
# Set on customer site via WorktualAnalytics.init({ webTrackingHmacSecret: '...' }) — do not commit prod values.
# Generate: openssl rand -base64 32
# WEB_TRACKING_HMAC_SECRET=
# Full SDK script URL for dashboard install snippet (production CDN v3):
SDK_SCRIPT_URL=https://nlp-storage.worktual.co.uk/wsnlp/Web_Tracking/JavaScript_sdk/sdk/v1/web_tracking_v3.js
# Production ingest: INGEST_PUBLIC_URL=https://tracking.worktual.co.uk/webtracking/v1/tracking/nfs-ingestions
# Local dev: INGEST_PUBLIC_URL=http://localhost:7860/v1/tracking/nfs-ingestions
# Local dev: SDK_PUBLIC_URL=http://localhost:7864
