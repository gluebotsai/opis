{
  "name": "my-accounts-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "stop-frontend":"kill $(lsof -nP -iTCP:5173 -sTCP:LISTEN -t)",
    "start:source": "tsx src/server.ts",
    "worker": "node dist/worker.js",
    "worker:source": "tsx src/worker.ts",
    "migrate": "tsx src/cli/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:route-parity": "node scripts/check-fastify-route-parity.mjs",
    "test:typescript-layout": "node scripts/check-typescript-layout.mjs",
    "smoke:api": "tsx scripts/smoke-test-api.mjs",
    "smoke:customer-branch-add": "tsx scripts/smoke-test-customer-branch-add-request.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1094.0",
    "@azure/msal-node": "^5.4.0",
    "@fastify/compress": "^8.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/jwt": "^9.0.0",
    "@fastify/sensible": "^6.0.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.0.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "5.1.1",
    "bullmq": "^5.79.3",
    "date-fns": "^4.4.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "fastify-raw-body": "^5.0.0",
    "imapflow": "^1.0.184",
    "ioredis": "^5.11.1",
    "jspdf": "2.5.2",
    "jspdf-autotable": "3.8.4",
    "mailparser": "^3.7.2",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "pino": "^9.0.0",
    "socket.io": "^4.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.0.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
