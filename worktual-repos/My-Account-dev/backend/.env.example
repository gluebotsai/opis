# Mail API server port (default: 3001)
MAIL_API_PORT=3001

# PostgreSQL (local)
# 1. Install Postgres and create a database + user, e.g.:
#      createdb worktual_accounts
#      createuser worktual -P
# 2. Copy this file to .env and set DATABASE_URL to match your local credentials.
# 3. Run `pnpm dev` — schema + seed data apply automatically on mail-api startup.
DATABASE_URL=postgresql://worktual:worktual_secret_change_me@localhost:5432/worktual_accounts
POSTGRES_DB=worktual_accounts
POSTGRES_USER=worktual
POSTGRES_PASSWORD=worktual_secret_change_me

# Optional: point Vite /api proxy at a remote mail-api (default: http://127.0.0.1:3001)
# VITE_API_PROXY=http://127.0.0.1:3001

# Redis (BullMQ jobs, SSE pub/sub, rate limits, distributed locks)
# Local: docker compose up -d redis
REDIS_URL=redis://localhost:6379

# Skip automatic migrations on API boot (run `pnpm migrate` in deploy pipeline)
# SKIP_MIGRATE_ON_BOOT=true

# Database pool size per API instance
# DB_POOL_MAX=20

# Public API URL for Microsoft Graph webhook callbacks (defaults to APP_URL with API port)
# MAIL_API_PUBLIC_URL=http://localhost:3002

# Production object storage for quotation PDFs (optional — falls back to local disk in dev)
# S3_BUCKET=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Extra CORS origins in production (comma-separated full URLs)
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com

# Node environment
# NODE_ENV=production

# --- Logins ---
# Outbound mail From addresses (except admin) come from DB users + connected Microsoft Outlook.
# Create sales / finance / sales_admin users under Admin → User credentials, then connect Outlook.

# Finance login seed (bootstrap only — not used as mail From)
FINANCE_LOGIN_EMAIL=finance@example.com
FINANCE_LOGIN_PASSWORD=change-me

# Admin login + admin outbound From (ONLY role whose mailbox identity is taken from .env)
# Password-reset OTP emails are sent From ADMIN_EMAIL (or ADMIN_LOGIN_EMAIL).
# Preferred: admin user connects Microsoft Outlook once (delegated token).
# Unattended (no admin signed in): set MS_APP_TENANT_ID and grant Azure Application
# permission Mail.Send + admin consent so OTP can send via Graph client credentials.
# Platform admin cannot use Forgot password (UI still shows success; no OTP is sent).
ADMIN_LOGIN_EMAIL=admin@worktual.com
ADMIN_LOGIN_PASSWORD=change-me
ADMIN_EMAIL=admin@worktual.com

# Sales login seed (bootstrap only — not used as mail From)
SALES_LOGIN_EMAIL=sales@example.com
SALES_LOGIN_PASSWORD=change-me

# Sales admin login seed (bootstrap only — not used as mail From)
# SALES_ADMIN_LOGIN_EMAIL=
# SALES_ADMIN_LOGIN_PASSWORD=

MAIL_DRY_RUN=false
# After changing mail env (MS_APP_TENANT_ID, MS_CERT_THUMBPRINT, MS_PRIVATE_KEY_PATH), restart the mail API.
# Forgot password UI: restart both Vite + mail API after client fixes; use a real non-admin login email.
# Confirm API log shows "[password-reset] otp sent …" (not "skipped reason=not_found").
# Expect admin Sent Items subject: "Your Worktual password reset code"
# Platform admin / unknown emails still return ok without sending (anti-enumeration).
# Live OTP Graph smoke (sends a real email): LIVE_OTP_SMOKE=1 node scripts/smoke-test-password-reset-live.mjs
# Dry-run OTP logic smoke (no real email): node scripts/smoke-test-password-reset.mjs

# Microsoft Graph OAuth (Outlook mail — per-user sign-in)
# Register app in Azure Entra ID. Redirect URI must match MS_REDIRECT_URI exactly.
# Either path works (both are handled by the mail API):
#   http://localhost:3002/api/mail/oauth/callback
#   http://localhost:3002/auth/microsoft/callback
MS_CLIENT_ID=
# Certificate auth (recommended): upload certificate.cer in Azure → Certificates & secrets
MS_CERT_THUMBPRINT=
# Path must exist relative to the API process (or use an absolute path).
MS_PRIVATE_KEY_PATH=./certs/privatekey.pem
# Legacy client-secret auth (optional fallback if certificate vars are not set)
MS_CLIENT_SECRET=
# Use "common" for multitenant SaaS (recommended). Use your Directory (tenant) ID only if the app
# is registered inside that one Entra ID directory (single-tenant).
# If MS_TENANT_ID=common, you MUST still set MS_APP_TENANT_ID to the directory GUID for OTP mail.
MS_TENANT_ID=common
# Directory (tenant) ID where the app is registered — required for admin consent links
# and for unattended (app-only) mail such as password-reset OTP.
# Copy from Azure → App registration → Overview → Directory (tenant) ID.
# Azure checklist for unattended OTP:
#   1) API permissions → Application → Mail.Send → Grant admin consent
#   2) ADMIN_EMAIL is a real mailbox in that tenant
#   3) MAIL_DRY_RUN=false and restart the API after env changes
MS_APP_TENANT_ID=
MS_REDIRECT_URI=http://localhost:3002/auth/microsoft/callback
# Leave empty. App builds https://login.microsoftonline.com/{MS_TENANT_ID} automatically.
MS_AUTHORITY=
# Optional: include Mail.ReadWrite (often requires admin consent)
MS_GRAPH_INCLUDE_READWRITE=false
# Optional: dedicated 32-byte key for encrypting stored refresh tokens (hex or passphrase)
MS_TOKEN_ENCRYPTION_KEY=

# Payment provider — stripe or razorpay (default fallback when finance does not choose in UI)
PAYMENT_PROVIDER=stripe
STRIPE_PUBLISHABLE_KEY=pk_test_change_me
STRIPE_SECRET_KEY=sk_test_change_me
# Signing secret from Stripe Dashboard → Developers → Webhooks (shown once after create)
# Webhook URL to register in Stripe:
# https://qa-onboarding.worktual.com/api/payments/webhook/stripe
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
# payment_intent.succeeded, payment_intent.payment_failed, charge.refunded
# Local: stripe listen --forward-to localhost:<API_PORT>/api/payments/webhook/stripe
STRIPE_WEBHOOK_SECRET=whsec_change_me

# Razorpay — API keys from Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_change_me
RAZORPAY_KEY_SECRET=change_me
# Webhook signing secret from Dashboard → Account & Settings → Webhooks (shown once after create)
RAZORPAY_WEBHOOK_SECRET=change_me
# Webhook URL to register in Razorpay:
# https://qa-onboarding.worktual.com/api/payments/webhook/razorpay

# Deprecated: SMTP/IMAP are not used for live send (Microsoft Graph only).
# SALES_TEAM_EMAIL / FINANCE_TEAM_EMAIL / SALES_SMTP_* / FINANCE_SMTP_* are unused for outbound From.
