        "store": "sql",
        "sql": "WITH rpt_appointments AS (\nSELECT src.id, src.organization_id, src.contact_id, src.host_user_id, src.host_name, src.source, src.status, src.title, src.starts_at, src.ends_at, src.provider, src.created_at FROM (\nSELECT \n  ap.id,\n  ap.organization_id,\n  ap.contact_id,\n  ap.host_user_id,\n  su.first_name || ' ' || COALESCE(su.last_name, '') AS host_name,\n  ap.source,\n  ap.status,\n  ap.title,\n  ap.starts_at,\n  ap.ends_at,\n  ap.provider,\n  ap.created_at\nFROM crm.appointments ap\nLEFT JOIN accounts.setup_users su ON su.id = ap.host_user_id\nWHERE ap.organization_id = %(_org_id)s\n) src WHERE TRUE\n)\nSELECT title, starts_at, ends_at, status, host_name, provider FROM rpt_appointments AS appointments WHERE starts_at >= %(start)s AND starts_at < %(end)s ORDER BY starts_at ASC LIMIT 500",
