{
  "name": "cc-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "PORT=3000 API_V1_PUBLIC_BASE=/cc-core-api/v1 SOCKET_IO_PATH=/cc-core-api/socket.io INTERNAL_CHAT_NFS_PATH=uploads/internal-chat tsx watch src/index.ts",
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "start": "node dist/index.js",
    "seed:setup-user": "tsx scripts/seed-setup-user.ts",
    "seed:worktual-test-accounts": "tsx scripts/seed-worktual-test-accounts.ts",
    "seed:e2e-support": "tsx scripts/seed-e2e-support-setup.ts",
    "seed:worktual-contacts": "tsx scripts/seed-worktual-contacts.ts",
    "test": "tsx --test src/lib/*.test.ts src/services/*.test.ts",
    "test:email-enterprise": "tsx scripts/test-enterprise-email-integration.ts",
    "test:contact-identity": "tsx scripts/test-contact-identity-integration.ts",
    "repair:duplicate-contacts": "tsx scripts/repair-duplicate-contacts.ts",
    "check:email-routing": "tsx scripts/check-email-routing-state.ts",
    "test:email-routing-availability": "tsx scripts/test-email-routing-availability.ts",
    "test:webchat-memory": "tsx scripts/test-webchat-memory-integration.ts",
    "test:omni-phone-memory": "tsx scripts/test-omni-phone-memory-integration.ts",
    "test:scheduled-reports": "tsx scripts/test-scheduled-reports-integration.ts",
    "backfill:omni-channel-summaries": "tsx scripts/backfill-omni-channel-summaries.ts",
    "backfill:customer-profiles": "tsx scripts/backfill-customer-profiles.ts",
    "cleanup:contacts-keep-single": "tsx scripts/cleanup-contacts-keep-single.ts",
    "seed:agent-tasks": "tsx scripts/seed-agent-tasks.ts",
    "repair:duplicate-callbacks": "tsx scripts/repair-duplicate-callback-tasks.ts",
    "repair:merged-contact-references": "tsx scripts/repair-merged-contact-references.ts",
    "repair:callback-assignment-sources": "tsx scripts/repair-callback-assignment-sources.ts",
    "repair:webchat-only-callbacks": "tsx scripts/repair-webchat-only-callbacks.ts"
  },
  "dependencies": {
    "@ai-contact-center/api-paths": "*",
    "@ai-contact-center/config": "*",
    "@ai-contact-center/db-cc": "*",
    "@ai-contact-center/event-contracts": "*",
    "@ai-contact-center/observability": "*",
    "@ai-contact-center/shared-types": "*",
    "@ai-contact-center/test-harness": "*",
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/sensible": "^6.0.3",
    "@fastify/swagger": "^9.5.0",
    "@fastify/swagger-ui": "^5.2.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/pdfkit": "^0.17.6",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.3.2",
    "ioredis": "^5.11.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "pdfkit": "^0.19.1",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.0",
    "playwright": "^1.62.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
