# Frontend — copy to `apps/web/.env` (never commit `apps/web/.env`)
# Vite loads this file when building or running the web app.

# Local dev — prefixed API paths (matches QA routing)
VITE_CC_CORE_URL=http://localhost:3000/cc-core-api
VITE_PLATFORM_SERVICE_URL=http://localhost:3001/platform-api
VITE_NLP_SERVICE_URL=http://localhost:8000/nlp-api
VITE_API_V1_PREFIX=/v1
VITE_SOCKET_URL=http://localhost:3000
VITE_SOCKET_PATH=/cc-core-api/socket.io
VITE_CALL_SERVICE_URL=http://localhost:3003

# Optional local-dev ONLY when no JWT is stored. Do NOT set in QA/prod builds.
# Must be numeric organizations.id / users.id for your own test org — never a shared default.
# VITE_TENANT_ID=1000
# VITE_USER_ID=1001

# Plain /api/v1 local dev (no prefix) — uncomment and comment block above
# VITE_CC_CORE_URL=http://localhost:3000
# VITE_PLATFORM_SERVICE_URL=http://localhost:3001
# VITE_NLP_SERVICE_URL=http://localhost:8000
# VITE_SOCKET_URL=http://localhost:3000
# VITE_SOCKET_PATH=/socket.io

# QA server build (set in root `.env` for Docker web build — see docs/deploy/devops-routing-spec.md)
# VITE_CC_CORE_URL=https://rebuild-ccaas-api.worktual.com/cc-core-api
# VITE_PLATFORM_SERVICE_URL=https://rebuild-ccaas-api.worktual.com/platform-api
# VITE_NLP_SERVICE_URL=https://rebuild-ccaas-api.worktual.com/nlp-api
# VITE_CALL_SERVICE_URL=https://rebuild-ccaas-api.worktual.com/call-api
# VITE_API_V1_PREFIX=/v1
# VITE_SOCKET_URL=https://rebuild-ccaas-api.worktual.com
# VITE_SOCKET_PATH=/cc-core-api/socket.io
