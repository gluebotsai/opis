generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["platform"]
}

model auth_sessions {
  token        String   @id @db.VarChar(128)
  email        String   @db.VarChar(255)
  role         String   @db.VarChar(32)
  display_name String?  @db.VarChar(255)
  expires_at   DateTime @db.Timestamptz(6)
  user_id      BigInt?
  users        users?   @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([expires_at], map: "idx_auth_sessions_expires_at")
  @@schema("platform")
}

model commission_slabs {
  min_amount   Decimal  @default(0) @db.Decimal(14, 2)
  max_amount   Decimal? @db.Decimal(14, 2)
  rate_percent Decimal  @db.Decimal(8, 4)
  currency     String   @default("INR") @db.VarChar(8)
  sort_order   Int      @default(0)
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)
  country      String   @default("India") @db.VarChar(128)
  id           BigInt   @id @default(autoincrement())

  @@index([is_active, sort_order], map: "idx_commission_slabs_active")
  @@index([country, is_active, sort_order], map: "idx_commission_slabs_country")
  @@schema("platform")
}

model email_outbox {
  job_type    String    @db.VarChar(64)
  to_email    String?   @db.VarChar(255)
  subject     String?   @db.VarChar(512)
  payload     Json      @default("{}")
  status      String    @default("pending") @db.VarChar(32)
  retry_count Int       @default(0)
  last_error  String?
  sent_at     DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @db.Timestamptz(6)
  id          BigInt    @id @default(autoincrement())

  @@index([created_at(sort: Desc)], map: "idx_email_outbox_created_at")
  @@index([status], map: "idx_email_outbox_status")
  @@schema("platform")
}

model export_audit_logs {
  exported_by_email   String   @db.VarChar(255)
  exported_by_role    String   @db.VarChar(32)
  agent_email         String?  @db.VarChar(255)
  agent_name          String?  @db.VarChar(255)
  format              String   @db.VarChar(32)
  scope               String   @db.VarChar(32)
  row_count           Int      @default(0)
  file_name           String?  @db.VarChar(255)
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  agent_user_id       BigInt?
  exported_by_user_id BigInt?
  id                  BigInt   @id @default(autoincrement())
  users               users?   @relation(fields: [exported_by_user_id], references: [id], onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "idx_export_audit_logs_created_at")
  @@schema("platform")
}

model graph_mail_subscriptions {
  subscription_id String   @id @db.VarChar(128)
  mailbox_profile String   @db.VarChar(16)
  resource        String
  client_state    String?  @db.VarChar(128)
  expires_at      DateTime @db.Timestamptz(6)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  @@index([expires_at], map: "idx_graph_mail_subscriptions_expires_at")
  @@schema("platform")
}

model mail_oauth_connections {
  account_type            String   @default("internal") @db.VarChar(16)
  mailbox_profile         String   @db.VarChar(16)
  account_email           String   @db.VarChar(255)
  account_name            String?  @db.VarChar(255)
  ms_tenant_id            String?  @db.VarChar(64)
  access_token_encrypted  String
  refresh_token_encrypted String
  expires_at              DateTime @db.Timestamptz(6)
  scope                   String?
  created_at              DateTime @default(now()) @db.Timestamptz(6)
  updated_at              DateTime @default(now()) @db.Timestamptz(6)
  needs_reauth            Boolean  @default(false)
  account_id              BigInt
  id                      BigInt   @id @default(autoincrement())

  @@unique([account_type, account_id, mailbox_profile], map: "mail_oauth_connections_account_profile_key")
  @@index([account_email], map: "idx_mail_oauth_connections_email")
  @@index([mailbox_profile], map: "idx_mail_oauth_connections_profile")
  @@schema("platform")
}

model mail_oauth_states {
  state           String   @id @db.VarChar(128)
  account_type    String   @default("internal") @db.VarChar(16)
  mailbox_profile String   @db.VarChar(16)
  return_path     String   @default("/mail") @db.VarChar(512)
  expires_at      DateTime @db.Timestamptz(6)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  account_id      BigInt

  @@index([expires_at], map: "idx_mail_oauth_states_expires_at")
  @@schema("platform")
}

model mail_signatures {
  account_type    String   @default("internal") @db.VarChar(16)
  mailbox_profile String   @db.VarChar(16)
  html_body       String   @default("")
  updated_at      DateTime @default(now()) @db.Timestamptz(6)
  account_id      BigInt   @default(autoincrement())

  @@id([account_type, account_id, mailbox_profile])
  @@schema("platform")
}

model partner_auth_sessions {
  token           String        @id @db.VarChar(128)
  email           String        @db.VarChar(255)
  expires_at      DateTime      @db.Timestamptz(6)
  partner_id      BigInt
  partner_user_id BigInt
  partners        partners      @relation(fields: [partner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  partner_users   partner_users @relation(fields: [partner_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expires_at], map: "idx_partner_auth_sessions_expires_at")
  @@schema("platform")
}

model partner_bank_accounts {
  account_holder_name String   @db.VarChar(255)
  bank_name           String   @db.VarChar(255)
  account_number      String   @db.VarChar(64)
  ifsc_or_routing     String   @db.VarChar(64)
  branch_name         String?  @db.VarChar(255)
  is_primary          Boolean  @default(true)
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @default(now()) @db.Timestamptz(6)
  id                  BigInt   @id @default(autoincrement())
  partner_id          BigInt   @unique
  partners            partners @relation(fields: [partner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("platform")
}

model partner_users {
  email                 String                  @unique @db.VarChar(255)
  password_hash         String
  display_name          String?                 @db.VarChar(255)
  is_active             Boolean                 @default(true)
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                @default(now()) @db.Timestamptz(6)
  id                    BigInt                  @id @default(autoincrement())
  partner_id            BigInt
  partner_auth_sessions partner_auth_sessions[]
  partners              partners                @relation(fields: [partner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("platform")
}

model partners {
  company_name          String                  @db.VarChar(255)
  contact_name          String?                 @db.VarChar(255)
  designation           String?                 @db.VarChar(128)
  work_email            String                  @db.VarChar(255)
  country               String?                 @db.VarChar(128)
  website_url           String?                 @db.VarChar(512)
  mobile_country_code   String?                 @default("+91") @db.VarChar(8)
  mobile_number         String?                 @db.VarChar(32)
  is_active             Boolean                 @default(true)
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                @default(now()) @db.Timestamptz(6)
  created_by            BigInt?
  id                    BigInt                  @id @default(autoincrement())
  partner_auth_sessions partner_auth_sessions[]
  partner_bank_accounts partner_bank_accounts?
  partner_users         partner_users[]
  users                 users?                  @relation(fields: [created_by], references: [id], onUpdate: NoAction)

  @@index([is_active], map: "idx_partners_is_active")
  @@schema("platform")
}

model password_reset_otps {
  email                  String    @db.VarChar(255)
  account_type           String    @db.VarChar(32)
  account_id             String    @db.VarChar(64)
  otp_hash               String
  reset_token_hash       String?
  expires_at             DateTime  @db.Timestamptz(6)
  reset_token_expires_at DateTime? @db.Timestamptz(6)
  attempts               Int       @default(0)
  consumed_at            DateTime? @db.Timestamptz(6)
  created_at             DateTime  @default(now()) @db.Timestamptz(6)
  id                     BigInt    @id @default(autoincrement())

  @@index([email], map: "idx_password_reset_otps_email")
  @@index([expires_at], map: "idx_password_reset_otps_expires_at")
  @@schema("platform")
}

model pricing_catalogs {
  version        Int       @id
  updated_at     DateTime? @db.Timestamptz(6)
  updated_by     String?   @db.VarChar(255)
  regions        Json?
  shared         Json?
  products       Json?
  region_pricing Json?

  @@schema("platform")
}

model products {
  id          String   @id @db.VarChar(64)
  schema_name String   @unique @db.VarChar(64)
  label       String   @db.VarChar(255)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@schema("platform")
}

model reseller_auth_sessions {
  token            String         @id @db.VarChar(128)
  email            String         @db.VarChar(255)
  expires_at       DateTime       @db.Timestamptz(6)
  reseller_id      BigInt
  reseller_user_id BigInt
  resellers        resellers      @relation(fields: [reseller_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reseller_users   reseller_users @relation(fields: [reseller_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expires_at], map: "idx_reseller_auth_sessions_expires_at")
  @@schema("platform")
}

model reseller_users {
  email                  String                   @unique @db.VarChar(255)
  password_hash          String
  display_name           String?                  @db.VarChar(255)
  is_active              Boolean                  @default(true)
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)
  id                     BigInt                   @id @default(autoincrement())
  reseller_id            BigInt
  reseller_auth_sessions reseller_auth_sessions[]
  resellers              resellers                @relation(fields: [reseller_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("platform")
}

model resellers {
  company_name           String                   @db.VarChar(255)
  contact_name           String?                  @db.VarChar(255)
  designation            String?                  @db.VarChar(128)
  work_email             String                   @db.VarChar(255)
  invoice_email          String                   @db.VarChar(255)
  invoice_cc_emails      Json                     @default("[]")
  tax_number             String?                  @db.VarChar(64)
  billing_address        String?
  country                String?                  @db.VarChar(128)
  website_url            String?                  @db.VarChar(512)
  mobile_country_code    String?                  @default("+91") @db.VarChar(8)
  mobile_number          String?                  @db.VarChar(32)
  is_active              Boolean                  @default(true)
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)
  created_by             BigInt?
  id                     BigInt                   @id @default(autoincrement())
  reseller_auth_sessions reseller_auth_sessions[]
  reseller_users         reseller_users[]
  users                  users?                   @relation(fields: [created_by], references: [id], onUpdate: NoAction)

  @@index([is_active], map: "idx_resellers_is_active")
  @@schema("platform")
}

model schema_migrations {
  migration_key String   @id @db.VarChar(255)
  applied_at    DateTime @default(now()) @db.Timestamptz(6)

  @@schema("platform")
}

model users {
  email               String              @unique @db.VarChar(255)
  password            String              @db.VarChar(255)
  role                String              @db.VarChar(32)
  display_name        String?             @db.VarChar(255)
  phone               String?             @db.VarChar(64)
  country             String?             @db.VarChar(128)
  mobile_country_code String?             @db.VarChar(8)
  mobile_number       String?             @db.VarChar(32)
  department          String?             @db.VarChar(128)
  is_active           Boolean             @default(true)
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  created_by          String?             @db.VarChar(255)
  updated_at          DateTime            @default(now()) @db.Timestamptz(6)
  updated_by          String?             @db.VarChar(255)
  id                  BigInt              @id @default(autoincrement())
  auth_sessions       auth_sessions[]
  export_audit_logs   export_audit_logs[]
  partners            partners[]
  resellers           resellers[]

  @@schema("platform")
}
