CYPHER=["MATCH (d:Deal) OPTIONAL MATCH (c:Contact {id: d.contact_id}) OPTIONAL MATCH (ca:ContactActivity) WHERE ca.contact_id = c.cdp_id OR ca.contact_id = c.id OPTIONAL MATCH (sp:SalesProfile {account_contact_id: c.cdp_id}) RETURN d.title AS lost_deal_title, d.lost_reason AS lost_reason, d.amount AS amount, d.closed_at AS closed_at, coalesce(c.first_name + ' ' + c.last_name, 'Unknown Contact') AS contact_name, c.email AS contact_email, max(ca.completed_at) AS last_activity_date, sp.bant_authority AS bant_authority, sp.bant_budget AS bant_budget, sp.bant_need AS bant_need, sp.bant_timeline AS bant_timeline ORDER BY d.closed_at DESC\nLIMIT 100"]
