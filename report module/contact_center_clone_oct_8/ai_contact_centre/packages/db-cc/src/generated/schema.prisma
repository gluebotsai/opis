generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["accounts", "ccass"]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model active_products {
  key                      String         @id @db.VarChar(160)
  product_id               String         @db.VarChar(64)
  branch_id                String         @db.VarChar(128)
  billing_branch_id        String         @db.VarChar(128)
  change_type              String?        @db.VarChar(32)
  config                   Json?
  implementation_purchased Boolean        @default(false)
  price_label              String?        @db.VarChar(128)
  approved_at              DateTime?      @db.Timestamptz(6)
  payment_confirmed_at     DateTime?      @db.Timestamptz(6)
  lead_id                  BigInt
  organization_id          BigInt?
  quotation_id             BigInt?
  leads                    leads          @relation(fields: [lead_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organizations            organizations? @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  quotations               quotations?    @relation(fields: [quotation_id], references: [id], onUpdate: NoAction)

  @@index([organization_id], map: "idx_active_products_organization_id")
  @@schema("accounts")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model additional_addresses {
  label                         String?        @db.VarChar(128)
  address                       String?
  country                       String?        @db.VarChar(128)
  state                         String?        @db.VarChar(128)
  tax_number                    String?        @db.VarChar(64)
  industry_type                 String?        @db.VarChar(128)
  business_type                 String?        @db.VarChar(32)
  company_size                  String?        @db.VarChar(64)
  website_url                   String?        @db.VarChar(512)
  contact_name                  String?        @db.VarChar(255)
  designation                   String?        @db.VarChar(128)
  work_email                    String?        @db.VarChar(255)
  mobile_country_code           String?        @db.VarChar(8)
  mobile_number                 String?        @db.VarChar(32)
  secondary_mobile_country_code String?        @db.VarChar(8)
  secondary_mobile_number       String?        @db.VarChar(32)
  id                            BigInt         @id @default(autoincrement())
  lead_id                       BigInt
  organization_id               BigInt?
  leads                         leads          @relation(fields: [lead_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organizations                 organizations? @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("accounts")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model agent_did_usage_monthly {
  tenant_id         String           @db.VarChar(128)
  number            String           @db.VarChar(64)
  year_month        String           @db.Char(7)
  usage_value       Decimal          @default(0) @db.Decimal(14, 2)
  usage_unit        String           @default("units") @db.VarChar(32)
  notes             String           @default("")
  entered_by        String?          @db.VarChar(255)
  created_at        DateTime         @default(now()) @db.Timestamptz(6)
  updated_at        DateTime         @default(now()) @db.Timestamptz(6)
  id                BigInt           @id @default(autoincrement())
  number_mapping_id BigInt?
  organization_id   BigInt?
  number_mappings   number_mappings? @relation(fields: [number_mapping_id], references: [id], onUpdate: NoAction)
  organizations     organizations?   @relation(fields: [organization_id], references: [id], onUpdate: NoAction)

  @@unique([tenant_id, year_month, number])
  @@index([tenant_id, year_month], map: "idx_agent_did_usage_tenant_ym")
  @@schema("accounts")
}

model auth_sessions {
  token                   String    @id @db.VarChar(128)
  email                   String    @db.VarChar(255)
  role                    String    @db.VarChar(32)
  display_name            String?   @db.VarChar(255)
  expires_at              DateTime  @db.Timestamptz(6)
  user_id                 BigInt?
  presence_initialized_at DateTime? @db.Timestamptz(6)
  /// Product this login belongs to. Null means an older row or another app that has not set it yet.
  product_id              String?   @db.VarChar(128)
  users                   users?    @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([expires_at], map: "idx_auth_sessions_expires_at")
  @@index([email, product_id], map: "idx_auth_sessions_email_product")
  @@schema("accounts")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model available_numbers {
  number     String   @db.VarChar(64)
  notes      String   @default("")
  created_by String?  @db.VarChar(255)
  updated_by String?  @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  id         BigInt   @id @default(autoincrement())

  @@schema("accounts")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model branch_add_requests {
  request_number                String          @unique @db.VarChar(64)
  payload                       Json            @default("{}")
  status                        String          @default("submitted") @db.VarChar(32)
  company_name                  String          @default("") @db.VarChar(255)
  contact_email                 String          @default("") @db.VarChar(255)
  created_at                    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at                    DateTime        @default(now()) @db.Timestamptz(6)
  id                            BigInt          @id @default(autoincrement())
  organization_id               BigInt
  requested_by_customer_user_id BigInt?
  source_lead_id                BigInt?
  organizations                 organizations   @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  customer_users                customer_users? @relation(fields: [requested_by_customer_user_id], references: [id], onUpdate: NoAction)
  leads                         leads?          @relation(fields: [source_lead_id], references: [id], onUpdate: NoAction)

  @@index([status, created_at(sort: Desc)], map: "idx_branch_add_requests_status")
  @@schema("accounts")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model branch_cancellation_alerts {
  alert_type                   String                        @db.VarChar(32)
  branch_id                    String                        @db.VarChar(128)
  product_id                   String?                       @db.VarChar(64)
  grace_deadline_at            DateTime                      @db.Timestamptz(6)
  alerted_at                   DateTime                      @default(now()) @db.Timestamptz(6)
  id                           BigInt                        @id @default(autoincrement())
  organization_id              BigInt
  quotation_id                 BigInt?
  request_id                   BigInt?
  subscription_id              BigInt?
  organizations                organizations                 @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  quotations                   quotations?                   @relation(fields: [quotation_id], references: [id], onUpdate: NoAction)
  branch_cancellation_requests branch_cancellation_requests? @relation(fields: [request_id], references: [id], onUpdate: NoAction)
  subscriptions                subscriptions?                @relation(fields: [subscription_id], references: [id], onUpdate: NoAction)

  @@schema("accounts")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model branch_cancellation_requests {
  request_number             String                       @unique @db.VarChar(32)
  request_kind               String                       @db.VarChar(32)
  branch_id                  String                       @db.VarChar(128)
  product_id                 String?                      @db.VarChar(64)
  status                     String                       @default("submitted") @db.VarChar(32)
  trigger_source             String                       @default("customer") @db.VarChar(32)
  grace_deadline_at          DateTime?                    @db.Timestamptz(6)
  customer_note              String?
  admin_note                 String?
  tenant_id                  String?                      @db.VarChar(16)
  company_name               String?                      @db.VarChar(255)
  contact_email              String?                      @db.VarChar(255)
  effective_timing           String                       @default("end_of_period") @db.VarChar(32)
  effective_at               DateTime?                    @db.Timestamptz(6)
  resolved_at                DateTime?                    @db.Timestamptz(6)
  resolved_by                String?                      @db.VarChar(255)
  created_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  customer_user_id           BigInt?
  id                         BigInt                       @id @default(autoincrement())
  organization_id            BigInt
  related_quotation_id       BigInt?
  source_lead_id             BigInt
  subscription_id            BigInt?
  branch_cancellation_alerts branch_cancellation_alerts[]
  customer_users             customer_users?              @relation(fields: [customer_user_id], references: [id], onUpdate: NoAction)
  organizations              organizations                @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  quotations                 quotations?                  @relation(fields: [related_quotation_id], references: [id], onUpdate: NoAction)
  leads                      leads                        @relation(fields: [source_lead_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subscriptions              subscriptions?               @relation(fields: [subscription_id], references: [id], onUpdate: NoAction)

  @@index([status, created_at(sort: Desc)], map: "idx_branch_cancellation_requests_status")
  @@schema("accounts")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model branches {
  id              String         @db.VarChar(128)
  label           String?        @db.VarChar(128)
  address         String?
  country         String?        @db.VarChar(128)
  state           String?        @db.VarChar(128)
  tax_number      String?        @db.VarChar(64)
  is_primary      Boolean        @default(false)
  lead_id         BigInt         @default(autoincrement())
  organization_id BigInt?
  leads           leads          @relation(fields: [lead_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organizations   organizations? @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([lead_id, id])
  @@schema("accounts")
}

model commission_slabs {
  country                    String                       @default("India") @db.VarChar(128)
  min_amount                 Decimal                      @default(0) @db.Decimal(14, 2)
  max_amount                 Decimal?                     @db.Decimal(14, 2)
  rate_percent               Decimal                      @db.Decimal(8, 4)
  currency                   String                       @default("INR") @db.VarChar(8)
  sort_order                 Int                          @default(0)
  is_active                  Boolean                      @default(true)
  created_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  id                         BigInt                       @id @default(autoincrement())
  partner_commission_entries partner_commission_entries[]

  @@index([is_active, sort_order], map: "idx_commission_slabs_active")
  @@index([country, is_active, sort_order], map: "idx_commission_slabs_country")
  @@schema("accounts")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model customer_auth_sessions {
  token            String         @id @db.VarChar(128)
  email            String         @db.VarChar(255)
  expires_at       DateTime       @db.Timestamptz(6)
  customer_user_id BigInt
  organization_id  BigInt
  customer_users   customer_users @relation(fields: [customer_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organizations    organizations  @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expires_at], map: "idx_customer_auth_sessions_expires_at")
  @@schema("accounts")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
