  id                  BigInt   @id @default(autoincrement())
  organization_id     BigInt
  forecast_date       DateTime @db.Date
  history_days        Int      @default(56)
  horizon_hours       Int      @default(168)
  method              String   @default("seasonal_baseline_plus_llm_adjustment") @db.VarChar(64)
  status              String   @default("completed") @db.VarChar(32)
  input_hash          String   @db.VarChar(128)
  baseline_json       Json     @default("{}")
  llm_adjustment_json Json?
  forecast_json       Json     @default("{}")
  summary_json        Json     @default("{}")
  schema_version      Int      @default(1)
  prompt_version      String?  @db.VarChar(64)
  model_name          String?  @db.VarChar(128)
  validation_status   String   @default("valid") @db.VarChar(32)
  generated_at        DateTime @default(now()) @db.Timestamptz(6)
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @default(now()) @db.Timestamptz(6)

  @@unique([organization_id, forecast_date, input_hash], map: "idx_dashboard_analytics_forecast_runs_org_date_hash")
  @@index([organization_id, forecast_date(sort: Desc), generated_at(sort: Desc)], map: "idx_dashboard_analytics_forecast_runs_org_date")
  @@schema("ccass")
}

model dashboard_analytics_workforce_plans {
  id                  BigInt    @id @default(autoincrement())
  organization_id     BigInt
  forecast_run_id     BigInt?
  plan_date           DateTime  @db.Date
  input_signature     String    @db.VarChar(128)
  plan_fingerprint    String    @db.VarChar(128)
  decision            String    @default("update") @db.VarChar(32)
  status              String    @default("draft") @db.VarChar(32)
  previous_plan_id    BigInt?
  plan_json           Json      @default("{}")
  source              String    @default("rules") @db.VarChar(32)
  schema_version      Int       @default(1)
  prompt_version      String?   @db.VarChar(64)
  model_name          String?   @db.VarChar(128)
  reviewed_by_user_id BigInt?
  reviewed_at         DateTime? @db.Timestamptz(6)
  applied_at          DateTime? @db.Timestamptz(6)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([organization_id, plan_date, input_signature], map: "idx_dashboard_analytics_workforce_plans_org_date_sig")
  @@index([organization_id, plan_date(sort: Desc), created_at(sort: Desc)], map: "idx_dashboard_analytics_workforce_plans_org_date")
  @@schema("ccass")
}
