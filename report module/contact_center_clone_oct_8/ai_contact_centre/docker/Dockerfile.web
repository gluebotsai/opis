FROM node:22-bookworm-slim AS builder
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json* ./
COPY apps ./apps
COPY packages ./packages
COPY turbo.json ./
RUN npm ci

ARG VITE_CC_CORE_URL=http://localhost:3000
ARG VITE_PLATFORM_SERVICE_URL=http://localhost:3001
ARG VITE_NLP_SERVICE_URL=http://localhost:8000
ARG VITE_SOCKET_URL=http://localhost:3000
ARG VITE_CALL_SERVICE_URL=http://localhost:3003
ARG VITE_API_V1_PREFIX=/api/v1
ARG VITE_SOCKET_PATH=/socket.io
ENV VITE_CC_CORE_URL=$VITE_CC_CORE_URL \
    VITE_PLATFORM_SERVICE_URL=$VITE_PLATFORM_SERVICE_URL \
    VITE_NLP_SERVICE_URL=$VITE_NLP_SERVICE_URL \
    VITE_SOCKET_URL=$VITE_SOCKET_URL \
    VITE_CALL_SERVICE_URL=$VITE_CALL_SERVICE_URL \
    VITE_API_V1_PREFIX=$VITE_API_V1_PREFIX \
    VITE_SOCKET_PATH=$VITE_SOCKET_PATH
RUN npm run build -w web

FROM nginx:alpine AS runner
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html
RUN printf '%s\n' \
    'server {' \
    '    listen 80;' \
    '    root /usr/share/nginx/html;' \
    '    index index.html;' \
    '    location / {' \
    '        try_files $uri $uri/ /index.html;' \
    '    }' \
    '}' \
    > /etc/nginx/conf.d/default.conf
EXPOSE 80
