FROM node:22-alpine AS base
WORKDIR /app
RUN apk add --no-cache libc6-compat openssl

FROM base AS deps
COPY package.json package-lock.json* ./
COPY apps ./apps
COPY packages ./packages
COPY turbo.json ./
RUN npm ci

FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npx prisma generate --schema packages/db-cc/prisma/schema.prisma \
    && npx prisma generate --schema packages/db-platform/prisma/schema.prisma
ARG SERVICE_PATH
WORKDIR /app
RUN npx turbo build --filter=./${SERVICE_PATH}

FROM node:22-alpine AS runner
WORKDIR /app
RUN apk add --no-cache libc6-compat openssl
ENV NODE_ENV=production
ARG SERVICE_PATH
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/${SERVICE_PATH}/dist ./dist
COPY --from=builder /app/${SERVICE_PATH}/package.json ./package.json
# Workspace packages export TypeScript sources; tsx resolves them at runtime.
CMD ["./node_modules/.bin/tsx", "dist/index.js"]
