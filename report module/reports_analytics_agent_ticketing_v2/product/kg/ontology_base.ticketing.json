    "domain": "ticketing",
    "extra_labels": [
      {
        "label": "BreachedCase",
        "when_status": "Overdue"
      },
      {
        "label": "ResolvedCase",
        "when_status": "Resolved"
      }
    ],
    "status_rules": {
      "open": "t.status = 'Open'",
      "generic_pending": "t.status NOT IN ['Closed', 'Resolved']",
      "literal_pending": "t.status = 'Pending'",
      "reopened": "t.status = 'Reopened'",
      "overdue": "t.status = 'Overdue'",
