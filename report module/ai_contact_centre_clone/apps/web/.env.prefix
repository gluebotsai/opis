# Local prefix-path E2E — copy to apps/web/.env or use scripts/e2e/run-prefix-path-e2e.sh
# VITE_TENANT_ID is an explicit E2E fixture for this script only — not a product default.
VITE_CC_CORE_URL=http://localhost:3000/cc-core-api
VITE_PLATFORM_SERVICE_URL=http://localhost:3001/platform-api
VITE_NLP_SERVICE_URL=http://localhost:8000/nlp-api
VITE_API_V1_PREFIX=/v1
VITE_SOCKET_URL=http://localhost:3000
VITE_SOCKET_PATH=/cc-core-api/socket.io
VITE_TENANT_ID=1000
VITE_USER_ID=1001
