{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check-types": "tsc --noEmit",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:webchat-visual": "playwright test e2e/webchat-to-agent.spec.ts --headed",
    "test:e2e:webchat-bot-lifecycle": "PLAYWRIGHT_OFFER_TIMEOUT_SECONDS=20 playwright test e2e/webchat-bot-lifecycle.spec.ts",
    "test:e2e:webchat-single-agent": "PLAYWRIGHT_SKIP_WEBSERVER=1 playwright test e2e/webchat-single-agent.spec.ts",
    "test:e2e:webchat-two-agent": "PLAYWRIGHT_SKIP_WEBSERVER=1 playwright test e2e/webchat-two-agent.spec.ts",
    "test:e2e:report": "playwright show-report",
    "generate:presence-nudge-audio": "node scripts/generate-presence-nudge-audio.mjs",
    "capture:ui-references": "node ../../.cursor/skills/worktual-ui-system/scripts/capture-admin-references.mjs",
    "sync:ui-icons": "node ../../.cursor/skills/worktual-ui-system/scripts/sync-icon-references.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
