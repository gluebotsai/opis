{
  "name": "@ai-contact-center/db-cc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "prisma generate",
    "check-types": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "tsx src/migrate.ts",
    "db:migrate:status": "tsx src/migrate.ts --status",
    "db:seed": "tsx src/migrate.ts --seed"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0"
  },
  "devDependencies": {
    "@ai-contact-center/config": "*",
    "prisma": "^6.6.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3"
  }
}
