# ==============================================================================
# Knowledge Graph Agent Environment Configuration Example
# ==============================================================================

# Default Tenant Configuration
ORGANIZATION_ID="1012"
USER_ID="1001"
DEFAULT_ROLE="employee"
KG_ALLOWED_ORGS="1000,1012"

# LLM Endpoint (OpenAI-compatible / vLLM serving Gemma)
LLM_BASE_URL="http://localhost:8000/v1"
LLM_MODEL_NAME="worktual-gemma"
LLM_API_KEY="dummy-key"

# Neo4j Graph Database (Bolt port 7687)
NEO4J_URI="neo4j://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="your-secure-password"
NEO4J_DATABASE_PREFIX="org"
NEO4J_READ_TIMEOUT_SECONDS=30.0
NEO4J_MAX_ROWS=50

# Meilisearch Semantic Search Engine
MEILISEARCH_URL="http://127.0.0.1:7700"
MEILISEARCH_API_KEY="your-meilisearch-api-key"

# Structured Audit Logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_PATH="logs/audit.jsonl"
AUDIT_LOG_SINK="file"
