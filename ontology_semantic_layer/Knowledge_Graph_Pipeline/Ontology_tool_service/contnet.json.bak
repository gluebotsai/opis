  {
    "id": "concept_customer",
    "type": "business_concept",
    "name": "Customer",
    "description": "A contact who has purchased any offering of the business [tenant]"
  },
  {
    "id": "concept_first_contact_resolution",
    "type": "business_concept",
    "name": "First Contact Resolution (FCR)",
    "description": "Metric measuring interactions resolved on first interaction without escalation"
  },
  {
    "id": "concept_average_handle_time",
    "type": "business_concept",
    "name": "Average Handle Time (AHT)",
    "description": "Average duration to handle an interaction including talk time and after-call work"
  },
  {
    "id": "concept_service_level",
    "type": "business_concept",
    "name": "Service Level",
    "description": "Percentage of interactions answered within defined threshold (e.g., 80% in 20 seconds)"
  },
  {
    "id": "concept_occupancy",
    "type": "business_concept",
    "name": "Occupancy",
    "description": "Percentage of time agents spend handling interactions vs available time"
  },
  {
    "id": "concept_abandonment_rate",
    "type": "business_concept",
    "name": "Abandonment Rate",
    "description": "Percentage of callers who disconnect before speaking to an agent"
  },
  {
    "id": "concept_wrap_up_time",
    "type": "business_concept",
    "name": "Wrap-up Time",
    "description": "Time after call ends for agents to complete documentation and notes"
  },
  {
    "id": "concept_shrinkage",
    "type": "business_concept",
    "name": "Shrinkage",
    "description": "Percentage of scheduled time unavailable for calls due to breaks, training, etc."
  }
]